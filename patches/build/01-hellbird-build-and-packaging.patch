+<?xml version="1.0" encoding="UTF-8"?>
+<component type="desktop-application">
+  <id>org.hellbird.Hellbird</id>
+
+  <name>Hellbird</name>
+  <summary>Privacy-first minimalist web browser powered by Ladybird</summary>
+
+  <developer id="org.hellbird">
+    <name>Hellbird Project</name>
+  </developer>
+
+  <url type="homepage">https://github.com/buczkow-ski/Hellbird</url>
+  <url type="bugtracker">https://github.com/buczkow-ski/Hellbird/issues</url>
+  <url type="vcs-browser">https://github.com/buczkow-ski/Hellbird</url>
+
+  <metadata_license>0BSD</metadata_license>
+  <project_license>BSD-2-Clause</project_license>
+  <content_rating type="oars-1.1" />
+
+  <description>
+    <p>
+      Hellbird combines a privacy-first minimalist interface, native !bangs, and ergonomic controls
+      with the independent Ladybird web engine.
+    </p>
+  </description>
+
+  <provides>
+    <mediatype>text/html</mediatype>
+    <mediatype>text/xml</mediatype>
+    <mediatype>application/xhtml+xml</mediatype>
+    <mediatype>x-scheme-handler/http</mediatype>
+    <mediatype>x-scheme-handler/https</mediatype>
+  </provides>
+
+  <launchable type="desktop-id">org.hellbird.Hellbird.desktop</launchable>
+  <releases>
+    <release version="@METAINFO_RELEASE_VERSION@" type="@METAINFO_RELEASE_TYPE@" date="@DATE@">
+      <description>
+        <p>
+          @METAINFO_RELEASE_DESCRIPTION@
+        </p>
+      </description>
+    </release>
+  </releases>
+
+  <branding>
+    <color type="primary" scheme_preference="light">#e84a27</color>
+    <color type="primary" scheme_preference="dark">#ff7a45</color>
+  </branding>
+</component>
