+bool input_contains_bang_prefix(StringView input)
+{
+    input = input.trim_whitespace();
+    if (input.is_empty())
+        return false;
+    if (input.starts_with('!'))
+        return true;
+
+    auto last_separator = input.find_any_of(ASCII_WHITESPACE, StringView::SearchDirection::Backward);
+    if (!last_separator.has_value())
+        return false;
+    return input.substring_view(*last_separator + 1).starts_with('!');
+}
