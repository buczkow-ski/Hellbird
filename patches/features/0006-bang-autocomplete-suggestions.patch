+static bool contains_ignoring_ascii_case(StringView haystack, StringView needle)
+{
+    if (needle.is_empty() || needle.length() > haystack.length())
+        return false;
+    for (size_t offset = 0; offset + needle.length() <= haystack.length(); ++offset) {
+        if (haystack.substring_view(offset, needle.length()).equals_ignoring_ascii_case(needle))
+            return true;
+    }
+    return false;
+}
+
+Vector<Bang const*> suggest_bangs(StringView input, size_t max_results)
+{
+    if (max_results == 0)
+        return {};
+
+    // Trim only leading whitespace: a trailing space (e.g. "!gh ") means the user already selected
+    // the bang and is typing a query, rather than browsing available bang commands.
+    auto leading_trimmed = input.trim_whitespace(TrimMode::Left);
+    if (!leading_trimmed.starts_with('!') || leading_trimmed.find_any_of(ASCII_WHITESPACE).has_value())
+        return {};
+
+    auto prefix = leading_trimmed.substring_view(1);
+    Vector<Bang const*> results;
+    results.ensure_capacity(min(max_results, s_builtin_bangs.size()));
+
+    if (prefix.is_empty()) {
+        static constexpr auto s_featured_triggers = to_array<StringView>({
+            "g"sv,
+            "ddg"sv,
+            "yt"sv,
+            "w"sv,
+            "gh"sv,
+            "r"sv,
+            "maps"sv,
+            "tr"sv,
+            "so"sv,
+            "mdn"sv,
+            "deepl"sv,
+            "a"sv,
+        });
+        for (auto trigger : s_featured_triggers) {
+            if (results.size() >= max_results)
+                break;
+            for (auto const& bang : s_builtin_bangs) {
+                if (bang.trigger == trigger) {
+                    results.unchecked_append(&bang);
+                    break;
+                }
+            }
+        }
+        return results;
+    }
+
+    struct Candidate {
+        Bang const* bang { nullptr };
+        u8 tier { 0 };
+        size_t index { 0 };
+    };
+
+    Vector<Candidate> candidates;
+    for (size_t index = 0; index < s_builtin_bangs.size(); ++index) {
+        auto const& bang = s_builtin_bangs[index];
+        Optional<u8> tier;
+        if (bang.trigger.equals_ignoring_ascii_case(prefix))
+            tier = 0;
+        else if (bang.trigger.starts_with(prefix, CaseSensitivity::CaseInsensitive))
+            tier = 1;
+        else if (bang.name.starts_with(prefix, CaseSensitivity::CaseInsensitive))
+            tier = 2;
+        else if (contains_ignoring_ascii_case(bang.name, prefix))
+            tier = 3;
+
+        if (!tier.has_value())
+            continue;
+
+        // Keep one entry per site (e.g. !g vs !google), preferring the stronger match tier and then shorter trigger.
+        Optional<size_t> existing_index;
+        for (size_t i = 0; i < candidates.size(); ++i) {
+            if (candidates[i].bang->name == bang.name) {
+                existing_index = i;
+                break;
+            }
+        }
+        if (existing_index.has_value()) {
+            auto& existing = candidates[*existing_index];
+            if (*tier < existing.tier
+                || (*tier == existing.tier && bang.trigger.length() < existing.bang->trigger.length())) {
+                existing = { &bang, *tier, index };
+            }
+            continue;
+        }
+
+        candidates.append({ &bang, *tier, index });
+    }
+
+    quick_sort(candidates, [](Candidate const& left, Candidate const& right) {
+        if (left.tier != right.tier)
+            return left.tier < right.tier;
+        if (left.bang->trigger.length() != right.bang->trigger.length())
+            return left.bang->trigger.length() < right.bang->trigger.length();
+        return left.index < right.index;
+    });
+
+    for (auto const& candidate : candidates) {
+        if (results.size() >= max_results)
+            break;
+        results.unchecked_append(candidate.bang);
+    }
+    return results;
+}
