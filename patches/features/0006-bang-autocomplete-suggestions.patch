+Vector<AutocompleteSuggestion> bang_autocomplete_suggestions(StringView input, size_t max_results, Optional<StringView> skip_trigger)
+{
+    if (max_results == 0)
+        return {};
+
+    auto suggested_bangs = suggest_bangs(input, skip_trigger.has_value() ? max_results + 1 : max_results);
+    if (suggested_bangs.is_empty())
+        return {};
+
+    Vector<AutocompleteSuggestion> suggestions;
+    suggestions.ensure_capacity(min(max_results, suggested_bangs.size()));
+
+    i32 relevance = 1900;
+    for (auto const* bang : suggested_bangs) {
+        if (skip_trigger.has_value() && bang->trigger.equals_ignoring_ascii_case(*skip_trigger))
+            continue;
+        if (suggestions.size() >= max_results)
+            break;
+
+        auto trigger_text = MUST(String::formatted("!{}", bang->trigger));
+        auto fill_text = MUST(String::formatted("!{} ", bang->trigger));
+        suggestions.unchecked_append({
+            .source = AutocompleteSuggestionSource::Search,
+            .text = move(fill_text),
+            .title = move(trigger_text),
+            .subtitle = MUST(String::from_utf8(bang->name)),
+            .favicon_png = {},
+            .highlight_input = {},
+            .relevance = relevance--,
+            .is_verbatim = false,
+            .can_be_automatically_selected = false,
+            .can_be_inline_completed = false,
+            .fills_omnibox_only = true,
+        });
+    }
+
+    return suggestions;
+}
