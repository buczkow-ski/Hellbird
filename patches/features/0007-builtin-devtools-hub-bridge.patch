+DevToolsAgent* Application::devtools_agent_of_view(u64 view_id) const
+{
+    auto view = m_views.find(view_id);
+    if (view == m_views.end())
+        return nullptr;
+    return &view->value->devtools_agent();
+}
+
+// A client of the DevTools server takes the place of the view's built-in developer tools for as long as it is connected.
+// NB: What these override is private, so each does what that does as well.
+void Application::stop_listening_for_inspect_element_requests(DevTools::TabDescription const& description) const
+{
+    auto view = WebView::ViewImplementation::find_view_by_id(description.id);
+    if (!view.has_value())
+        return;
+
+    view->on_inspect_element_request = nullptr;
+    if (auto* agent = devtools_agent_of_view(description.id))
+        agent->external_client_did_stop_listening_for_inspect_element_requests();
+}
+
+void Application::did_connect_devtools_client(DevTools::TabDescription const& description) const
+{
+    auto view = WebView::ViewImplementation::find_view_by_id(description.id);
+    if (!view.has_value())
+        return;
+
+    if (auto* agent = devtools_agent_of_view(description.id))
+        agent->external_client_will_connect();
+    view->did_connect_devtools_client();
+}
+
+void Application::did_disconnect_devtools_client(DevTools::TabDescription const& description) const
+{
+    auto view = WebView::ViewImplementation::find_view_by_id(description.id);
+    if (!view.has_value())
+        return;
+
+    view->did_disconnect_devtools_client();
+    if (auto* agent = devtools_agent_of_view(description.id))
+        agent->external_client_did_disconnect();
+}
+
 }
