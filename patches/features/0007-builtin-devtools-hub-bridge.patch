+
+void RemoteView::devtools_set_attributes(i64 node_id, Optional<String> replace_name, Vector<DevToolsAttribute> attributes, DevToolsReply on_reply)
+{
+    JsonArray serialized_attributes;
+    for (auto& attribute : attributes) {
+        JsonObject serialized_attribute;
+        serialized_attribute.set("name"sv, move(attribute.name));
+        serialized_attribute.set("value"sv, move(attribute.value));
+        serialized_attributes.must_append(move(serialized_attribute));
+    }
+
+    auto params = devtools_node_params(node_id);
+    if (replace_name.has_value())
+        params.set("replace"sv, replace_name.release_value());
+    params.set("attributes"sv, move(serialized_attributes));
+    send_devtools_request("set-attributes"sv, params, move(on_reply));
+}
