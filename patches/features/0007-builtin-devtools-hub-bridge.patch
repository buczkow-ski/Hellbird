+void RemoteView::devtools_get_storage(DevToolsStorage storage, DevToolsReply on_reply)
+{
+    send_devtools_request("get-storage"sv, devtools_storage_params(storage), move(on_reply));
+}
+
+void RemoteView::devtools_set_storage_item(DevToolsStorage storage, String key, String value, DevToolsReply on_reply)
+{
+    auto params = devtools_storage_params(storage);
+    params.set("key"sv, move(key));
+    params.set("value"sv, move(value));
+    send_devtools_request("set-storage-item"sv, params, move(on_reply));
+}
+
+void RemoteView::devtools_remove_storage_item(DevToolsStorage storage, String key, DevToolsReply on_reply)
+{
+    auto params = devtools_storage_params(storage);
+    params.set("key"sv, move(key));
+    send_devtools_request("remove-storage-item"sv, params, move(on_reply));
+}
+
+void RemoteView::devtools_clear_storage(DevToolsStorage storage, DevToolsReply on_reply)
+{
+    send_devtools_request("clear-storage"sv, devtools_storage_params(storage), move(on_reply));
+}
+
 }
