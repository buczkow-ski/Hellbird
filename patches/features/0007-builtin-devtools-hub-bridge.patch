+
+namespace Hub {
+
+class View;
+
+// What the built-in developer tools of a view ask of its page, and what they hear from it.
+//
+// Each of the view's callbacks for developer tools has room for one listener. So the built-in tools listen only while
+// they are attached, and give way while a client of the DevTools server is connected to the view.
+class DevToolsAgent final : public Weakable<DevToolsAgent> {
+    AK_MAKE_NONCOPYABLE(DevToolsAgent);
+    AK_MAKE_NONMOVABLE(DevToolsAgent);
+
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit DevToolsAgent(View&);
+    ~DevToolsAgent();
+
+    // The UI offers Inspect Element for a tab whether or not its developer tools are open.
+    void listen_for_inspect_element_requests();
+
+    void handle_command(u64 request_id, StringView command, ByteString const& params_json);
+
+    void did_commit_navigation();
+    // The page crashed, or was replaced after a crash.
+    void did_change_page_availability();
+
+    void external_client_will_connect();
+    void external_client_did_disconnect();
+    void external_client_did_stop_listening_for_inspect_element_requests();
+
+private:
+    using Result = ErrorOr<JsonValue, String>;
+
+    // Replies to these carry nothing that tells which request they answer, so there is at most one request of each kind
+    // on its way at a time.
+    enum class Slot : u8 {
+        DOMTree,
+        NodeProperties,
+        HTML,
+        Edit,
+        StyleSheetList,
+        Source,
+        Count,
+    };
+
+    struct Operation {
+        u64 request_id { 0 };
+        Function<void()> send;
+        Function<void(Result)> on_result;
+        u64 fence { 0 };
+    };
+
+    struct OperationQueue {
+        Optional<Operation> in_flight;
+        Queue<Operation> waiting;
+    };
+
+    struct KnownNode {
+        enum class Type : u8 {
+            Element,
+            CharacterData,
+            Document,
+            ShadowRoot,
+            Other,
+        };
+        Type type { Type::Other };
+        bool is_child_of_document { false };
+        bool is_in_html_document { false };
+        bool is_html_element { false };
+    };
+
+    struct NetworkEntry {
+        ByteBuffer body;
+        String mime_type;
+        bool truncated { false };
+    };
+
+    template<typename Callback>
+    auto weak(Callback&& callback)
+    {
+        return [weak_self = make_weak_ptr<DevToolsAgent>(), callback = forward<Callback>(callback)]<typename... Args>(Args&&... args) mutable {
+            if (auto* self = weak_self.unsafe_ptr())
+                callback(*self, forward<Args>(args)...);
+        };
+    }
+
+    bool has_open_page() const;
+    bool has_usable_page() const;
+    DevTools::TabDescription description() const;
+
+    void attach();
+    void detach(StringView reason, String error);
+    void let_go(String error);
+    void install_callbacks();
+    void remove_callbacks();
+    void announce_availability_if_possible();
+    void sync_display_page();
+    void rearm_dom_mutations();
+
+    void expect_reply(u64 request_id, AK::Duration timeout);
+    void reply(u64 request_id, JsonValue const&);
+    void fail(u64 request_id, String const& error);
+    void reply_with(u64 request_id, Result const&);
+    void fail_everything(String const& error);
+    void send_reply(u64 request_id, bool ok, ByteString payload);
+    void send_event(StringView name, JsonObject const& payload);
+    void send_detached(StringView reason);
+    void check_timeouts();
+
+    void run(Slot, u64 request_id, Function<void()> send, Function<void(Result)> on_result);
+    void start_next(Slot);
+    void settle(Slot, Result);
+    void fence_returned(Slot, u64 fence);
+    OperationQueue& operations_for(Slot slot) { return m_queues[to_underlying(slot)]; }
+
+    void request_dom_tree(u64 request_id, Function<void(Result)> on_result);
+    void learn_nodes(JsonObject const& document);
+    Optional<String> reason_not_to_edit(i64 node_id) const;
+    void edit(u64 request_id, Function<void()> send);
+    void remove_node(u64 request_id, i64 node_id);
+    void edit_node(u64 request_id, StringView command, i64 node_id, JsonObject const& params);
+    void get_node_properties(u64 request_id, JsonObject const& params);
+    void complete(u64 request_id, String const& input);
+
+    void start_picker();
+    void stop_picker(StringView event_type, Optional<i64> node_id = {});
+    void did_receive_picker_event(DevTools::DevToolsDelegate::NodePickerEvent);
+
+    void list_sources(u64 request_id);
+    void list_sources_with_style_sheets(u64 request_id, JsonArray sources);
+    void get_source(u64 request_id, String const& key);
+    void get_cookies(u64 request_id);
+    void delete_cookie(u64 request_id, JsonObject const& cookie_to_delete);
+    void handle_storage_command(u64 request_id, StringView command, JsonObject const& params);
+    void get_response_body(u64 request_id, u64 network_id);
+    void evict_network_entries();
+
+    void schedule_coalesced_events();
+    void send_coalesced_events();
+
+    View& m_view;
+
+    bool m_listens_for_inspect_element_requests { false };
+    bool m_attached { false };
+    bool m_external_client_connected { false };
+    bool m_announces_availability { false };
+    // The view still takes there to be a client, as the page was gone when the tools let go of it.
+    bool m_client_to_disconnect { false };
+    bool m_picker_active { false };
+    bool m_wants_dom_mutations { false };
+    Optional<Web::PageId> m_page_id;
+
+    HashMap<u64, MonotonicTime> m_pending_replies;
+    RefPtr<Core::Timer> m_timeout_timer;
+    OperationQueue m_queues[to_underlying(Slot::Count)];
+    u64 m_next_fence { 1 };
+
+    HashMap<i64, KnownNode> m_known_nodes;
+    WebView::DOMNodeProperties::Type m_expected_properties { WebView::DOMNodeProperties::Type::ComputedStyle };
+    Vector<Web::CSS::StyleSheetIdentifier> m_received_style_sheets;
+    HashMap<String, Web::CSS::StyleSheetIdentifier> m_style_sheets;
+    Optional<Web::CSS::StyleSheetIdentifier> m_expected_style_sheet;
+
+    // Each process numbers its requests anew, so the UI knows them by IDs from here.
+    HashMap<u64, u64> m_network_ids;
+    OrderedHashMap<u64, NetworkEntry> m_network_entries;
+    size_t m_network_body_bytes { 0 };
+    u64 m_next_network_id { 1 };
+
+    Optional<u64> m_storage_listener_id;
+    HashTable<i64> m_mutated_nodes;
+    bool m_child_list_changed { false };
+    bool m_cookies_changed { false };
+    bool m_local_storage_changed { false };
+    bool m_session_storage_changed { false };
+    RefPtr<Core::Timer> m_coalescing_timer;
+};
+
+}
