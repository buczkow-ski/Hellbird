+void RemoteView::send_devtools_command(StringView command, JsonObject const& params, u64 request_id)
+{
+    HubConnection::the().async_view_devtools_command(view_id(), request_id, MUST(String::from_utf8(command)), params.serialized().to_byte_string());
+}
+
+void RemoteView::send_devtools_request(StringView command, JsonObject const& params, DevToolsReply on_reply)
+{
+    auto request_id = m_next_request_id++;
+    m_pending_devtools_replies.set(request_id, move(on_reply));
+    send_devtools_command(command, params, request_id);
+}
+
+void RemoteView::did_receive_devtools_reply(u64 request_id, bool ok, ByteString const& payload)
+{
+    auto on_reply = m_pending_devtools_replies.take(request_id);
+    if (!on_reply.has_value() || !*on_reply)
+        return;
+
+    if (!ok) {
+        (*on_reply)(String::from_utf8_with_replacement_character(payload));
+        return;
+    }
+
+    auto value = JsonValue::from_string(payload);
+    if (value.is_error())
+        (*on_reply)("invalid"_string);
+    else
+        (*on_reply)(value.release_value());
+}
+
+static Optional<RemoteView::DevToolsEvent> devtools_event_from_name(String const& name)
+{
+    if (name == "Attached"sv)
+        return RemoteView::DevToolsEvent::Attached;
+    if (name == "Detached"sv)
+        return RemoteView::DevToolsEvent::Detached;
+    if (name == "Available"sv)
+        return RemoteView::DevToolsEvent::Available;
+    if (name == "InspectElement"sv)
+        return RemoteView::DevToolsEvent::InspectElement;
+    if (name == "Navigated"sv)
+        return RemoteView::DevToolsEvent::Navigated;
+    if (name == "Picker"sv)
+        return RemoteView::DevToolsEvent::Picker;
+    if (name == "DomMutated"sv)
+        return RemoteView::DevToolsEvent::DomMutated;
+    if (name == "Console"sv)
+        return RemoteView::DevToolsEvent::Console;
+    if (name == "EvalResult"sv)
+        return RemoteView::DevToolsEvent::EvalResult;
+    if (name == "NetworkStarted"sv)
+        return RemoteView::DevToolsEvent::NetworkStarted;
+    if (name == "NetworkHeaders"sv)
+        return RemoteView::DevToolsEvent::NetworkHeaders;
+    if (name == "NetworkFinished"sv)
+        return RemoteView::DevToolsEvent::NetworkFinished;
+    if (name == "SourceAdded"sv)
+        return RemoteView::DevToolsEvent::SourceAdded;
+    if (name == "StorageChanged"sv)
+        return RemoteView::DevToolsEvent::StorageChanged;
+    return {};
+}
+
+void RemoteView::did_receive_devtools_event(String const& name, ByteString const& payload)
+{
+    auto event = devtools_event_from_name(name);
+    if (!event.has_value())
+        return;
+
+    // NB: A page can nest what it logs too deeply to be parsed.
+    auto value = JsonValue::from_string(payload);
+    if (value.is_error() || !value.value().is_object())
+        return;
+
+    if (*event == DevToolsEvent::Attached)
+        m_devtools_attached = true;
+    else if (*event == DevToolsEvent::Detached)
+        m_devtools_attached = false;
+
+    if (on_devtools_event)
+        on_devtools_event(*event, value.value().as_object());
+}
+
+static JsonObject devtools_node_params(i64 node_id, Optional<u32> pseudo = {})
+{
+    JsonObject params;
+    params.set("nodeId"sv, node_id);
+    if (pseudo.has_value())
+        params.set("pseudo"sv, *pseudo);
+    return params;
+}
+
+static JsonObject devtools_storage_params(RemoteView::DevToolsStorage storage)
+{
+    JsonObject params;
+    params.set("store"sv, storage == RemoteView::DevToolsStorage::Local ? "local"sv : "session"sv);
+    return params;
+}
+
+static StringView devtools_node_properties_name(RemoteView::DevToolsNodeProperties properties)
+{
+    switch (properties) {
+    case RemoteView::DevToolsNodeProperties::AppliedRules:
+        return "applied-rules"sv;
+    case RemoteView::DevToolsNodeProperties::Computed:
+        return "computed"sv;
+    case RemoteView::DevToolsNodeProperties::Layout:
+        return "layout"sv;
+    case RemoteView::DevToolsNodeProperties::Fonts:
+        return "fonts"sv;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+void RemoteView::devtools_attach()
+{
+    send_devtools_command("attach"sv);
+}
+
+void RemoteView::devtools_detach()
