+ReadonlySpan<Bang> builtin_bangs()
+{
+    return s_builtin_bangs;
+}
+
+static Bang const* find_bang_for_token(StringView token)
+{
+    if (token.length() < 2 || !token.starts_with('!'))
+        return nullptr;
+
+    auto trigger = token.substring_view(1);
+    for (auto const& bang : s_builtin_bangs) {
+        if (bang.trigger.equals_ignoring_ascii_case(trigger))
+            return &bang;
+    }
+    return nullptr;
+}
+
+Optional<BangMatch> match_bang(StringView input)
+{
+    input = input.trim_whitespace();
+
+    auto first_token_end = input.find_any_of(ASCII_WHITESPACE).value_or(input.length());
+    if (auto const* bang = find_bang_for_token(input.substring_view(0, first_token_end)))
+        return BangMatch { .bang = bang, .query = input.substring_view(first_token_end).trim_whitespace() };
+
+    auto last_separator = input.find_any_of(ASCII_WHITESPACE, StringView::SearchDirection::Backward);
+    if (!last_separator.has_value())
+        return {};
+    if (auto const* bang = find_bang_for_token(input.substring_view(*last_separator + 1)))
+        return BangMatch { .bang = bang, .query = input.substring_view(0, *last_separator).trim_whitespace() };
+
+    return {};
+}
+
+Optional<URL::URL> url_for_bang(BangMatch const& match)
+{
+    if (match.query.is_empty())
+        return URL::Parser::basic_parse(match.bang->home_url);
+
+    auto encoded_query = URL::percent_encode(match.query, URL::PercentEncodeSet::Component);
+    auto query_url = MUST(String::from_utf8(match.bang->query_url));
+    return URL::Parser::basic_parse(MUST(query_url.replace("%s"sv, encoded_query, ReplaceMode::FirstOnly)));
+}
+
+String bang_description(BangMatch const& match)
+{
+    return MUST(String::formatted("{} {}", match.query.is_empty() ? "Open"sv : "Search"sv, match.bang->name));
+}
+
+}
diff --git a/Libraries/LibWebView/Bang.h b/Libraries/LibWebView/Bang.h
new file mode 100644
index 0000000000..e1ebdf1a74
--- /dev/null
+++ b/Libraries/LibWebView/Bang.h
@@ -0,0 +1,52 @@
+/*
+ * Copyright (c) 2026, the Hellbird contributors.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/Span.h>
+#include <AK/String.h>
+#include <AK/StringView.h>
+#include <AK/Types.h>
+#include <LibURL/URL.h>
+#include <LibWebView/Forward.h>
+
+namespace WebView {
+
+enum class EnableBangs : u8 {
+    No,
+    Yes,
+};
+
+// A bang is a shortcut to a website's own search, such as "!gh" for GitHub. It is resolved in the browser, so the text
+// goes straight to that website and to no search engine on the way.
+struct Bang {
+    StringView trigger;
+    StringView name;
+    StringView home_url;
+    // Where a search goes, with "%s" in place of the percent-encoded query.
+    StringView query_url;
+};
+
+struct BangMatch {
+    // NB: Bangs are built in, so this outlives any match.
+    Bang const* bang { nullptr };
+    // What to search for, which is empty if only the bang was typed. This is a view of the text that was matched.
+    StringView query;
+};
+
+WEBVIEW_API ReadonlySpan<Bang> builtin_bangs();
+
+// Matches "!gh query", "query !gh" and "!gh". A bang at the start wins over one at the end, and text with only unknown
+// bangs does not match, so it is searched for as it is.
+WEBVIEW_API Optional<BangMatch> match_bang(StringView input);
+
+WEBVIEW_API Optional<URL::URL> url_for_bang(BangMatch const&);
+
+// Where the match goes, such as "Search GitHub".
+WEBVIEW_API String bang_description(BangMatch const&);
+
+}
