+static QString& stored_os_system_font_family()
+{
+    static auto* family = new QString();
+    return *family;
+}
+
+QString const& os_system_font_family()
+{
+    return stored_os_system_font_family();
+}
+
+QRegion rounded_rect_region(QRect const& rect, int radius)
+{
+    if (rect.isEmpty())
+        return {};
+    auto r = min(radius, min(rect.width(), rect.height()) / 2);
+    if (r <= 0)
+        return QRegion(rect);
+    QRegion region(rect.adjusted(0, r, 0, -r));
+    for (int y = 0; y < r; ++y) {
+        auto dy = r - (y + 0.5);
+        auto inset = qFloor(r - qSqrt((r * r) - (dy * dy)));
+        auto w = rect.width() - (2 * inset);
+        region += QRect(rect.left() + inset, rect.top() + y, w, 1);
+        region += QRect(rect.left() + inset, rect.bottom() - y, w, 1);
+    }
+    return region;
+}
+
+static QString load_bundled_inter_font_family()
+{
+    if (WebView::s_ladybird_resource_root.is_empty())
+        return {};
+
+    auto fonts_dir = QDir(qstring_from_ak_string(WebView::s_ladybird_resource_root)).filePath(QStringLiteral("ladybird/fonts"));
+    static constexpr QLatin1StringView font_files[] = {
+        QLatin1StringView("Inter-Regular.ttf"),
+        QLatin1StringView("Inter-Medium.ttf"),
+        QLatin1StringView("Inter-SemiBold.ttf"),
+        QLatin1StringView("Inter-Bold.ttf"),
+    };
+
+    QString family;
+    for (auto file_name : font_files) {
+        auto path = QDir(fonts_dir).filePath(file_name);
+        if (!QFileInfo::exists(path))
+            continue;
+        auto id = QFontDatabase::addApplicationFont(path);
+        if (id >= 0 && family.isEmpty()) {
+            auto families = QFontDatabase::applicationFontFamilies(id);
+            if (!families.isEmpty())
+                family = families.first();
+        }
+    }
+    return family;
+}
