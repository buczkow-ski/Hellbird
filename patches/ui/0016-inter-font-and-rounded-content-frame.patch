+static bool set_windows_dwm_corner_preference(HWND hwnd, bool rounded)
+{
+    if (!hwnd)
+        return false;
+
+    using DwmSetWindowAttributeFn = HRESULT(WINAPI*)(HWND, DWORD, LPCVOID, DWORD);
+    static DwmSetWindowAttributeFn dwm_set_window_attribute = []() -> DwmSetWindowAttributeFn {
+        HMODULE dwmapi = GetModuleHandleW(L"dwmapi.dll");
+        if (!dwmapi)
+            dwmapi = LoadLibraryW(L"dwmapi.dll");
+        if (!dwmapi)
+            return nullptr;
+#    if defined(__clang__)
+#        pragma clang diagnostic push
+#        pragma clang diagnostic ignored "-Wcast-function-type-mismatch"
+#    endif
+        auto fn = reinterpret_cast<DwmSetWindowAttributeFn>(GetProcAddress(dwmapi, "DwmSetWindowAttribute"));
+#    if defined(__clang__)
+#        pragma clang diagnostic pop
+#    endif
+        return fn;
+    }();
+    if (!dwm_set_window_attribute)
+        return false;
+
+    constexpr DWORD DWMWA_WINDOW_CORNER_PREFERENCE_VALUE = 33;
+    constexpr DWORD DWMWCP_DEFAULT_VALUE = 0;
+    constexpr DWORD DWMWCP_ROUND_VALUE = 2;
+    DWORD preference = rounded ? DWMWCP_ROUND_VALUE : DWMWCP_DEFAULT_VALUE;
+    return SUCCEEDED(dwm_set_window_attribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE_VALUE, &preference, sizeof(preference)));
+}
