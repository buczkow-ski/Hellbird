+static constexpr int CONTENT_FRAME_CORNER_RADIUS = 10;
+
+static int content_frame_corner_radius()
+{
+    // Wayland dma-buf subsurfaces cannot be rounded by widget masks, so keep square corners on Wayland.
+    if (QGuiApplication::platformName().startsWith("wayland"))
+        return 0;
+    return CONTENT_FRAME_CORNER_RADIUS;
+}
+
+class PageFrame final : public QWidget {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit PageFrame(QStackedWidget& content, QWidget* parent)
+        : QWidget(parent)
+        , m_content(&content)
+    {
+        setObjectName("LadybirdPageFrame");
+        m_layout = new QVBoxLayout(this);
+        m_layout->setSpacing(0);
+        m_layout->setContentsMargins(0, 0, 0, 0);
+        m_layout->addWidget(&content);
+    }
+
+    void set_framed(bool framed)
+    {
+        if (m_framed == framed)
+            return;
+        m_framed = framed;
+        // 6 px outer chrome on left/right/bottom, 4 px on top, plus 1 px on each side for the rounded border.
+        m_layout->setContentsMargins(m_framed ? QMargins(7, 5, 7, 7) : QMargins());
+        update();
+    }
+
+private:
+    virtual void paintEvent(QPaintEvent*) override
+    {
+        if (!m_framed)
+            return;
+        QPainter painter(this);
+        auto const& chrome_palette = Theme::chrome_palette(*this);
+        painter.fillRect(rect(), ChromeStyle::chrome_background(chrome_palette));
+        if (!m_content || m_content->geometry().isEmpty())
+            return;
+        painter.setRenderHint(QPainter::Antialiasing, true);
+        painter.setBrush(Qt::NoBrush);
+        painter.setPen(QPen(ChromeStyle::chrome_border(chrome_palette), 1));
+        auto corner_radius = content_frame_corner_radius();
+        if (corner_radius > 0) {
+            auto radius = static_cast<qreal>(corner_radius) + 0.5;
+            painter.drawRoundedRect(QRectF(m_content->geometry()).adjusted(-0.5, -0.5, 0.5, 0.5), radius, radius);
+        } else {
+            painter.drawRect(QRectF(m_content->geometry()).adjusted(-0.5, -0.5, 0.5, 0.5));
+        }
+    }
+
+    QStackedWidget* m_content { nullptr };
+    QVBoxLayout* m_layout { nullptr };
+    bool m_framed { false };
+};
