+void WebContentView::apply_windows_corner_mask(CornerMaskPass pass)
+{
+    if (m_corner_radius <= 0 || rect().isEmpty()) {
+        clearMask();
+        return;
+    }
+
+    auto r = min(m_corner_radius, min(width(), height()) / 2);
+    if (r <= 0) {
+        clearMask();
+        return;
+    }
+
+    // Give Qt a conservative cross-shaped mask so the parent PageFrame always paints the corner pixels cleanly at
+    // fractional DPI, then apply the exact device-pixel rounded region directly to the native HWND.
+    QRegion cross_mask(rect().adjusted(0, r, 0, -r));
+    cross_mask += rect().adjusted(r, 0, -r, 0);
+    setMask(cross_mask);
+
+    if (auto* hwnd = reinterpret_cast<HWND>(internalWinId())) {
+        auto dpr = devicePixelRatioF();
+        int logical_device_width = qRound(width() * dpr);
+        int logical_device_height = qRound(height() * dpr);
+        int device_width = logical_device_width;
+        int device_height = logical_device_height;
+        RECT client_rect {};
+        if (GetClientRect(hwnd, &client_rect)) {
+            device_width = client_rect.right - client_rect.left;
+            device_height = client_rect.bottom - client_rect.top;
+        }
+        // During pending resizes on newly shown or hidden views, GetClientRect can lag behind Qt's new widget size.
+        // Never crop on the immediate pass; the settled pass re-applies the exact physical rect once Qt resizes the HWND.
+        if (pass == CornerMaskPass::Immediate) {
+            device_width = max(device_width, logical_device_width);
+            device_height = max(device_height, logical_device_height);
+        }
+        auto radius_px = max(1, qRound(r * dpr));
+        if (HRGN region = CreateRoundRectRgn(0, 0, device_width + 1, device_height + 1, 2 * radius_px, 2 * radius_px)) {
+            if (!SetWindowRgn(hwnd, region, TRUE))
+                DeleteObject(region);
+        }
+    }
+}
+
 void WebContentView::native_window_changed()
 {
     if (m_hosts_remote_layer) {
         m_hosts_remote_layer = false;
         set_hosts_remote_layer(false);
     }
+    update_corner_mask();
     update_whether_view_hosts_remote_layer();
 }
 
