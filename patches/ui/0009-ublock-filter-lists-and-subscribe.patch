+ErrorOr<String> Application::add_content_blocker_subscription(Badge<SettingsUI, SubscribeUI>, String name, URL::URL url, Optional<ReadonlyBytes> preloaded_contents)
+{
+    if (!url.scheme().is_one_of("http"sv, "https"sv))
+        return Error::from_string_literal("Subscription URL must use HTTP or HTTPS");
+    if (preloaded_contents.has_value() && preloaded_contents->size() > maximum_content_blocker_list_size)
+        return Error::from_string_literal("Content blocker list exceeds 64 MiB");
+
+    for (auto const& existing : m_settings->content_blocker_lists()) {
+        if (existing.url == url) {
+            auto identifier = existing.identifier;
+            if (preloaded_contents.has_value() && !preloaded_contents->is_empty()) {
+                TRY(save_content_blocker_list(content_blocker_list_path(identifier), *preloaded_contents));
+                if (!existing.enabled)
+                    m_settings->set_content_blocker_list_enabled(identifier, true);
+                else
+                    apply_content_blocker_settings();
+            } else {
+                if (!existing.enabled)
+                    m_settings->set_content_blocker_list_enabled(identifier, true);
+                if (!content_blocker_list_last_updated_at(identifier).has_value())
+                    start_content_blocker_list_update(ContentBlockerListUpdateTrigger::UserInitiated, identifier);
+            }
+            return identifier;
+        }
+    }
+
+    auto trimmed_name = name.bytes_as_string_view().trim_whitespace();
+    auto resolved_name = trimmed_name.is_empty() ? url.serialize() : MUST(String::from_utf8(trimmed_name));
+
+    if (preloaded_contents.has_value() && !preloaded_contents->is_empty()) {
+        // Add disabled first so saving finishes before any observer sees an enabled list without a file on disk.
+        auto identifier = m_settings->add_content_blocker_list(move(resolved_name), move(url), false);
+        auto result = save_content_blocker_list(content_blocker_list_path(identifier), *preloaded_contents);
+        if (result.is_error()) {
+            m_settings->remove_content_blocker_list(identifier);
+            return result.release_error();
+        }
+        m_settings->set_content_blocker_list_enabled(identifier, true);
+        return identifier;
+    }
+
+    auto identifier = m_settings->add_content_blocker_list(move(resolved_name), move(url));
+    start_content_blocker_list_update(ContentBlockerListUpdateTrigger::UserInitiated, identifier);
+    return identifier;
+}
