+
+        <script type="module">
+            const titleEl = document.querySelector("#list-title");
+            const urlEl = document.querySelector("#list-url");
+            const metaEl = document.querySelector("#list-meta");
+            const subscribeBtn = document.querySelector("#subscribe-btn");
+            const unsubscribeBtn = document.querySelector("#unsubscribe-btn");
+            const toolbar = document.querySelector("#toolbar");
+            const searchInput = document.querySelector("#search-input");
+            const prevMatchBtn = document.querySelector("#prev-match");
+            const nextMatchBtn = document.querySelector("#next-match");
+            const searchCountEl = document.querySelector("#search-count");
+            const statusTextEl = document.querySelector("#status-text");
+            const copyUrlBtn = document.querySelector("#copy-url-btn");
+            const manualPanel = document.querySelector("#manual-panel");
+            const manualForm = document.querySelector("#manual-form");
+            const manualUrlInput = document.querySelector("#manual-url");
+            const loadingPanel = document.querySelector("#loading-panel");
