+
+namespace WebView {
+
+static constexpr size_t maximum_filter_list_bytes = 64 * MiB;
+static constexpr size_t maximum_preview_bytes = 4 * MiB;
+static constexpr size_t maximum_redirects = 10;
+static constexpr size_t maximum_title_bytes = 200;
+
+struct FilterListMetadata {
+    Optional<String> title;
+    Optional<String> homepage;
+    Optional<String> last_modified;
+    Optional<String> version;
+    Optional<String> expires;
+    Optional<String> description;
+    size_t line_count { 0 };
+    size_t rule_count { 0 };
+};
+
+static String clamp_title(StringView raw)
+{
+    auto trimmed = raw.trim_whitespace();
+    if (trimmed.length() <= maximum_title_bytes)
+        return String::from_utf8_with_replacement_character(trimmed);
+
+    auto sanitized = String::from_utf8_with_replacement_character(trimmed);
+    size_t cut = 0;
+    Utf8View utf8 { sanitized.bytes_as_string_view() };
+    for (auto it = utf8.begin(); it != utf8.end(); ++it) {
+        auto next_offset = utf8.byte_offset_of(it) + it.underlying_code_point_length_in_bytes();
+        if (next_offset > maximum_title_bytes)
+            break;
+        cut = next_offset;
+    }
+    return MUST(String::from_utf8(sanitized.bytes_as_string_view().substring_view(0, cut).trim_whitespace()));
+}
+
+static bool looks_like_markup_document(StringView text)
+{
+    if (text.starts_with("\xEF\xBB\xBF"sv))
+        text = text.substring_view(3);
+    auto trimmed = text.trim_whitespace(TrimMode::Left);
+    return trimmed.starts_with("<!doctype"sv, CaseSensitivity::CaseInsensitive)
+        || trimmed.starts_with("<html"sv, CaseSensitivity::CaseInsensitive)
+        || trimmed.starts_with("<head"sv, CaseSensitivity::CaseInsensitive)
+        || trimmed.starts_with("<body"sv, CaseSensitivity::CaseInsensitive)
+        || trimmed.starts_with("<?xml"sv, CaseSensitivity::CaseInsensitive)
+        || trimmed.starts_with("<script"sv, CaseSensitivity::CaseInsensitive);
+}
+
+static Optional<String> parse_header_field(StringView line, StringView prefix)
+{
+    if (!line.starts_with(prefix, CaseSensitivity::CaseInsensitive))
+        return {};
+    auto value = line.substring_view(prefix.length()).trim_whitespace();
+    if (value.is_empty())
+        return {};
+    return String::from_utf8_with_replacement_character(value);
+}
+
+static FilterListMetadata analyze_filter_list(StringView text)
+{
+    FilterListMetadata metadata;
+    if (text.starts_with("\xEF\xBB\xBF"sv))
+        text = text.substring_view(3);
+    if (text.ends_with('\n'))
+        text = text.substring_view(0, text.length() - 1);
+    if (text.is_empty())
+        return metadata;
+
+    text.for_each_split_view('\n', SplitBehavior::KeepEmpty, [&](StringView raw_line) {
+        ++metadata.line_count;
+        auto line = raw_line.trim("\r"sv, TrimMode::Right);
+        auto trimmed = line.trim_whitespace();
+        if (trimmed.is_empty())
+            return;
+
+        if (metadata.line_count <= 80 && trimmed.starts_with('!')) {
+            if (!metadata.title.has_value())
+                metadata.title = parse_header_field(trimmed, "! Title:"sv);
+            if (!metadata.homepage.has_value())
+                metadata.homepage = parse_header_field(trimmed, "! Homepage:"sv);
+            if (!metadata.last_modified.has_value())
+                metadata.last_modified = parse_header_field(trimmed, "! Last modified:"sv);
+            if (!metadata.version.has_value())
+                metadata.version = parse_header_field(trimmed, "! Version:"sv);
+            if (!metadata.expires.has_value())
+                metadata.expires = parse_header_field(trimmed, "! Expires:"sv);
+            if (!metadata.description.has_value())
+                metadata.description = parse_header_field(trimmed, "! Description:"sv);
+            return;
+        }
+
+        if (trimmed.starts_with('!')
+            || trimmed.starts_with("[Adblock"sv, CaseSensitivity::CaseInsensitive)
+            || trimmed.starts_with("[uBlock"sv, CaseSensitivity::CaseInsensitive)) {
+            return;
+        }
+
+        ++metadata.rule_count;
+    });
+
+    return metadata;
+}
+
+static Optional<ContentBlockerList> find_list_for_url(URL::URL const& url)
+{
+    for (auto const& list : Application::settings().content_blocker_lists()) {
+        if (list.url == url)
+            return list;
+    }
+    return {};
+}
+
+static void populate_subscription_fields(JsonObject& object, Optional<ContentBlockerList> const& existing)
+{
+    object.set("subscribed"sv, existing.has_value());
+    object.set("enabled"sv, existing.has_value() && existing->enabled);
+    object.set("builtIn"sv, existing.has_value() && existing->built_in);
+    object.set("globalEnabled"sv, Application::settings().content_blocker_enabled());
+    object.set("identifier"sv, existing.has_value() ? JsonValue(existing->identifier) : JsonValue {});
+}
+
+SubscribeUI::~SubscribeUI()
+{
+    m_alive->alive = false;
+    ++m_fetch_generation;
+    if (m_active_request) {
+        m_active_request->stop();
+        m_active_request = nullptr;
+    }
+}
+
+void SubscribeUI::register_interfaces()
+{
+    register_interface("loadSubscription"sv, [this](auto const& data) {
+        load_subscription(data);
+    });
+    register_interface("subscribe"sv, [this](auto const& data) {
+        subscribe(data);
+    });
+    register_interface("unsubscribe"sv, [this](auto const& data) {
+        unsubscribe(data);
+    });
+}
+
+void SubscribeUI::content_blocker_settings_changed()
+{
+    if (!has_client() || !m_requested_url.has_value())
+        return;
+    send_subscription_state();
+}
+
+void SubscribeUI::send_subscription_state()
+{
+    if (!has_client() || !m_requested_url.has_value())
+        return;
+    JsonObject state;
+    state.set("url"sv, m_requested_url->serialize());
+    populate_subscription_fields(state, find_list_for_url(*m_requested_url));
+    async_send_message("subscriptionState"sv, move(state));
+}
+
+void SubscribeUI::cancel_fetch()
+{
+    ++m_fetch_generation;
+    if (m_active_request) {
+        auto request = move(m_active_request);
+        request->stop();
+        // Keep the Request alive until the current callback frame unwinds.
+        Core::deferred_invoke([request = move(request)] { });
+    }
+    m_pending_payload.clear();
+    m_response_ok = false;
+    m_response_code.clear();
+}
+
+void SubscribeUI::load_subscription(JsonValue const& data)
+{
+    if (!data.is_object() || !has_client())
+        return;
+
+    auto raw_url = data.as_object().get_string("url"sv);
+    if (!raw_url.has_value())
+        return;
+
+    auto parsed_url = URL::Parser::basic_parse(*raw_url);
+    if (!parsed_url.has_value() || !parsed_url->scheme().is_one_of("http"sv, "https"sv)) {
+        JsonObject err;
+        err.set("url"sv, *raw_url);
+        err.set("message"sv, "Filter list URLs must use HTTP or HTTPS."sv);
+        async_send_message("subscriptionError"sv, move(err));
+        return;
+    }
+
+    cancel_fetch();
+    m_requested_url = *parsed_url;
+    m_requested_title = data.as_object().get_string("title"sv).copy().value_or(String {});
+    m_loaded_url.clear();
+    m_loaded_payload.clear();
+    m_resolved_title = {};
+
+    send_subscription_state();
+    start_fetch(*parsed_url, *parsed_url, 0);
+}
+
+void SubscribeUI::start_fetch(URL::URL original_url, URL::URL fetch_url, size_t redirect_count)
+{
+    cancel_fetch();
+    auto const generation = m_fetch_generation;
+
+    auto send_error = [&](String message) {
+        if (!has_client())
+            return;
+        JsonObject err;
+        err.set("url"sv, original_url.serialize());
+        err.set("message"sv, move(message));
+        async_send_message("subscriptionError"sv, move(err));
+    };
+
+    if (!has_client())
+        return;
+
+    auto request_headers = HTTP::HeaderList::create();
+    request_headers->set({ "User-Agent"sv, Web::default_user_agent });
+
+    auto client_result = Application::request_server_client(client().is_private());
+    if (client_result.is_error()) {
+        send_error(MUST(String::formatted("Unable to connect to RequestServer: {}", client_result.error())));
+        return;
+    }
+
+    m_active_request = client_result.value()->start_request(
+        "GET"sv, fetch_url, {}, *request_headers, {}, HTTP::CacheMode::NoStore,
+        HTTP::Cookie::IncludeCredentials::No);
+    if (!m_active_request) {
+        send_error("Unable to start filter list download."_string);
+        return;
+    }
+
+    auto alive = m_alive;
+    auto timeout = Core::Timer::create_single_shot(AK::Duration::from_seconds(30), [this, alive, generation, original_url] {
+        if (!alive->alive || generation != m_fetch_generation)
+            return;
+        cancel_fetch();
+        if (has_client()) {
+            JsonObject err;
+            err.set("url"sv, original_url.serialize());
+            err.set("message"sv, "Filter list request timed out."sv);
+            async_send_message("subscriptionError"sv, move(err));
+        }
+    });
+    m_active_request->set_stop_callback([timeout] { timeout->stop(); });
+    timeout->start();
+
+    auto append_data = [this, alive, generation, original_url](ReadonlyBytes bytes) {
+        if (!alive->alive || generation != m_fetch_generation)
+            return;
+        if (bytes.size() > maximum_filter_list_bytes - m_pending_payload.size()) {
+            cancel_fetch();
+            if (has_client()) {
+                JsonObject err;
+                err.set("url"sv, original_url.serialize());
+                err.set("message"sv, "Filter list exceeds the 64 MiB size limit."sv);
+                async_send_message("subscriptionError"sv, move(err));
+            }
+            return;
+        }
+        if (m_pending_payload.try_append(bytes).is_error()) {
+            cancel_fetch();
+            if (has_client()) {
+                JsonObject err;
+                err.set("url"sv, original_url.serialize());
+                err.set("message"sv, "Out of memory while reading filter list."sv);
+                async_send_message("subscriptionError"sv, move(err));
+            }
+        }
+    };
+
+    m_active_request->set_unbuffered_request_callbacks(
+        [this, alive, generation, original_url, fetch_url, redirect_count](NonnullRefPtr<HTTP::HeaderList> headers, Optional<u32> response_code, Optional<String> const& reason_phrase, Requests::CacheState) {
+            if (!alive->alive || generation != m_fetch_generation)
+                return;
+            m_response_code = response_code;
+            if (response_code.has_value() && Web::Fetch::Infrastructure::is_redirect_status(*response_code)) {
+                auto location = headers->get("Location"sv);
+                auto next_url = location.has_value() ? URL::Parser::basic_parse(*location, fetch_url) : Optional<URL::URL> {};
+                if (next_url.has_value()
+                    && (next_url->scheme() == "https"sv || (next_url->scheme() == "http"sv && fetch_url.scheme() == "http"sv))
+                    && redirect_count < maximum_redirects) {
+                    cancel_fetch();
+                    auto const redirect_generation = m_fetch_generation;
+                    Core::deferred_invoke([this, alive, redirect_generation, original_url, next_url = next_url.release_value(), next_redirect = redirect_count + 1]() mutable {
+                        if (!alive->alive || redirect_generation != m_fetch_generation)
+                            return;
+                        start_fetch(move(original_url), move(next_url), next_redirect);
+                    });
+                    return;
+                }
+            }
+
+            m_response_ok = response_code.has_value() && *response_code >= 200 && *response_code < 300;
+            if (!m_response_ok) {
+                auto reason = reason_phrase.value_or(String {});
+                auto message = reason.is_empty()
+                    ? MUST(String::formatted("Server returned HTTP {}", response_code.value_or(0)))
+                    : MUST(String::formatted("Server returned HTTP {} {}", response_code.value_or(0), reason));
+                cancel_fetch();
+                if (has_client()) {
+                    JsonObject err;
+                    err.set("url"sv, original_url.serialize());
+                    err.set("message"sv, move(message));
+                    async_send_message("subscriptionError"sv, move(err));
+                }
+            }
+        },
+        [append_data](Requests::ResponseData data) {
+            append_data(data.bytes());
+        },
+        [append_data](Core::ImmutableBytes data) {
+            append_data(data.bytes());
+        },
+        [this, alive, generation, timeout, original_url](u64, Requests::RequestTimingInfo const&, Optional<Requests::NetworkError> network_error) {
+            timeout->stop();
+            if (!alive->alive || generation != m_fetch_generation)
+                return;
+            handle_fetch_finished(generation, original_url, network_error);
+        });
+}
+
+void SubscribeUI::handle_fetch_finished(u64 generation, URL::URL const& original_url, Optional<Requests::NetworkError> network_error)
+{
+    if (generation != m_fetch_generation)
+        return;
+
+    if (m_active_request) {
+        auto finished_request = move(m_active_request);
+        Core::deferred_invoke([finished_request = move(finished_request)] { });
+    }
+    if (!has_client())
+        return;
+
+    if (network_error.has_value()) {
+        JsonObject err;
+        err.set("url"sv, original_url.serialize());
+        err.set("message"sv, MUST(String::formatted("Network error: {}", Requests::network_error_to_string(*network_error))));
+        async_send_message("subscriptionError"sv, move(err));
+        return;
+    }
+
+    if (!m_response_ok) {
+        JsonObject err;
+        err.set("url"sv, original_url.serialize());
+        err.set("message"sv, MUST(String::formatted("Server returned HTTP {}", m_response_code.value_or(0))));
+        async_send_message("subscriptionError"sv, move(err));
+        return;
+    }
+
+    StringView candidate_view { m_pending_payload.bytes() };
+    if (looks_like_markup_document(candidate_view)) {
+        m_pending_payload.clear();
+        JsonObject err;
+        err.set("url"sv, original_url.serialize());
+        err.set("message"sv, "This URL returned an HTML/XML page instead of a filter list."sv);
+        async_send_message("subscriptionError"sv, move(err));
+        return;
+    }
+
+    m_loaded_url = original_url;
+    m_loaded_payload = move(m_pending_payload);
+    m_pending_payload.clear();
+
+    StringView full_view { m_loaded_payload.bytes() };
+    auto metadata = analyze_filter_list(full_view);
+
+    // Prefer the filter list's own "! Title:" header over an untrusted link query parameter.
+    String resolved_title;
+    if (metadata.title.has_value() && !metadata.title->bytes_as_string_view().trim_whitespace().is_empty())
+        resolved_title = clamp_title(metadata.title->bytes_as_string_view());
+    else if (!m_requested_title.bytes_as_string_view().trim_whitespace().is_empty())
+        resolved_title = clamp_title(m_requested_title.bytes_as_string_view());
+    else
+        resolved_title = original_url.serialize();
+    m_resolved_title = resolved_title;
+
+    bool truncated = false;
+    StringView preview_view = full_view;
+    if (preview_view.length() > maximum_preview_bytes) {
+        truncated = true;
+        preview_view = preview_view.substring_view(0, maximum_preview_bytes);
+        if (auto last_newline = preview_view.find_last('\n'); last_newline.has_value())
+            preview_view = preview_view.substring_view(0, *last_newline);
+    }
+
+    auto preview_string = String::from_utf8_with_replacement_character(preview_view);
+
+    JsonObject metadata_json;
+    if (metadata.homepage.has_value())
+        metadata_json.set("homepage"sv, *metadata.homepage);
+    if (metadata.last_modified.has_value())
+        metadata_json.set("lastModified"sv, *metadata.last_modified);
+    if (metadata.version.has_value())
+        metadata_json.set("version"sv, *metadata.version);
+    if (metadata.expires.has_value())
+        metadata_json.set("expires"sv, *metadata.expires);
+    if (metadata.description.has_value())
+        metadata_json.set("description"sv, *metadata.description);
+
+    JsonObject response;
+    response.set("url"sv, original_url.serialize());
+    response.set("resolvedTitle"sv, move(resolved_title));
+    response.set("lineCount"sv, static_cast<u64>(metadata.line_count));
+    response.set("ruleCount"sv, static_cast<u64>(metadata.rule_count));
+    response.set("metadata"sv, move(metadata_json));
+    response.set("content"sv, move(preview_string));
+    response.set("truncated"sv, truncated);
+    populate_subscription_fields(response, find_list_for_url(original_url));
+
+    async_send_message("subscriptionLoaded"sv, move(response));
+}
+
+void SubscribeUI::subscribe(JsonValue const& data)
+{
+    if (!data.is_object() || !has_client())
+        return;
+
+    auto raw_url = data.as_object().get_string("url"sv);
+    if (!raw_url.has_value())
+        return;
+
+    auto parsed_url = URL::Parser::basic_parse(*raw_url);
+    if (!parsed_url.has_value() || !parsed_url->scheme().is_one_of("http"sv, "https"sv)) {
+        JsonObject reply;
+        reply.set("error"sv, "Filter list URL must use HTTP or HTTPS."sv);
+        async_send_message("subscriptionUpdated"sv, move(reply));
+        return;
+    }
+
+    if (m_loaded_url != parsed_url) {
+        JsonObject reply;
+        populate_subscription_fields(reply, find_list_for_url(*parsed_url));
+        reply.set("error"sv, "Wait for the filter list to finish loading before subscribing."sv);
+        async_send_message("subscriptionUpdated"sv, move(reply));
+        return;
+    }
+
+    auto requested_title = data.as_object().get_string("title"sv).copy().value_or(String {});
+    String name;
+    if (!m_resolved_title.is_empty())
+        name = m_resolved_title;
+    else if (!requested_title.bytes_as_string_view().trim_whitespace().is_empty())
+        name = clamp_title(requested_title.bytes_as_string_view());
+    else
+        name = parsed_url->serialize();
+
+    Optional<ReadonlyBytes> preloaded;
+    if (!m_loaded_payload.is_empty())
+        preloaded = m_loaded_payload.bytes();
+
+    auto result = Application::the().add_content_blocker_subscription({}, move(name), *parsed_url, preloaded);
+
+    JsonObject reply;
+    populate_subscription_fields(reply, find_list_for_url(*parsed_url));
+    if (result.is_error()) {
+        reply.set("error"sv, MUST(String::formatted("Unable to subscribe: {}", result.error())));
+    } else if (Application::settings().content_blocker_enabled()) {
+        reply.set("message"sv, "Subscribed and activated in Hellbird Shield."sv);
+    } else {
+        reply.set("message"sv, "Subscribed (enable Hellbird Shield to activate)."sv);
+    }
+    async_send_message("subscriptionUpdated"sv, move(reply));
+}
+
+void SubscribeUI::unsubscribe(JsonValue const& data)
+{
+    if (!data.is_object() || !has_client())
+        return;
+
+    auto identifier = data.as_object().get_string("identifier"sv);
+    if (!identifier.has_value() || identifier->is_empty())
+        return;
+
+    auto existing = Application::settings().content_blocker_list(*identifier);
+    bool const was_built_in = existing.has_value() && existing->built_in;
+    if (existing.has_value()) {
+        if (was_built_in)
+            Application::settings().set_content_blocker_list_enabled(*identifier, false);
+        else
+            Application::the().remove_content_blocker_list({}, *identifier);
+    }
+
+    JsonObject reply;
+    if (m_requested_url.has_value())
+        populate_subscription_fields(reply, find_list_for_url(*m_requested_url));
+    else
+        populate_subscription_fields(reply, {});
+    reply.set("message"sv, was_built_in ? "Filter list disabled."sv : "Unsubscribed from filter list."sv);
+    async_send_message("subscriptionUpdated"sv, move(reply));
+}
+
+}
