+static ByteString decode_query_component(StringView raw)
+{
+    StringBuilder replaced;
+    for (auto ch : raw)
+        replaced.append(ch == '+' ? ' ' : ch);
+    return URL::percent_decode(replaced.string_view());
+}
+
+Optional<URL::URL> filter_list_subscription_about_url(URL::URL const& url)
+{
+    bool is_subscription_link = false;
+    auto host = url.host().has_value() ? url.serialized_host() : StringView {};
+    if (url.scheme().is_one_of("abp"sv, "ubo"sv, "adguard"sv)) {
+        auto path = url.serialize_path().trim("/"sv);
+        is_subscription_link = path.equals_ignoring_ascii_case("subscribe"sv)
+            || host.equals_ignoring_ascii_case("subscribe"sv);
+    } else if (url.scheme().is_one_of("http"sv, "https"sv)) {
+        is_subscription_link = host.equals_ignoring_ascii_case("subscribe.adblockplus.org"sv);
+    }
+
+    if (!is_subscription_link)
+        return {};
+
+    auto query = url.query();
+    if (!query.has_value() || query->is_empty())
+        return {};
+
+    Optional<ByteString> location;
+    Optional<ByteString> title;
+    query->for_each_split_view('&', SplitBehavior::Nothing, [&](StringView pair) {
+        auto equals = pair.find('=');
+        if (!equals.has_value())
+            return;
+        auto key = decode_query_component(pair.substring_view(0, *equals));
+        auto value = decode_query_component(pair.substring_view(*equals + 1));
+        if (key.equals_ignoring_ascii_case("location"sv) && !location.has_value())
+            location = move(value);
+        else if (key.equals_ignoring_ascii_case("title"sv) && !title.has_value())
+            title = move(value);
+    });
+
+    if (!location.has_value() || location->is_empty())
+        return {};
+
+    auto parsed_location = URL::Parser::basic_parse(*location);
+    if (!parsed_location.has_value() || !parsed_location->scheme().is_one_of("http"sv, "https"sv))
+        return {};
+
+    StringBuilder about_url;
+    about_url.append("about:subscribe?location="sv);
+    about_url.append(URL::percent_encode(parsed_location->serialize(), URL::PercentEncodeSet::Component));
+    if (title.has_value()) {
+        auto trimmed_title = title->view().trim_whitespace();
+        if (!trimmed_title.is_empty()) {
+            about_url.append("&title="sv);
+            about_url.append(URL::percent_encode(trimmed_title, URL::PercentEncodeSet::Component));
+        }
+    }
+
+    return URL::Parser::basic_parse(about_url.string_view());
+}
