+                errorPanel.classList.add("hidden");
+                codeLinesEl.classList.add("hidden");
+                loadMoreBar.classList.add("hidden");
+            }
+
+            function addMetaPill(text) {
+                const pill = document.createElement("span");
+                pill.className = "meta-pill";
+                pill.textContent = text;
+                metaEl.append(pill);
+            }
+
+            function updateSubscriptionButtons() {
+                const active = currentSubscribed && currentEnabled;
+                if (!currentUrl) {
+                    subscribeBtn.disabled = true;
+                    subscribeBtn.textContent = "Subscribe";
+                    subscribeBtn.classList.remove("subscribed");
+                    unsubscribeBtn.classList.add("hidden");
+                    return;
+                }
+
+                if (active) {
+                    subscribeBtn.textContent = "Subscribed \u2713";
+                    subscribeBtn.classList.add("subscribed");
+                    subscribeBtn.disabled = true;
+                    unsubscribeBtn.textContent = currentBuiltIn ? "Disable" : "Unsubscribe";
+                    unsubscribeBtn.classList.remove("hidden");
+                } else {
+                    subscribeBtn.textContent = currentSubscribed ? "Enable list" : "Subscribe";
+                    subscribeBtn.classList.remove("subscribed");
+                    subscribeBtn.disabled = !hasLoadedList;
+                    unsubscribeBtn.classList.add("hidden");
+                }
+            }
+
+            function appendHighlightedText(parent, text, query, isCurrentLine) {
+                if (!query) {
+                    parent.append(document.createTextNode(text));
+                    return;
+                }
+                const lower = text.toLowerCase();
+                const q = query.toLowerCase();
+                let pos = 0;
+                let idx = lower.indexOf(q, pos);
+                while (idx !== -1) {
+                    if (idx > pos) parent.append(document.createTextNode(text.slice(pos, idx)));
+                    const mark = document.createElement("mark");
+                    mark.className = isCurrentLine ? "hit current" : "hit";
+                    mark.textContent = text.slice(idx, idx + query.length);
+                    parent.append(mark);
+                    pos = idx + query.length;
+                    idx = lower.indexOf(q, pos);
+                }
+                if (pos < text.length) parent.append(document.createTextNode(text.slice(pos)));
+            }
+
+            function buildLineRow(lineIndex, lineText, query, isCurrentMatch) {
+                const row = document.createElement("div");
+                row.className = isCurrentMatch ? "code-row match-current" : "code-row";
+                row.dataset.line = String(lineIndex);
+
+                const num = document.createElement("span");
+                num.className = "line-num";
+                num.textContent = String(lineIndex + 1);
+
+                const content = document.createElement("span");
+                content.className = "line-text";
+
+                const trimmed = lineText.trimStart();
+                if (trimmed.startsWith("!#") || trimmed.startsWith("!---") || trimmed.startsWith("! ===")) {
+                    const span = document.createElement("span");
+                    span.className = "tok-section";
+                    appendHighlightedText(span, lineText, query, isCurrentMatch);
+                    content.append(span);
+                } else if (trimmed.startsWith("!") || trimmed.startsWith("[Adblock")) {
+                    const span = document.createElement("span");
+                    span.className = "tok-comment";
+                    appendHighlightedText(span, lineText, query, isCurrentMatch);
+                    content.append(span);
+                } else if (trimmed.startsWith("@@")) {
+                    const span = document.createElement("span");
+                    span.className = "tok-exception";
+                    appendHighlightedText(span, lineText, query, isCurrentMatch);
+                    content.append(span);
+                } else if (
+                    lineText.includes("##") ||
+                    lineText.includes("#@#") ||
+                    lineText.includes("#?#") ||
+                    lineText.includes("#$#")
+                ) {
+                    const span = document.createElement("span");
+                    span.className = "tok-cosmetic";
+                    appendHighlightedText(span, lineText, query, isCurrentMatch);
+                    content.append(span);
+                } else {
+                    const dollarIdx = lineText.lastIndexOf("$");
+                    if (dollarIdx > 0 && !lineText.includes(" ")) {
+                        const base = lineText.slice(0, dollarIdx);
+                        const opts = lineText.slice(dollarIdx);
+                        appendHighlightedText(content, base, query, isCurrentMatch);
+                        const optSpan = document.createElement("span");
+                        optSpan.className = "tok-option";
+                        appendHighlightedText(optSpan, opts, query, isCurrentMatch);
+                        content.append(optSpan);
+                    } else {
+                        appendHighlightedText(content, lineText, query, isCurrentMatch);
+                    }
+                }
+
+                row.append(num, content);
+                return row;
+            }
+
+            function updateLoadMoreBar() {
+                if (renderedCount < allLines.length) {
+                    loadMoreText.textContent = `Showing ${renderedCount.toLocaleString()} of ${allLines.length.toLocaleString()} lines`;
+                    loadMoreBar.classList.remove("hidden");
+                } else {
+                    loadMoreBar.classList.add("hidden");
+                }
+            }
+
+            function renderUpTo(targetCount) {
+                const clamped = Math.min(targetCount, allLines.length);
+                const fragment = document.createDocumentFragment();
+                const currentMatchLine =
+                    currentMatchCursor >= 0 ? matchingLineIndices[currentMatchCursor] : -1;
+                for (let i = renderedCount; i < clamped; i++) {
+                    fragment.append(buildLineRow(i, allLines[i], currentQuery, i === currentMatchLine));
+                }
+                codeLinesEl.append(fragment);
+                renderedCount = clamped;
+                updateLoadMoreBar();
+            }
+
+            function rerenderLines(limit = Math.max(renderedCount, INITIAL_RENDER_CHUNK)) {
+                codeLinesEl.replaceChildren();
+                renderedCount = 0;
+                renderUpTo(limit);
+            }
+
+            function runSearch() {
+                currentQuery = searchInput.value;
+                matchingLineIndices = [];
+                currentMatchCursor = -1;
+
+                if (currentQuery.length > 0) {
+                    const q = currentQuery.toLowerCase();
+                    for (let i = 0; i < allLines.length; i++) {
+                        if (allLines[i].toLowerCase().includes(q)) {
+                            matchingLineIndices.push(i);
+                        }
+                    }
+                    if (matchingLineIndices.length > 0) {
+                        currentMatchCursor = 0;
+                    }
+                }
+
+                updateSearchUI();
+                const targetLimit =
+                    currentMatchCursor >= 0
+                        ? Math.max(renderedCount, matchingLineIndices[currentMatchCursor] + 50)
+                        : Math.max(renderedCount, INITIAL_RENDER_CHUNK);
+                rerenderLines(targetLimit);
+                scrollToCurrentMatch();
+            }
+
+            function updateSearchUI() {
+                const count = matchingLineIndices.length;
+                prevMatchBtn.disabled = count === 0;
+                nextMatchBtn.disabled = count === 0;
+                if (!currentQuery) {
+                    searchCountEl.textContent = "";
+                } else if (count === 0) {
+                    searchCountEl.textContent = "0 / 0";
+                } else {
+                    searchCountEl.textContent = `${currentMatchCursor + 1} / ${count}`;
+                }
+            }
+
+            function scrollToCurrentMatch() {
+                if (currentMatchCursor < 0 || currentMatchCursor >= matchingLineIndices.length) return;
+                const lineIndex = matchingLineIndices[currentMatchCursor];
+                if (lineIndex >= renderedCount) {
+                    renderUpTo(lineIndex + 100);
+                }
+                const row = codeLinesEl.querySelector(`.code-row[data-line="${lineIndex}"]`);
+                if (row) {
+                    row.scrollIntoView({ block: "center" });
+                }
+            }
+
+            function stepMatch(delta) {
+                if (matchingLineIndices.length === 0) return;
+                const prevLine = matchingLineIndices[currentMatchCursor];
+                currentMatchCursor =
+                    (currentMatchCursor + delta + matchingLineIndices.length) % matchingLineIndices.length;
+                const nextLine = matchingLineIndices[currentMatchCursor];
+                updateSearchUI();
+
+                if (nextLine >= renderedCount) {
+                    renderUpTo(nextLine + 100);
+                }
+                const prevRow = codeLinesEl.querySelector(`.code-row[data-line="${prevLine}"]`);
+                if (prevRow) {
+                    prevRow.replaceWith(buildLineRow(prevLine, allLines[prevLine], currentQuery, false));
+                }
+                const nextRow = codeLinesEl.querySelector(`.code-row[data-line="${nextLine}"]`);
+                if (nextRow) {
+                    const replacement = buildLineRow(nextLine, allLines[nextLine], currentQuery, true);
+                    nextRow.replaceWith(replacement);
+                    replacement.scrollIntoView({ block: "center" });
+                }
+            }
+
+            function requestLoad(url, title) {
+                const safeUrl = parseSafeHttpUrl(url);
+                hasLoadedList = false;
+                currentIdentifier = null;
+                currentBuiltIn = false;
+                currentSubscribed = false;
+                currentEnabled = false;
+                allLines = [];
+                renderedCount = 0;
+                matchingLineIndices = [];
+                currentMatchCursor = -1;
+                currentQuery = "";
+                searchInput.value = "";
+                updateSearchUI();
+                metaEl.replaceChildren();
+                toolbar.classList.add("hidden");
+                setStatus("");
+
+                if (!safeUrl) {
+                    currentUrl = "";
+                    currentTitle = "";
+                    titleEl.textContent = "Filter List Subscription";
+                    document.title = "Hellbird Shield — Filter List Preview";
+                    urlEl.removeAttribute("href");
+                    urlEl.textContent = "";
+                    urlEl.classList.add("hidden");
+                    hideAllPanels();
+                    errorMessageEl.textContent = "Filter list URLs must use HTTP or HTTPS.";
+                    errorPanel.classList.remove("hidden");
+                    updateSubscriptionButtons();
+                    return;
+                }
+
+                currentUrl = safeUrl;
+                currentTitle = title || "";
+
+                titleEl.textContent = currentTitle || "Loading filter list…";
+                document.title = currentTitle
+                    ? `Hellbird Shield — ${currentTitle}`
+                    : "Hellbird Shield — Filter List Preview";
+                urlEl.textContent = currentUrl;
+                urlEl.href = currentUrl;
+                urlEl.classList.remove("hidden");
+                hideAllPanels();
+                loadingUrlEl.textContent = currentUrl;
+                loadingPanel.classList.remove("hidden");
+                updateSubscriptionButtons();
+
+                if (isConnected) {
+                    ladybird.sendMessage("loadSubscription", { url: currentUrl, title: currentTitle });
+                }
+            }
+
+            function initFromLocation() {
+                const params = new URLSearchParams(location.search);
+                const loc = (params.get("location") || params.get("url") || "").trim();
+                const title = (params.get("title") || "").trim();
+                if (!loc) {
+                    hideAllPanels();
+                    manualPanel.classList.remove("hidden");
+                    updateSubscriptionButtons();
+                    return;
+                }
+                requestLoad(loc, title);
+            }
+
+            manualForm.addEventListener("submit", event => {
+                event.preventDefault();
+                const url = manualUrlInput.value.trim();
+                if (!url) return;
+                const next = `about:subscribe?location=${encodeURIComponent(url)}`;
+                location.assign(next);
+            });
+
+            retryBtn.addEventListener("click", () => {
+                if (currentUrl) requestLoad(currentUrl, currentTitle);
+            });
+
+            subscribeBtn.addEventListener("click", () => {
+                if (!isConnected || !currentUrl) return;
+                subscribeBtn.disabled = true;
+                setStatus("Subscribing…");
+                ladybird.sendMessage("subscribe", { url: currentUrl, title: currentTitle });
+            });
+
+            unsubscribeBtn.addEventListener("click", () => {
+                if (!isConnected || !currentIdentifier) return;
+                unsubscribeBtn.disabled = true;
+                ladybird.sendMessage("unsubscribe", { identifier: currentIdentifier });
+            });
+
+            copyUrlBtn.addEventListener("click", async () => {
+                if (!currentUrl) return;
+                try {
+                    await navigator.clipboard.writeText(currentUrl);
+                    setStatus("URL copied", "ok");
+                } catch {
+                    setStatus("Copy failed", "err");
+                }
+            });
+
+            let searchTimer = null;
+            searchInput.addEventListener("input", () => {
+                clearTimeout(searchTimer);
+                searchTimer = setTimeout(runSearch, 120);
+            });
+
+            searchInput.addEventListener("keydown", event => {
+                if (event.key === "Enter") {
+                    event.preventDefault();
+                    if (searchInput.value !== currentQuery) {
+                        clearTimeout(searchTimer);
+                        runSearch();
+                    } else {
+                        stepMatch(event.shiftKey ? -1 : 1);
+                    }
+                } else if (event.key === "Escape") {
+                    clearTimeout(searchTimer);
+                    searchInput.value = "";
+                    runSearch();
+                    searchInput.blur();
+                }
+            });
+
+            prevMatchBtn.addEventListener("click", () => stepMatch(-1));
+            nextMatchBtn.addEventListener("click", () => stepMatch(1));
+            loadMoreBtn.addEventListener("click", () => renderUpTo(renderedCount + RENDER_STEP));
+            loadAllBtn.addEventListener("click", () => renderUpTo(allLines.length));
+
+            document.addEventListener("keydown", event => {
+                if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "f" && !toolbar.classList.contains("hidden")) {
+                    event.preventDefault();
+                    searchInput.focus();
+                    searchInput.select();
+                }
+            });
+
+            document.addEventListener("WebUILoaded", () => {
+                isConnected = true;
+                if (currentUrl) {
+                    ladybird.sendMessage("loadSubscription", { url: currentUrl, title: currentTitle });
+                }
+            });
+
+            document.addEventListener("WebUIMessage", event => {
+                const { name, data } = event.detail;
+                if (name === "subscriptionState") {
+                    currentIdentifier = data.identifier ?? null;
+                    currentBuiltIn = !!data.builtIn;
+                    currentSubscribed = !!data.subscribed;
+                    currentEnabled = !!data.enabled;
+                    currentGlobalEnabled = data.globalEnabled !== false;
+                    unsubscribeBtn.disabled = false;
+                    updateSubscriptionButtons();
+                    if (hasLoadedList) {
+                        if (currentSubscribed && currentEnabled) {
+                            setStatus(
+                                currentGlobalEnabled
+                                    ? "Active in Hellbird Shield"
+                                    : "Subscribed (Hellbird Shield is turned off)",
+                                currentGlobalEnabled ? "ok" : ""
+                            );
+                        } else {
+                            setStatus("");
+                        }
+                    }
+                } else if (name === "subscriptionLoaded") {
+                    hasLoadedList = true;
+                    currentTitle = data.resolvedTitle || currentTitle || data.url;
+                    currentIdentifier = data.identifier ?? null;
+                    currentBuiltIn = !!data.builtIn;
+                    currentSubscribed = !!data.subscribed;
+                    currentEnabled = !!data.enabled;
+                    currentGlobalEnabled = data.globalEnabled !== false;
+
+                    titleEl.textContent = currentTitle;
+                    document.title = `Hellbird Shield — ${currentTitle}`;
+
+                    metaEl.replaceChildren();
+                    if (typeof data.ruleCount === "number") {
+                        addMetaPill(`${data.ruleCount.toLocaleString()} rules`);
+                    }
+                    if (typeof data.lineCount === "number") {
+                        addMetaPill(`${data.lineCount.toLocaleString()} lines`);
+                    }
+                    if (data.metadata?.version) {
+                        addMetaPill(`v${data.metadata.version}`);
+                    }
+                    if (data.metadata?.lastModified) {
+                        addMetaPill(`Updated: ${data.metadata.lastModified}`);
+                    }
+                    if (data.truncated) {
+                        addMetaPill("Preview truncated (full list saved on subscribe)");
+                    }
+
+                    const raw = data.content || "";
+                    allLines = raw.length > 0 ? raw.replace(/\r\n/g, "\n").split("\n") : [];
+                    hideAllPanels();
+                    toolbar.classList.remove("hidden");
+                    codeLinesEl.classList.remove("hidden");
+                    rerenderLines(INITIAL_RENDER_CHUNK);
+                    updateSubscriptionButtons();
+                    if (currentSubscribed && currentEnabled) {
+                        setStatus(
+                            currentGlobalEnabled
+                                ? "Active in Hellbird Shield"
+                                : "Subscribed (Hellbird Shield is turned off)",
+                            currentGlobalEnabled ? "ok" : ""
+                        );
+                    }
+                } else if (name === "subscriptionError") {
+                    hasLoadedList = false;
+                    hideAllPanels();
+                    errorMessageEl.textContent = data.message || "Failed to fetch filter list.";
+                    errorPanel.classList.remove("hidden");
+                    updateSubscriptionButtons();
+                } else if (name === "subscriptionUpdated") {
+                    currentIdentifier = data.identifier ?? null;
+                    currentBuiltIn = !!data.builtIn;
+                    currentSubscribed = !!data.subscribed;
+                    currentEnabled = !!data.enabled;
+                    currentGlobalEnabled = data.globalEnabled !== false;
+                    unsubscribeBtn.disabled = false;
+                    updateSubscriptionButtons();
+                    if (data.error) {
+                        setStatus(data.error, "err");
+                    } else if (data.message) {
+                        setStatus(data.message, "ok");
+                    }
+                }
+            });
+
+            initFromLocation();
+        </script>
+    </body>
+</html>
