+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/NonnullRefPtr.h>
+#include <AK/Optional.h>
+#include <AK/RefCounted.h>
+#include <AK/RefPtr.h>
+#include <AK/String.h>
+#include <LibRequests/Request.h>
+#include <LibURL/URL.h>
+#include <LibWebView/Settings.h>
+#include <LibWebView/WebUI.h>
+
+namespace WebView {
+
+// about:subscribe, a uBlock Origin-style filter list preview and one-click subscription page.
+class SubscribeUI final
+    : public WebUI
+    , public SettingsObserver {
+    WEB_UI(SubscribeUI);
+
+public:
+    virtual ~SubscribeUI() override;
+
+private:
+    struct AliveFlag final : public RefCounted<AliveFlag> {
+        bool alive { true };
+    };
+
+    virtual void register_interfaces() override;
+    virtual void content_blocker_settings_changed() override;
+
+    void load_subscription(JsonValue const&);
+    void subscribe(JsonValue const&);
+    void unsubscribe(JsonValue const&);
+
+    void start_fetch(URL::URL original_url, URL::URL fetch_url, size_t redirect_count = 0);
+    void cancel_fetch();
+    void send_subscription_state();
+    void handle_fetch_finished(u64 generation, URL::URL const& original_url, Optional<Requests::NetworkError> network_error);
+
+    NonnullRefPtr<AliveFlag> m_alive { adopt_ref(*new AliveFlag) };
+
+    Optional<URL::URL> m_requested_url;
+    String m_requested_title;
+    Optional<URL::URL> m_loaded_url;
+    String m_resolved_title;
+    ByteBuffer m_loaded_payload;
+
+    RefPtr<Requests::Request> m_active_request;
+    ByteBuffer m_pending_payload;
+    u64 m_fetch_generation { 0 };
+    bool m_response_ok { false };
+    Optional<u32> m_response_code;
+};
+
+}
