+void ContentBlocker::start_pending_build_locked() const
+{
+    if (!m_pending_rules_buffer.is_valid() || m_pending_rules_buffer.size() == 0)
+        return;
+
+    auto rules_buffer = move(m_pending_rules_buffer);
+    auto event_loop = move(m_pending_origin_event_loop);
+    auto generation = m_build_generation;
+    m_state.store(State::Building, AK::MemoryOrder::memory_order_release);
+
+    Threading::ThreadPool::the().submit([this, rules_buffer = move(rules_buffer), generation, event_loop = move(event_loop)]() mutable {
+        GC::forbid_heap_access_on_this_thread();
+
+        auto rules_bytes = rules_buffer.bytes();
+        auto* engine = ContentBlocking::FFI::rust_content_blocker_create(rules_bytes);
+        auto has_cosmetic_rules = engine ? rules_contain_cosmetic_rules(rules_bytes) : false;
+
+        bool cosmetic_rules_changed = false;
+        {
+            MutexLocker locker(m_mutex);
+            if (m_build_generation != generation) {
+                ContentBlocking::FFI::rust_content_blocker_free(engine);
+                return;
+            }
+
+            auto had_cosmetic_rules = m_has_cosmetic_rules.load(AK::MemoryOrder::memory_order_relaxed);
+            if (engine) {
+                ContentBlocking::FFI::rust_content_blocker_free(m_engine.exchange(engine));
+                m_has_cosmetic_rules.store(has_cosmetic_rules, AK::MemoryOrder::memory_order_release);
+                m_state.store(State::Ready, AK::MemoryOrder::memory_order_release);
+                cosmetic_rules_changed = had_cosmetic_rules || has_cosmetic_rules;
+            } else {
+                dbgln("Failed to create content blocker");
+                bool has_existing_engine = m_engine.load(AK::MemoryOrder::memory_order_relaxed) != nullptr;
+                m_has_cosmetic_rules.store(has_existing_engine && had_cosmetic_rules, AK::MemoryOrder::memory_order_release);
+                m_state.store(has_existing_engine ? State::Ready : State::Empty, AK::MemoryOrder::memory_order_release);
+            }
+            m_build_condition.broadcast();
+        }
+
+        if (!event_loop)
+            return;
+
+        auto origin_event_loop = event_loop->take();
+        if (!origin_event_loop.is_alive())
+            return;
+
+        origin_event_loop->deferred_invoke([this, generation, cosmetic_rules_changed]() {
+            if (m_main_thread_on_complete_generation != generation)
+                return;
+            auto on_complete = move(m_main_thread_on_complete);
+            if (on_complete)
+                on_complete(cosmetic_rules_changed);
+        });
+    });
+}
+
+void ContentBlocker::ensure_engine_built_locked() const
+{
+    m_has_seen_filterable_url.store(true, AK::MemoryOrder::memory_order_release);
+    if (m_state.load(AK::MemoryOrder::memory_order_relaxed) == State::Pending)
+        start_pending_build_locked();
+    wait_for_pending_build_locked();
+}
+
+void ContentBlocker::warm_up_for_url(URL::URL const& url) const
+{
+    if (is_internal_unfiltered_scheme(url.scheme()))
+        return;
+
+    m_has_seen_filterable_url.store(true, AK::MemoryOrder::memory_order_release);
+    if (m_state.load(AK::MemoryOrder::memory_order_acquire) != State::Pending)
+        return;
+
+    MutexLocker locker(m_mutex);
+    if (m_state.load(AK::MemoryOrder::memory_order_relaxed) == State::Pending)
+        start_pending_build_locked();
+}
