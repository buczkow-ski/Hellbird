new file mode 100644
index 0000000000..b9cf42462b
--- /dev/null
+++ b/UI/Qt/CustomFilters.cpp
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2026-present, the Hellbird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/String.h>
+#include <AK/StringBuilder.h>
+#include <UI/Qt/CustomFilters.h>
+
+namespace Ladybird {
+
+// NB: The settings page, which edits the same filters, takes no more than this either.
+static constexpr size_t MAX_CUSTOM_FILTERS_SIZE = 4 * MiB;
+
+AddCustomFilterResult add_custom_filter(WebView::Settings& settings, StringView filter)
+{
+    filter = filter.trim_whitespace();
+    if (filter.is_empty())
+        return AddCustomFilterResult::Empty;
+
+    auto const& filters = settings.custom_content_blocker_filters();
+    for (auto line : filters.bytes_as_string_view().split_view('\n')) {
+        if (line.trim_whitespace() == filter)
+            return AddCustomFilterResult::AlreadyExists;
+    }
+
+    StringBuilder builder;
+    builder.append(filters);
+    if (!filters.is_empty() && !filters.bytes_as_string_view().ends_with('\n'))
+        builder.append('\n');
+    builder.append(filter);
+    if (builder.length() > MAX_CUSTOM_FILTERS_SIZE)
+        return AddCustomFilterResult::TooLarge;
+
+    settings.set_custom_content_blocker_filters(MUST(builder.to_string()));
+    return AddCustomFilterResult::Added;
+}
+
+}
