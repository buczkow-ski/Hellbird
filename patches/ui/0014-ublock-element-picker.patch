+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/HashTable.h>
+#include <AK/StringBuilder.h>
+#include <LibGC/RootVector.h>
+#include <LibURL/Host.h>
+#include <LibWeb/CSS/CSSStyleProperties.h>
+#include <LibWeb/CSS/Serialize.h>
+#include <LibWeb/DOM/Attr.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/DOM/Element.h>
+#include <LibWeb/DOM/NodeList.h>
+#include <LibWeb/DOM/SelectorQuery.h>
+#include <LibWeb/DOM/ShadowRoot.h>
+#include <LibWeb/HTML/AttributeNames.h>
+#include <LibWeb/HTML/HTMLImageElement.h>
+#include <LibWeb/HTML/HTMLMediaElement.h>
+#include <LibWeb/HTML/LocalNavigable.h>
+#include <LibWeb/HTML/NavigableContainer.h>
+#include <LibWeb/HTML/TagNames.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Loader/ContentBlocker.h>
+#include <LibWeb/Namespace.h>
+#include <LibWeb/Page/Page.h>
+#include <LibWeb/SVG/TagNames.h>
+
+namespace Web {
+
+static constexpr size_t MAX_LEVELS = 64;
+static constexpr size_t MAX_CLASSES_IN_SELECTOR = 8;
+static constexpr size_t MAX_ATTRIBUTE_SELECTORS = 5;
+static constexpr size_t MAX_ATTRIBUTE_VALUE_LENGTH = 256;
+static constexpr size_t MAX_QUERY_LENGTH_IN_FILTER = 256;
+
+// The filters apply to the top-level document, where an element of a shadow tree is hidden with the host of the tree,
+// and what is in a frame with the frame. A page without its body is blank, so neither the body nor the root is picked.
+static GC::Ptr<DOM::Element> pickable_element(DOM::Document& document, GC::Ptr<DOM::Node> node)
+{
+    while (node) {
+        if (&node->document() != &document) {
+            auto navigable = node->document().navigable();
+            node = navigable ? GC::Ptr<DOM::Node> { navigable->container() } : nullptr;
+            continue;
+        }
+        auto* shadow_root = as_if<DOM::ShadowRoot>(node->root());
+        if (!shadow_root)
+            break;
+        node = shadow_root->host();
+    }
+
+    while (node && !is<DOM::Element>(*node))
+        node = node->parent();
+    if (!node || !node->is_connected())
+        return {};
+
+    auto& element = as<DOM::Element>(*node);
+    if (&element == document.document_element() || &element == document.body())
+        return {};
+    return element;
+}
+
+static String utf8(Utf16View string)
+{
+    return Utf16String::from_utf16(string).to_well_formed_utf8();
+}
+
+static String identifier(Utf16View string)
+{
+    return CSS::serialize_an_identifier(string);
+}
+
+static String tag_selector(DOM::Element const& element)
+{
+    return identifier(element.local_name().view());
+}
+
+static Optional<String> id_selector(DOM::Element const& element)
+{
+    auto const& id = element.id();
+    if (!id.has_value() || id->is_empty())
+        return {};
+    return MUST(String::formatted("#{}", identifier(id->view())));
+}
+
+static Vector<String> class_selectors(DOM::Element const& element)
+{
+    Vector<String> selectors;
+    for (auto const& class_name : element.class_names()) {
+        if (class_name.is_empty())
+            continue;
+        auto selector = MUST(String::formatted(".{}", identifier(class_name.view())));
+        if (!selectors.contains_slow(selector))
+            selectors.append(move(selector));
+        if (selectors.size() == MAX_CLASSES_IN_SELECTOR)
+            break;
+    }
+    return selectors;
+}
+
+static String joined(ReadonlySpan<String> strings)
+{
+    StringBuilder builder;
+    for (auto const& string : strings)
+        builder.append(string);
+    return MUST(builder.to_string());
+}
+
+static bool attribute_tells_element_apart(StringView name)
+{
+    return name.is_one_of("src"sv, "href"sv, "data"sv, "poster"sv, "alt"sv, "title"sv, "name"sv, "role"sv, "type"sv, "aria-label"sv, "target"sv)
+        || name.starts_with("data-"sv);
+}
+
+static Vector<String> attribute_selectors(DOM::Element const& element)
+{
+    Vector<String> selectors;
+    element.for_each_attribute([&](DOM::Attr const& attribute) {
+        if (selectors.size() == MAX_ATTRIBUTE_SELECTORS)
+            return;
+        auto name = utf8(attribute.name().view());
+        if (!attribute_tells_element_apart(name))
+            return;
+
+        auto full_value = attribute.value().to_well_formed_utf8();
+        auto value = full_value.bytes_as_string_view();
+        auto is_url = name.bytes_as_string_view().is_one_of("src"sv, "href"sv, "data"sv, "poster"sv);
+        if (is_url && (value.starts_with("data:"sv) || value.starts_with("blob:"sv) || value.starts_with("javascript:"sv)))
+            return;
+
+        // What follows the path of a URL tends to change from one load of the page to the next.
+        if (is_url) {
+            if (auto end_of_path = value.find_any_of("?#"sv); end_of_path.has_value())
+                value = value.substring_view(0, *end_of_path);
+        }
+        auto is_prefix = value.length() < full_value.bytes().size();
+        if ((is_url && value.is_empty()) || value.length() > MAX_ATTRIBUTE_VALUE_LENGTH)
+            return;
+
+        StringBuilder builder;
+        builder.append('[');
+        builder.append(identifier(attribute.name().view()));
+        if (!value.is_empty()) {
+            builder.append(is_prefix ? "^="sv : "="sv);
+            auto utf16_value = Utf16String::from_utf8(value);
+            CSS::serialize_a_string(builder, utf16_value);
+        }
+        builder.append(']');
+        selectors.append(MUST(builder.to_string()));
+    });
+    return selectors;
+}
+
+static String nth_of_type_selector(DOM::Element const& element)
+{
+    size_t index = 1;
+    for (auto const* sibling = element.previous_element_sibling(); sibling; sibling = sibling->previous_element_sibling()) {
+        if (sibling->local_name() == element.local_name() && sibling->namespace_uri() == element.namespace_uri())
+            ++index;
+    }
+    return MUST(String::formatted("{}:nth-of-type({})", tag_selector(element), index));
+}
+
+// The shortest selector that says much about the element, for its children to be scoped by.
+static String scoping_selector(DOM::Element const& element)
+{
+    if (auto id = id_selector(element); id.has_value())
+        return id.release_value();
+    if (auto classes = class_selectors(element); !classes.is_empty())
+        return joined(classes);
+    return tag_selector(element);
+}
+
+// The way down to the element from the closest ancestor with an ID, or from the body.
+static String path_selector(DOM::Element const& element)
+{
+    Vector<String> steps { nth_of_type_selector(element) };
+    for (auto ancestor = element.parent_element(); ancestor; ancestor = ancestor->parent_element()) {
+        if (auto id = id_selector(*ancestor); id.has_value()) {
+            steps.append(id.release_value());
+            break;
+        }
+        if (ancestor.ptr() == element.document().body()) {
+            steps.append(tag_selector(*ancestor));
+            break;
+        }
+        steps.append(nth_of_type_selector(*ancestor));
+    }
+
+    StringBuilder builder;
+    for (size_t i = steps.size(); i > 0; --i) {
+        builder.append(steps[i - 1]);
+        if (i > 1)
+            builder.append(" > "sv);
+    }
+    return MUST(builder.to_string());
+}
+
+static ElementPickerLevel describe_level(DOM::Element const& element)
+{
+    ElementPickerLevel level;
+
+    auto tag = tag_selector(element);
+    auto id = id_selector(element);
+    auto classes = class_selectors(element);
+    auto all_classes = joined(classes);
+    auto attributes = attribute_selectors(element);
+
+    StringBuilder label;
+    label.append(tag);
+    if (id.has_value())
+        label.append(*id);
+    label.append(all_classes);
+    level.label = MUST(label.to_string());
+
+    auto append = [&](String selector) {
+        if (!level.selectors.contains_slow(selector))
+            level.selectors.append(move(selector));
+    };
+
+    append(tag);
+    if (classes.size() > 1) {
+        for (auto const& class_selector : classes)
+            append(class_selector);
+    }
+    if (!classes.is_empty()) {
+        append(all_classes);
+        append(MUST(String::formatted("{}{}", tag, all_classes)));
+    }
+    for (auto const& attribute : attributes)
+        append(MUST(String::formatted("{}{}", tag, attribute)));
+    if (!classes.is_empty() && !attributes.is_empty())
+        append(MUST(String::formatted("{}{}{}", tag, all_classes, attributes.first())));
+    if (id.has_value())
+        append(*id);
+    if (auto parent = element.parent_element()) {
+        auto scope = scoping_selector(*parent);
+        if (!classes.is_empty())
+            append(MUST(String::formatted("{} > {}{}", scope, tag, all_classes)));
+        append(MUST(String::formatted("{} > {}", scope, nth_of_type_selector(element))));
+    }
+    auto path = path_selector(element);
+    append(path);
+
+    auto default_selector = [&]() -> String {
+        if (id.has_value())
+            return *id;
+        if (!classes.is_empty())
+            return all_classes;
+        if (!attributes.is_empty())
+            return MUST(String::formatted("{}{}", tag, attributes.first()));
+        return path;
+    }();
+    level.default_selector_index = level.selectors.find_first_index(default_selector).value();
+    return level;
+}
+
+// The resources that the element itself asks for and that the content blocker can keep it from getting.
+template<typename Callback>
+static void for_each_resource(DOM::Element const& element, Callback const& callback)
+{
+    auto report = [&](Utf16View url_string, ContentBlocker::ResourceType type) {
+        if (url_string.is_empty())
+            return;
+        auto url = element.document().encoding_parse_url(url_string);
+        if (url.has_value() && url->scheme().is_one_of("http"sv, "https"sv) && url->host().has_value())
+            callback(*url, type);
+    };
+    auto report_attribute = [&](Utf16FlyString const& name, ContentBlocker::ResourceType type) {
+        if (auto value = element.get_attribute(name); value.has_value())
+            report(value->utf16_view(), type);
+    };
+
+    if (element.namespace_uri() == Namespace::SVG) {
+        if (element.local_name() == SVG::TagNames::image) {
+            if (element.has_attribute(HTML::AttributeNames::href))
+                report_attribute(HTML::AttributeNames::href, ContentBlocker::ResourceType::Image);
+            else if (auto href = element.get_attribute_ns(Namespace::XLink, HTML::AttributeNames::href); href.has_value())
+                report(href->utf16_view(), ContentBlocker::ResourceType::Image);
+        }
+        return;
+    }
+    if (element.namespace_uri() != Namespace::HTML)
+        return;
+
+    auto const& name = element.local_name();
+    if (auto const* image = as_if<HTML::HTMLImageElement>(element)) {
+        if (auto current_src = image->current_src(); !current_src.is_empty())
+            report(current_src.utf16_view(), ContentBlocker::ResourceType::Image);
+        else
+            report_attribute(HTML::AttributeNames::src, ContentBlocker::ResourceType::Image);
+    } else if (auto const* media = as_if<HTML::HTMLMediaElement>(element)) {
+        report(media->current_src().utf16_view(), ContentBlocker::ResourceType::Media);
+        if (name == HTML::TagNames::video)
+            report_attribute(HTML::AttributeNames::poster, ContentBlocker::ResourceType::Image);
+    } else if (name == HTML::TagNames::iframe || name == HTML::TagNames::frame) {
+        report_attribute(HTML::AttributeNames::src, ContentBlocker::ResourceType::Subdocument);
+    } else if (name == HTML::TagNames::embed) {
+        report_attribute(HTML::AttributeNames::src, ContentBlocker::ResourceType::Object);
+    } else if (name == HTML::TagNames::object) {
+        report_attribute(HTML::AttributeNames::data, ContentBlocker::ResourceType::Object);
+    } else if (name == HTML::TagNames::input) {
+        report_attribute(HTML::AttributeNames::src, ContentBlocker::ResourceType::Image);
+    }
+}
+
+template<typename Callback>
+static void for_each_background_image(DOM::Element& element, Callback const& callback)
+{
+    auto window = element.document().window();
+    if (!window)
+        return;
+    auto background_image = window->get_computed_style(element, {})->get_property_value("background-image"_utf16_fly_string).to_well_formed_utf8();
+
+    // NB: A computed URL is always serialized as a quoted string.
+    static constexpr auto URL_START = "url(\""sv;
+    auto remaining = background_image.bytes_as_string_view();
+    for (auto start = remaining.find(URL_START); start.has_value(); start = remaining.find(URL_START)) {
+        remaining = remaining.substring_view(*start + URL_START.length());
+        auto end = remaining.find('"');
+        if (!end.has_value())
+            return;
+        auto url_string = Utf16String::from_utf8(remaining.substring_view(0, *end));
+        auto url = element.document().encoding_parse_url(url_string);
+        if (url.has_value() && url->scheme().is_one_of("http"sv, "https"sv) && url->host().has_value())
+            callback(*url, ContentBlocker::ResourceType::Image);
+        remaining = remaining.substring_view(*end);
+    }
+}
+
+static bool is_from_another_site(URL::URL const& url, URL::URL const& page_url)
+{
+    if (!page_url.host().has_value())
+        return true;
+    auto site = url.host()->registrable_domain();
+    auto page_site = page_url.host()->registrable_domain();
+    if (site.has_value() && page_site.has_value())
+        return *site != *page_site;
+    return url.serialized_host() != page_url.serialized_host();
+}
+
+static StringView resource_type_option(ContentBlocker::ResourceType type)
+{
+    switch (type) {
+    case ContentBlocker::ResourceType::Image:
+        return "$image"sv;
+    case ContentBlocker::ResourceType::Media:
+        return "$media"sv;
+    case ContentBlocker::ResourceType::Object:
+        return "$object"sv;
+    case ContentBlocker::ResourceType::Subdocument:
+        return "$subdocument"sv;
+    default:
+        return {};
+    }
+}
+
+static void append_network_filters(Vector<String>& filters, URL::URL const& url, URL::URL const& page_url, ContentBlocker::ResourceType type)
+{
+    auto append = [&](String filter) {
+        if (!filters.contains_slow(filter))
+            filters.append(move(filter));
+    };
+
+    // NB: The "||" anchor stands for a host alone, so a URL with a port is anchored at its scheme instead.
+    StringBuilder anchor_builder;
+    if (auto port = url.port(); port.has_value())
+        anchor_builder.appendff("|{}://{}:{}", url.scheme(), url.serialized_host(), *port);
+    else
+        anchor_builder.appendff("||{}", url.serialized_host());
+    auto anchor = MUST(anchor_builder.to_string());
+
+    auto option = resource_type_option(type);
+    auto path = url.serialize_path();
+    append(MUST(String::formatted("{}{}{}", anchor, path, option)));
+    if (auto query = url.query(); query.has_value() && !query->is_empty() && query->length() <= MAX_QUERY_LENGTH_IN_FILTER)
+        append(MUST(String::formatted("{}{}?{}{}", anchor, path, *query, option)));
+    if (auto end_of_directory = path.find_last('/'); end_of_directory.has_value() && *end_of_directory > 0)
+        append(MUST(String::formatted("{}{}*{}", anchor, path.substring_view(0, *end_of_directory + 1), option)));
+    // The page's own site is never offered as a whole.
+    if (is_from_another_site(url, page_url))
+        append(MUST(String::formatted("{}^", anchor)));
+}
+
+static String hostname_for_cosmetic_filters(URL::URL const& url)
+{
+    if (!url.host().has_value())
+        return {};
+    auto host = url.serialized_host();
+    if (host.starts_with("www."sv) && host.length() > 4)
+        host = host.substring_view(4);
+    return MUST(String::from_utf8(host));
+}
+
+static ElementPickerSelection describe_selection(DOM::Element& picked_element)
+{
+    auto& document = picked_element.document();
+    ElementPickerSelection selection;
+    selection.hostname = hostname_for_cosmetic_filters(document.url());
+
+    for (GC::Ptr<DOM::Element> element = picked_element; element; element = element->parent_element()) {
+        if (element.ptr() == document.body() || element.ptr() == document.document_element() || selection.levels.size() == MAX_LEVELS)
+            break;
+        selection.levels.append(describe_level(*element));
+
+        auto append_filters = [&](URL::URL const& url, ContentBlocker::ResourceType type) {
+            append_network_filters(selection.network_filters, url, document.url(), type);
+        };
+        for_each_resource(*element, [&](URL::URL const& url, ContentBlocker::ResourceType type) {
+            if (element.ptr() == &picked_element && is_from_another_site(url, document.url()))
+                selection.prefers_network_filter = true;
+            append_filters(url, type);
+        });
+        for_each_background_image(*element, append_filters);
+    }
+    return selection;
+}
+
+static GC::RootVector<GC::Ref<DOM::Element>> elements_blocked_by_network_rule(DOM::Document& document, GC::Ptr<DOM::Element> picked_element, ContentBlockerRule const& rule)
+{
+    GC::RootVector<GC::Ref<DOM::Element>> elements;
+    HashTable<DOM::Element const*> seen;
+    auto append_if_blocked = [&](DOM::Element& element, auto const& for_each) {
+        bool is_blocked = false;
+        for_each(element, [&](URL::URL const& url, ContentBlocker::ResourceType type) {
+            is_blocked = is_blocked || rule.matches(url, document.url(), type);
+        });
+        if (is_blocked && seen.set(&element) == AK::HashSetResult::InsertedNewEntry)
+            elements.append(element);
+    };
+
+    document.for_each_in_subtree_of_type<DOM::Element>([&](DOM::Element& element) {
+        append_if_blocked(element, [](auto& element, auto const& callback) { for_each_resource(element, callback); });
+        return TraversalDecision::Continue;
+    });
+
+    // OPTIMIZATION: The background of every element on the page would take the computed style of each, so only those
+    //               that filters were offered for are looked at.
+    for (auto element = picked_element; element && element->is_connected(); element = element->parent_element())
+        append_if_blocked(*element, [](auto& element, auto const& callback) { for_each_background_image(element, callback); });
+    return elements;
+}
+
+// The selectors of a style sheet that the content blocker made, which has one rule per line.
+static Vector<String> selectors_in_style_sheet(String const& style_sheet)
+{
+    Vector<String> selectors;
+    style_sheet.bytes_as_string_view().for_each_split_view('\n', SplitBehavior::Nothing, [&](StringView line) {
+        if (auto end_of_selector = line.find_last(" { "sv); end_of_selector.has_value())
+            selectors.append(MUST(String::from_utf8(line.substring_view(0, *end_of_selector))));
+    });
+    return selectors;
+}
+
+static StringView selector_of_cosmetic_filter(StringView filter)
+{
+    auto first_sharp = filter.find('#');
+    if (!first_sharp.has_value())
+        return {};
+    auto second_sharp = filter.find('#', *first_sharp + 1);
+    if (!second_sharp.has_value())
+        return {};
+    return filter.substring_view(*second_sharp + 1).trim_whitespace();
+}
+
+static String style_sheet_for_cosmetic_rule(DOM::Document& document, ContentBlockerRule const& rule)
+{
+    HashTable<Utf16FlyString> classes;
+    HashTable<Utf16FlyString> ids;
+    document.for_each_in_subtree_of_type<DOM::Element>([&](DOM::Element& element) {
+        if (auto const& id = element.id(); id.has_value() && !id->is_empty())
+            ids.set(*id);
+        for (auto const& class_name : element.class_names()) {
+            if (!class_name.is_empty())
+                classes.set(class_name);
+        }
+        return TraversalDecision::Continue;
+    });
+
+    Vector<Utf16FlyString> class_list;
+    class_list.ensure_capacity(classes.size());
+    for (auto const& class_name : classes)
+        class_list.unchecked_append(class_name);
+    Vector<Utf16FlyString> id_list;
+    id_list.ensure_capacity(ids.size());
+    for (auto const& id : ids)
+        id_list.unchecked_append(id);
+    return rule.cosmetic_style_sheet_for_url(document.fallback_base_url(), class_list, id_list);
+}
+
+GC::Ptr<DOM::Document> Page::element_picker_document(u64 session_id) const
+{
+    if (m_element_picker_session_id != session_id || !has_local_traversable())
+        return {};
+    auto document = local_traversable()->active_document();
+    if (!document || document != m_element_picker_document.ptr())
+        return {};
+    return document;
+}
+
+ElementPickerSelection Page::select_with_element_picker(DOM::Document& document, GC::Ptr<DOM::Node> node)
+{
+    auto element = pickable_element(document, node);
+    m_element_picker_element = element;
+    if (!element) {
+        document.show_element_picker_highlights({});
+        return {};
+    }
+    auto selection = describe_selection(*element);
+    document.show_element_picker_highlights(Array { GC::Ref { *element } });
+    return selection;
+}
+
+ElementPickerSelection Page::start_element_picker(u64 session_id, Optional<UniqueNodeID> node_id)
+{
+    stop_element_picker();
+    if (!has_local_traversable())
+        return {};
+    auto document = local_traversable()->active_document();
+    if (!document)
+        return {};
+
+    m_element_picker_session_id = session_id;
+    m_element_picker_document = *document;
+
+    GC::Ptr<DOM::Node> node = node_id.has_value() ? DOM::Node::from_unique_id(*node_id) : nullptr;
+    return select_with_element_picker(*document, node);
+}
+
+void Page::hover_element_picker(u64 session_id, DevicePixelPoint position)
+{
+    auto document = element_picker_document(session_id);
+    if (!document)
+        return;
+    if (auto element = pickable_element(*document, DOM::Node::from_unique_id(node_id_at_position(position))))
+        document->show_element_picker_highlights(Array { GC::Ref { *element } });
+    else
+        document->show_element_picker_highlights({});
+}
+
+ElementPickerSelection Page::pick_with_element_picker(u64 session_id, DevicePixelPoint position)
+{
+    auto document = element_picker_document(session_id);
+    if (!document)
+        return {};
+    return select_with_element_picker(*document, DOM::Node::from_unique_id(node_id_at_position(position)));
+}
+
+Optional<ElementPickerMatch> Page::set_element_picker_filter(u64 session_id, StringView filter, ElementPickerPreview preview)
+{
+    auto document = element_picker_document(session_id);
+    if (!document)
+        return {};
+
+    ElementPickerMatch match;
+    filter = filter.trim_whitespace();
+    auto rule = filter.is_empty() || filter.contains('\n') || filter.starts_with('!') || filter.starts_with('[')
+        ? nullptr
+        : ContentBlockerRule::create(filter);
+    if (!rule) {
+        document->show_element_picker_highlights({});
+        return match;
+    }
+
+    match.is_cosmetic = rule->is_cosmetic();
+    if (!match.is_cosmetic) {
+        auto elements = elements_blocked_by_network_rule(*document, m_element_picker_element.ptr(), *rule);
+        match.is_valid = !filter.contains(' ');
+        match.match_count = elements.size();
+        document->show_element_picker_highlights(elements.span());
+        return match;
+    }
+
+    // The content blocker itself says what it would hide on the page, so that what is shown is what the filter does.
+    auto style_sheet = style_sheet_for_cosmetic_rule(*document, *rule);
+    auto selectors = selectors_in_style_sheet(style_sheet);
+    if (selectors.is_empty()) {
+        auto selector = Utf16String::from_utf8(selector_of_cosmetic_filter(filter));
+        match.is_valid = !selector.is_empty() && document->selector_query_for(selector);
+    }
+
+    GC::RootVector<GC::Ref<DOM::Element>> elements;
+    HashTable<DOM::Element const*> seen;
+    for (auto const& selector : selectors) {
+        auto query = document->selector_query_for(Utf16String::from_utf8(selector));
+        if (!query)
+            continue;
+        match.is_valid = true;
+        auto nodes = query->query_all(*document);
+        for (u32 i = 0; i < nodes->length(); ++i) {
+            auto& element = const_cast<DOM::Element&>(as<DOM::Element>(*nodes->item(i)));
+            if (seen.set(&element) == AK::HashSetResult::InsertedNewEntry)
+                elements.append(element);
+        }
+    }
+    match.match_count = elements.size();
+
+    if (preview == ElementPickerPreview::Yes && match.is_valid)
+        document->show_element_picker_preview(Utf16String::from_utf8(style_sheet));
+    else
+        document->show_element_picker_highlights(elements.span());
+    return match;
+}
+
+void Page::stop_element_picker()
+{
+    if (auto document = m_element_picker_document.ptr())
+        document->close_element_picker();
+    m_element_picker_session_id.clear();
+    m_element_picker_document = nullptr;
+    m_element_picker_element = nullptr;
+}
+
+}
