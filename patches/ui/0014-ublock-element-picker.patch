+static QPushButton* create_button(QWidget& parent, QString const& text, char const* object_name)
+{
+    auto* button = new QPushButton(&parent);
+    button->setObjectName(QString::fromLatin1(object_name));
+    button->setAttribute(Qt::WA_LayoutUsesWidgetRect);
+    // NB: A click leaves the focus where it is, so that Esc and the filter's editor keep working.
+    button->setFocusPolicy(Qt::TabFocus);
+    bind_localized_text(*button, text);
+    return button;
+}
+
+static void set_style_property(QWidget& widget, char const* name, bool value)
+{
+    if (widget.property(name).toBool() == value)
+        return;
+    widget.setProperty(name, value);
+    widget.style()->unpolish(&widget);
+    widget.style()->polish(&widget);
+    widget.update();
+}
