+// NB: The page may be lost to a crash, or on its way to another process, while the picker is open.
+RefPtr<WebContentPage> ViewImplementation::page_for_element_picker() const
+{
+    if (!m_top_level_traversable || m_crash_state.has_value())
+        return {};
+    auto page = traversable().display_page();
+    if (!page || !page->is_open())
+        return {};
+    return page;
+}
+
+void ViewImplementation::start_element_picker(u64 session_id, ElementPickerTarget target)
+{
+    m_element_picker_session_awaiting_hit_test.clear();
+    if (target == ElementPickerTarget::ContextMenuElement && m_inspect_element_hit_test_request_id.has_value()) {
+        m_element_picker_session_awaiting_hit_test = session_id;
+        return;
+    }
+
+    Optional<Web::UniqueNodeID> node_id;
+    if (target == ElementPickerTarget::ContextMenuElement)
+        node_id = m_inspect_element_node_id;
+    if (auto page = page_for_element_picker())
+        page->async_element_picker_start(session_id, node_id);
+
+    // The page only answers for an element that it is asked to start with.
+    if (target == ElementPickerTarget::ContextMenuElement && !node_id.has_value() && on_element_picker_selection)
+        on_element_picker_selection(session_id, {});
+}
