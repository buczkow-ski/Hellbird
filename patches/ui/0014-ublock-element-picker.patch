+void ConnectionFromClient::element_picker_start(Web::PageId page_id, u64 session_id, Optional<Web::UniqueNodeID> node_id)
+{
+    auto page = this->page(page_id);
+    if (!page.has_value())
+        return;
+    auto selection = page->page().start_element_picker(session_id, node_id);
+    if (node_id.has_value())
+        async_did_pick_element(page_id, session_id, move(selection));
+}
+
+void ConnectionFromClient::element_picker_hover(Web::PageId page_id, u64 session_id, Web::DevicePixelPoint position)
+{
+    if (auto page = this->page(page_id); page.has_value())
+        page->page().hover_element_picker(session_id, position);
+}
+
+void ConnectionFromClient::element_picker_pick(Web::PageId page_id, u64 session_id, Web::DevicePixelPoint position)
+{
+    if (auto page = this->page(page_id); page.has_value())
+        async_did_pick_element(page_id, session_id, page->page().pick_with_element_picker(session_id, position));
+}
+
+void ConnectionFromClient::element_picker_set_filter(Web::PageId page_id, u64 session_id, u64 filter_id, String filter, Web::ElementPickerPreview preview)
+{
+    auto page = this->page(page_id);
+    if (!page.has_value())
+        return;
+    if (auto match = page->page().set_element_picker_filter(session_id, filter, preview); match.has_value())
+        async_did_match_element_picker_filter(page_id, session_id, filter_id, *match);
+}
+
+void ConnectionFromClient::element_picker_stop(Web::PageId page_id)
+{
+    if (auto page = this->page(page_id); page.has_value())
+        page->page().stop_element_picker();
+}
