+ElementPickerWidget::ElementPickerWidget(QWidget* tab, WebContentView* view)
+    : QFrame(tab)
+    , m_view(view)
+{
+    setObjectName("LadybirdElementPicker");
+    setAccessibleName(tr_ui("Block element"));
+#if defined(AK_OS_MACOS) || defined(LADYBIRD_QT_USE_RHI_WIDGET)
+    setAttribute(Qt::WA_DontCreateNativeAncestors);
+    setAttribute(Qt::WA_NativeWindow);
+#endif
+    cast_floating_shadow(*this, PANEL_CORNER_RADIUS);
+    setFixedWidth(PANEL_WIDTH);
+    setFocusPolicy(Qt::StrongFocus);
+
+    auto* layout = new QVBoxLayout(this);
+    layout->setContentsMargins(PANEL_PADDING, 0, PANEL_PADDING, PANEL_PADDING);
+    layout->setSpacing(8);
+
+    // The header, which the panel is dragged by.
+    m_header = new QWidget(this);
+    m_header->setCursor(Qt::SizeAllCursor);
+    auto* header_layout = new QHBoxLayout(m_header);
+    header_layout->setContentsMargins(0, 10, 0, 0);
+    header_layout->setSpacing(8);
+    m_icon = new QLabel(m_header);
+    m_icon->setFixedSize(HEADER_ICON_SIZE, HEADER_ICON_SIZE);
+    header_layout->addWidget(m_icon);
+    auto* title = new QLabel(m_header);
+    title->setObjectName("LadybirdElementPickerTitle");
+    bind_localized_text(*title, QStringLiteral("Block element"));
+    header_layout->addWidget(title);
+    header_layout->addStretch(1);
+    m_status = new QLabel(m_header);
+    m_status->setObjectName("LadybirdElementPickerStatus");
+    m_status->setTextFormat(Qt::PlainText);
+    m_status->setAlignment(Qt::AlignCenter);
+    m_status->hide();
+    header_layout->addWidget(m_status);
+    m_close_button = new QPushButton(m_header);
+    m_close_button->setObjectName("LadybirdElementPickerClose");
+    m_close_button->setAttribute(Qt::WA_LayoutUsesWidgetRect);
+    m_close_button->setFixedSize(24, 24);
+    m_close_button->setIconSize({ 12, 12 });
+    m_close_button->setCursor(Qt::ArrowCursor);
+    m_close_button->setFocusPolicy(Qt::TabFocus);
+    bind_localized_tooltip(*m_close_button, QStringLiteral("Quit element picker"));
+    m_close_button->setAccessibleName(tr_ui("Quit element picker"));
+    QObject::connect(m_close_button, &QPushButton::clicked, this, [this] { quit(); });
+    header_layout->addWidget(m_close_button);
+    layout->addWidget(m_header);
+
+    m_hint = new QLabel(this);
+    m_hint->setObjectName("LadybirdElementPickerDetail");
+    m_hint->setWordWrap(true);
+    bind_localized_text(*m_hint, QStringLiteral("Click an element on the page to block it. Press Esc to cancel."));
+    layout->addWidget(m_hint);
+
+    m_body = new QWidget(this);
+    auto* body_layout = new QVBoxLayout(m_body);
+    body_layout->setContentsMargins(0, 0, 0, 0);
+    body_layout->setSpacing(8);
+
+    // The filter.
+    m_editor = new QPlainTextEdit(m_body);
+    m_editor->setObjectName("LadybirdElementPickerFilter");
+    m_editor->setAccessibleName(tr_ui("Filter"));
+    m_editor->setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
+    m_editor->setFixedHeight(EDITOR_HEIGHT);
+    m_editor->setFrameShape(QFrame::NoFrame);
+    m_editor->setTabChangesFocus(true);
+    m_editor->setLineWrapMode(QPlainTextEdit::WidgetWidth);
+    m_editor->setWordWrapMode(QTextOption::WrapAnywhere);
+    m_editor->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    m_editor->installEventFilter(this);
+    QObject::connect(m_editor, &QPlainTextEdit::textChanged, this, [this] {
+        m_create_button->setEnabled(false);
+        update_selected_candidate();
+        m_apply_timer->start();
+    });
+    body_layout->addWidget(m_editor);
+
+    // What the filter is made for, and how narrowly.
+    m_element_label = new ElidedLabel({}, Qt::ElideMiddle, m_body);
+    m_element_label->setObjectName("LadybirdElementPickerDetail");
+    body_layout->addWidget(m_element_label);
+    auto add_slider = [&](QString const& text) {
+        auto* row = new QHBoxLayout;
+        row->setContentsMargins(0, 0, 0, 0);
+        row->setSpacing(10);
+        auto* label = new QLabel(m_body);
+        label->setObjectName("LadybirdElementPickerDetail");
+        label->setFixedWidth(80);
+        bind_localized_text(*label, text);
+        row->addWidget(label);
+        auto* slider = new QSlider(Qt::Horizontal, m_body);
+        slider->setAccessibleName(tr_ui(text));
+        slider->setSingleStep(1);
+        slider->setPageStep(1);
+        row->addWidget(slider, 1);
+        body_layout->addLayout(row);
+        return slider;
+    };
+    m_depth_slider = add_slider(QStringLiteral("Depth"));
+    QObject::connect(m_depth_slider, &QSlider::valueChanged, this, [this] { depth_changed(); });
+    m_specificity_slider = add_slider(QStringLiteral("Specificity"));
+    QObject::connect(m_specificity_slider, &QSlider::valueChanged, this, [this] { specificity_changed(); });
+
+    // The filters to choose from.
+    m_candidate_scroll = new QScrollArea(m_body);
+    m_candidate_scroll->setObjectName("LadybirdElementPickerCandidates");
+    m_candidate_scroll->setFrameShape(QFrame::NoFrame);
+    m_candidate_scroll->setWidgetResizable(true);
+    m_candidate_scroll->setFocusPolicy(Qt::NoFocus);
+    m_candidate_scroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    auto* rows = new QWidget(m_candidate_scroll);
+    rows->setObjectName("LadybirdElementPickerCandidateRows");
+    m_candidates = new QVBoxLayout(rows);
+    m_candidates->setContentsMargins(4, 4, 4, 4);
+    m_candidates->setSpacing(0);
+    m_candidates->setAlignment(Qt::AlignTop);
+    m_candidate_scroll->setWidget(rows);
+    body_layout->addWidget(m_candidate_scroll);
+
+    m_note = new QLabel(m_body);
+    m_note->setObjectName("LadybirdElementPickerNote");
+    m_note->setTextFormat(Qt::PlainText);
+    m_note->setWordWrap(true);
+    m_note->hide();
+    body_layout->addWidget(m_note);
+    layout->addWidget(m_body);
+
+    // The actions.
+    auto* actions = new QHBoxLayout;
+    actions->setContentsMargins(0, 0, 0, 0);
+    actions->setSpacing(6);
+    m_pick_button = create_button(*this, QStringLiteral("Pick"), "LadybirdElementPickerButton");
+    QObject::connect(m_pick_button, &QPushButton::clicked, this, [this] { pick_another(); });
+    actions->addWidget(m_pick_button);
+    m_preview_button = create_button(*this, QStringLiteral("Preview"), "LadybirdElementPickerButton");
+    m_preview_button->setCheckable(true);
+    QObject::connect(m_preview_button, &QPushButton::toggled, this, [this] { apply_filter(); });
+    actions->addWidget(m_preview_button);
+    actions->addStretch(1);
+    auto* quit_button = create_button(*this, QStringLiteral("Quit"), "LadybirdElementPickerButton");
+    QObject::connect(quit_button, &QPushButton::clicked, this, [this] { quit(); });
+    actions->addWidget(quit_button);
+    m_create_button = create_button(*this, QStringLiteral("Create"), "LadybirdElementPickerPrimaryButton");
+    QObject::connect(m_create_button, &QPushButton::clicked, this, [this] { create_filter(); });
+    actions->addWidget(m_create_button);
+    layout->addLayout(actions);
+
+    m_apply_timer = new QTimer(this);
+    m_apply_timer->setSingleShot(true);
+    m_apply_timer->setInterval(APPLY_DELAY_MS);
+    QObject::connect(m_apply_timer, &QTimer::timeout, this, [this] { apply_filter(); });
+
+    m_view->on_element_picker_hover = [this](Web::DevicePixelPoint position) {
+        if (m_mode == Mode::Pick)
+            m_view->element_picker_hover(position);
+    };
+    m_view->on_element_picker_click = [this](Web::DevicePixelPoint position) { clicked_on_page(position); };
+    m_view->on_element_picker_cancel = [this] { quit(); };
+    m_view->on_element_picker_selection = [this](u64 session_id, Web::ElementPickerSelection const& selection) {
+        if (m_view->element_picker_session() == session_id)
+            did_pick(selection);
+    };
+    m_view->on_element_picker_match = [this](u64 session_id, u64 filter_id, Web::ElementPickerMatch const& match) {
+        if (m_view->element_picker_session() == session_id && filter_id == m_filter_id)
+            did_match(match);
+    };
+
+    update_chrome_style();
+    update_icons();
+    hide();
+}
+
+void ElementPickerWidget::start(RemoteView::ElementPickerTarget target)
+{
+    // NB: The page may answer an earlier session after it is over, so sessions are told apart across all tabs.
+    static u64 s_next_session_id { 1 };
+
+    if (!m_view->element_picker_session().has_value())
+        m_page_cursor = m_view->cursor();
+    else
+        m_view->stop_element_picker();
+
+    m_user_position.clear();
+    m_drag_offset.clear();
+    m_session_id = s_next_session_id++;
+    m_view->start_element_picker(m_session_id, target);
+    set_mode(target == RemoteView::ElementPickerTarget::ContextMenuElement ? Mode::Awaiting : Mode::Pick);
+    show();
+    reposition();
+}
+
+// Nothing of the picker stays on the page: what it highlighted, hid or kept from the page is as it was.
+void ElementPickerWidget::quit()
+{
+    m_apply_timer->stop();
+    ++m_filter_id;
+    if (m_view->element_picker_session().has_value()) {
+        m_view->stop_element_picker();
+        m_view->setCursor(m_page_cursor);
+    }
+    if (!isVisible())
+        return;
+    auto had_focus = isAncestorOf(QApplication::focusWidget()) || hasFocus();
+    hide();
+    if (had_focus)
+        m_view->setFocus();
+}
+
+void ElementPickerWidget::set_mode(Mode mode)
+{
+    m_mode = mode;
+    auto adjusting = mode == Mode::Adjust;
+    m_apply_timer->stop();
+    ++m_filter_id;
+    {
+        QSignalBlocker blocker(m_preview_button);
+        m_preview_button->setChecked(false);
+    }
+    m_hint->setVisible(mode == Mode::Pick);
+    m_body->setVisible(adjusting);
+    m_pick_button->setVisible(adjusting);
+    m_preview_button->setVisible(adjusting);
+    m_create_button->setVisible(adjusting);
+    m_status->setVisible(false);
+    m_create_button->setEnabled(false);
+    m_preview_button->setEnabled(false);
+    m_view->setCursor(mode == Mode::Pick ? Qt::CrossCursor : Qt::ArrowCursor);
+    if (mode == Mode::Pick)
+        m_view->setFocus();
+    fit_to_contents();
+}
+
+void ElementPickerWidget::pick_another()
+{
+    if (!m_view->element_picker_session().has_value())
+        return;
+    // A session without a target highlights nothing, until the pointer is over an element.
+    m_view->start_element_picker(m_session_id, RemoteView::ElementPickerTarget::None);
+    set_mode(Mode::Pick);
+}
+
+// A click beside the panel goes back to picking, other than in a preview, where the page is looked at and not picked on.
+void ElementPickerWidget::clicked_on_page(Web::DevicePixelPoint position)
+{
+    switch (m_mode) {
+    case Mode::Pick:
+        m_mode = Mode::Awaiting;
+        m_view->element_picker_pick(position);
+        return;
+    case Mode::Awaiting:
+        return;
+    case Mode::Adjust:
+        if (!m_preview_button->isChecked())
+            pick_another();
+        return;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+void ElementPickerWidget::did_pick(Web::ElementPickerSelection const& selection)
+{
+    // NB: What comes back for a start without a target is not picked by the user.
+    if (m_mode != Mode::Awaiting)
+        return;
+    if (selection.levels.is_empty()) {
+        set_mode(Mode::Pick);
+        return;
+    }
+
+    m_selection = selection;
+    {
+        QSignalBlocker blocker(m_depth_slider);
+        m_depth_slider->setRange(0, static_cast<int>(m_selection.levels.size()) - 1);
+        m_depth_slider->setValue(0);
+        m_depth_slider->setEnabled(m_selection.levels.size() > 1);
+    }
+    set_mode(Mode::Adjust);
+    depth_changed();
+    if (m_selection.prefers_network_filter && !m_selection.network_filters.is_empty())
+        set_filter(qstring_from_ak_string(m_selection.network_filters.first()));
+    reposition();
+    m_editor->setFocus();
+}
+
+void ElementPickerWidget::did_match(Web::ElementPickerMatch const& match)
+{
+    if (m_mode != Mode::Adjust)
+        return;
+
+    if (!match.is_valid)
+        show_status(tr_ui("Invalid filter"), Tone::Failure);
+    else if (match.match_count == 1)
+        show_status(tr_ui("1 match"), Tone::Normal);
+    else
+        show_status(tr_ui(QStringLiteral("%1 matches").arg(match.match_count)), match.match_count == 0 ? Tone::Failure : Tone::Normal);
+
+    m_create_button->setEnabled(match.is_valid);
+
+    // What a network filter blocks is kept from loading, so there is nothing to hide for it.
+    auto can_preview = match.is_valid && match.is_cosmetic && match.match_count > 0;
+    m_preview_button->setEnabled(can_preview);
+    if (!can_preview && m_preview_button->isChecked())
+        m_preview_button->setChecked(false);
+}
+
+size_t ElementPickerWidget::level_index() const
+{
+    return min(static_cast<size_t>(max(m_depth_slider->value(), 0)), m_selection.levels.size() - 1);
+}
+
+QString ElementPickerWidget::cosmetic_filter(QString const& selector) const
+{
+    return qstring_from_ak_string(m_selection.hostname) + QStringLiteral("##") + selector;
+}
+
+// A filter is one line, however it was pasted.
+QString ElementPickerWidget::filter() const
+{
+    return m_editor->toPlainText().remove(QLatin1Char('\r')).remove(QLatin1Char('\n')).trimmed();
+}
+
+void ElementPickerWidget::set_filter(QString const& filter)
+{
+    {
+        QSignalBlocker blocker(m_editor);
+        m_editor->setPlainText(filter);
+    }
+    update_selected_candidate();
+    apply_filter();
+}
+
+void ElementPickerWidget::depth_changed()
+{
+    if (m_selection.levels.is_empty())
+        return;
+    auto const& level = m_selection.levels[level_index()];
+    m_element_label->setText(qstring_from_ak_string(level.label));
+    m_element_label->setToolTip(qstring_from_ak_string(level.label));
+    {
+        QSignalBlocker blocker(m_specificity_slider);
+        m_specificity_slider->setRange(0, static_cast<int>(level.selectors.size()) - 1);
+        m_specificity_slider->setValue(static_cast<int>(level.default_selector_index));
+        m_specificity_slider->setEnabled(level.selectors.size() > 1);
+    }
+    update_candidates();
+    specificity_changed();
+}
+
+void ElementPickerWidget::specificity_changed()
+{
+    if (m_selection.levels.is_empty())
+        return;
+    auto const& selectors = m_selection.levels[level_index()].selectors;
+    if (selectors.is_empty())
+        return;
+    auto index = min(static_cast<size_t>(max(m_specificity_slider->value(), 0)), selectors.size() - 1);
+    set_filter(cosmetic_filter(qstring_from_ak_string(selectors[index])));
+}
+
+void ElementPickerWidget::apply_filter()
+{
+    m_apply_timer->stop();
+    if (m_mode != Mode::Adjust)
+        return;
+    show_note(protection_note());
+    m_create_button->setEnabled(false);
+    auto preview = m_preview_button->isChecked() ? Web::ElementPickerPreview::Yes : Web::ElementPickerPreview::No;
+    m_view->element_picker_set_filter(++m_filter_id, ak_string_from_qstring(filter()), preview);
+}
+
+void ElementPickerWidget::create_filter()
+{
+    if (!m_create_button->isEnabled())
+        return;
+    switch (add_custom_filter(Application::settings(), ak_string_from_qstring(filter()))) {
+    case AddCustomFilterResult::Added:
+        quit();
+        return;
+    case AddCustomFilterResult::Empty:
+        return;
+    case AddCustomFilterResult::AlreadyExists:
+        show_note(tr_ui("Rule already exists"));
+        return;
+    case AddCustomFilterResult::TooLarge:
+        show_note(tr_ui("Custom filters are full"));
+        return;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+// NB: A layout leaves out a widget that is yet to be shown, so what the list is made of is shown right away, for the list
+//     to be fitted to it.
+void ElementPickerWidget::add_candidate_heading(QString const& text)
+{
+    auto* heading = new QLabel(m_candidate_scroll->widget());
+    heading->setObjectName("LadybirdElementPickerHeading");
+    heading->setText(tr_ui(text));
+    m_candidates->addWidget(heading);
+    heading->show();
+}
+
+void ElementPickerWidget::add_candidate(QString const& filter)
+{
+    auto* row = new QPushButton(m_candidate_scroll->widget());
+    row->setObjectName("LadybirdElementPickerCandidate");
+    row->setFixedHeight(CANDIDATE_HEIGHT);
+    row->setAttribute(Qt::WA_LayoutUsesWidgetRect);
+    row->setFocusPolicy(Qt::TabFocus);
+    row->setAccessibleName(filter);
+    row->setToolTip(filter);
+    row->setProperty("filter", filter);
+    auto* row_layout = new QHBoxLayout(row);
+    row_layout->setContentsMargins(6, 0, 6, 0);
+    auto* label = new ElidedLabel(filter, Qt::ElideMiddle, row);
+    label->setObjectName("LadybirdElementPickerCandidateLabel");
+    label->setTextFormat(Qt::PlainText);
+    label->setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
+    label->setAttribute(Qt::WA_TransparentForMouseEvents);
+    row_layout->addWidget(label);
+    QObject::connect(row, &QPushButton::clicked, this, [this, filter] {
+        // The slider follows, where it has the filter.
+        if (!m_selection.levels.is_empty()) {
+            auto const& selectors = m_selection.levels[level_index()].selectors;
+            for (size_t i = 0; i < selectors.size(); ++i) {
+                if (cosmetic_filter(qstring_from_ak_string(selectors[i])) == filter) {
+                    QSignalBlocker blocker(m_specificity_slider);
+                    m_specificity_slider->setValue(static_cast<int>(i));
+                }
+            }
+        }
+        set_filter(filter);
+    });
+    m_candidates->addWidget(row);
+    row->show();
+}
+
+void ElementPickerWidget::update_candidates()
+{
+    // The rows go once the event loop is back, as one of them may be handling a press.
+    while (auto* item = m_candidates->takeAt(0)) {
+        if (auto* widget = item->widget()) {
+            widget->hide();
+            widget->setObjectName({});
+            widget->deleteLater();
+        }
+        delete item;
+    }
+
+    if (!m_selection.network_filters.is_empty()) {
+        add_candidate_heading(QStringLiteral("Network filters"));
+        for (auto const& network_filter : m_selection.network_filters)
+            add_candidate(qstring_from_ak_string(network_filter));
+    }
+    add_candidate_heading(QStringLiteral("Cosmetic filters"));
+    for (auto const& selector : m_selection.levels[level_index()].selectors)
+        add_candidate(cosmetic_filter(qstring_from_ak_string(selector)));
+
+    m_candidate_scroll->verticalScrollBar()->setValue(0);
+    fit_to_contents();
+}
+
+void ElementPickerWidget::update_selected_candidate()
+{
+    auto current = filter();
+    for (int i = 0; i < m_candidates->count(); ++i) {
+        auto* row = qobject_cast<QPushButton*>(m_candidates->itemAt(i)->widget());
+        if (!row)
+            continue;
+        auto is_current = row->property("filter").toString() == current;
+        set_style_property(*row, "current", is_current);
+        if (is_current)
+            m_candidate_scroll->ensureWidgetVisible(row, 0, CANDIDATE_HEIGHT);
+    }
+}
+
+void ElementPickerWidget::show_status(QString const& text, Tone tone)
+{
+    m_status->setText(text);
+    set_style_property(*m_status, "failed", tone == Tone::Failure);
+    m_status->show();
+}
+
+// A filter that is made while nothing is blocked on the site is kept for when something is again.
+QString ElementPickerWidget::protection_note() const
+{
+    switch (m_view->content_blocking_snapshot().state) {
+    case WebView::ContentBlockingState::Disabled:
+        return tr_ui("Protection is off. The filter takes effect once it is turned on.");
+    case WebView::ContentBlockingState::SiteDisabled:
+        return tr_ui("Protection is paused on this site. The filter takes effect once it is resumed.");
+    case WebView::ContentBlockingState::Unavailable:
+    case WebView::ContentBlockingState::Enabled:
+    case WebView::ContentBlockingState::NoRules:
+        return {};
+    }
+    VERIFY_NOT_REACHED();
+}
+
+void ElementPickerWidget::show_note(QString const& text)
+{
+    if (m_note->text() == text)
+        return;
+    m_note->setText(text);
+    m_note->setVisible(!text.isEmpty());
+    fit_to_contents();
+}
+
+void ElementPickerWidget::fit_to_contents()
+{
+    auto max_height = clamp(m_view->height() - HEIGHT_BESIDES_CANDIDATES, 2 * CANDIDATE_HEIGHT, CANDIDATE_LIST_MAX_HEIGHT);
+    m_candidates->activate();
+    m_candidate_scroll->setFixedHeight(min(m_candidates->sizeHint().height(), max_height));
+    if (m_body->layout())
+        m_body->layout()->activate();
+    layout()->activate();
+    adjustSize();
+    reposition();
+}
+
+void ElementPickerWidget::reposition()
+{
+    auto* tab = parentWidget();
+    if (!tab)
+        return;
+    QRect page(m_view->mapTo(tab, QPoint(0, 0)), m_view->size());
+    QPoint position(page.right() + 1 - PAGE_EDGE_INSET - width(), page.bottom() + 1 - PAGE_EDGE_INSET - height());
+    if (m_user_position.has_value())
+        position = *m_user_position;
+    // NB: The top left corner has the header that the panel is dragged by, so it stays on the page even where the panel
+    //     does not fit.
+    position.setX(max(page.left(), min(position.x(), page.right() + 1 - width())));
+    position.setY(max(page.top(), min(position.y(), page.bottom() + 1 - height())));
+    if (pos() != position)
+        move(position);
+#if defined(LADYBIRD_QT_USE_RHI_WIDGET)
+    if (auto* handle = windowHandle()) {
+        handle->setPosition(mapTo(window(), QPoint {}));
+        if (isVisible())
+            handle->raise();
+    }
+#endif
+}
+
+bool ElementPickerWidget::event(QEvent* event)
+{
+    if (event->type() == QEvent::PaletteChange) {
+        update_chrome_style();
+        update_icons();
+    }
+#if defined(LADYBIRD_QT_USE_RHI_WIDGET)
+    else if (event->type() == QEvent::DevicePixelRatioChange) {
+        clearMask();
+        update_native_rounded_mask();
+    }
+#endif
+    return QFrame::event(event);
+}
+
+bool ElementPickerWidget::eventFilter(QObject* watched, QEvent* event)
+{
+    if (watched == m_editor && event->type() == QEvent::KeyPress) {
+        auto* key_event = static_cast<QKeyEvent*>(event);
+        if (key_event->key() == Qt::Key_Return || key_event->key() == Qt::Key_Enter) {
+            create_filter();
+            return true;
+        }
+        if (key_event->key() == Qt::Key_Escape) {
+            quit();
+            return true;
+        }
+    }
+    return QFrame::eventFilter(watched, event);
+}
+
+void ElementPickerWidget::keyPressEvent(QKeyEvent* event)
+{
+    if (event->key() == Qt::Key_Escape) {
+        quit();
+        event->accept();
+        return;
+    }
+    QFrame::keyPressEvent(event);
+}
+
+void ElementPickerWidget::mousePressEvent(QMouseEvent* event)
+{
+    if (event->button() == Qt::LeftButton && m_header->geometry().contains(event->position().toPoint()))
+        m_drag_offset = event->globalPosition().toPoint() - mapToGlobal(QPoint(0, 0));
+    // NB: The page is behind the panel, and is not to be picked on through it.
+    event->accept();
+}
+
+void ElementPickerWidget::mouseMoveEvent(QMouseEvent* event)
+{
+    if (m_drag_offset.has_value() && parentWidget()) {
+        m_user_position = parentWidget()->mapFromGlobal(event->globalPosition().toPoint() - *m_drag_offset);
+        reposition();
+        m_user_position = pos();
+    }
+    event->accept();
+}
+
+void ElementPickerWidget::mouseReleaseEvent(QMouseEvent* event)
+{
+    if (event->button() == Qt::LeftButton)
+        m_drag_offset.clear();
+    event->accept();
+}
+
+void ElementPickerWidget::showEvent(QShowEvent* event)
+{
+    QFrame::showEvent(event);
+    raise();
+#if defined(AK_OS_MACOS)
+    round_appkit_view_corners(*this, PANEL_CORNER_RADIUS, Theme::panel().edge);
+#elif defined(LADYBIRD_QT_USE_RHI_WIDGET)
+    update_native_rounded_mask();
+    if (auto* handle = windowHandle()) {
+        handle->setPosition(mapTo(window(), QPoint {}));
+        handle->raise();
+    }
+#endif
+}
+
+void ElementPickerWidget::resizeEvent(QResizeEvent* event)
+{
+    QFrame::resizeEvent(event);
+    update_native_rounded_mask();
+}
+
+#if defined(LADYBIRD_QT_USE_RHI_WIDGET)
+void ElementPickerWidget::paintEvent(QPaintEvent* event)
+{
+    // Fill every pixel inside the native HWND so masked rounded corners never expose unpainted black pixels, and draw
+    // a crisp 1 px border since the alien FloatingShadow cannot paint above the native WebContentView.
+    {
+        QPainter bg_painter(this);
+        bg_painter.fillRect(rect(), Theme::panel().surface);
+    }
+    QFrame::paintEvent(event);
+    QPainter border_painter(this);
+    border_painter.setRenderHint(QPainter::Antialiasing);
+    border_painter.setBrush(Qt::NoBrush);
+    border_painter.setPen(QPen(Theme::panel().edge, 1));
+    auto radius = static_cast<qreal>(PANEL_CORNER_RADIUS) - 0.5;
+    border_painter.drawRoundedRect(QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5), radius, radius);
+}
+#endif
+
+void ElementPickerWidget::update_native_rounded_mask()
+{
+#if defined(LADYBIRD_QT_USE_RHI_WIDGET)
+    auto bounds = rect();
+    if (bounds.isEmpty())
+        return;
+    auto r = min(PANEL_CORNER_RADIUS, min(bounds.width(), bounds.height()) / 2);
+    if (r <= 0) {
+        setMask(QRegion(bounds));
+        return;
+    }
+    QRegion region(bounds.adjusted(0, r, 0, -r));
+    for (int y = 0; y < r; ++y) {
+        auto dy = r - (y + 0.5);
+        auto inset = qFloor(r - qSqrt((r * r) - (dy * dy)));
+        auto w = bounds.width() - (2 * inset);
+        region += QRect(bounds.left() + inset, bounds.top() + y, w, 1);
+        region += QRect(bounds.left() + inset, bounds.bottom() - y, w, 1);
+    }
+    setMask(region);
+#endif
+}
+
+void ElementPickerWidget::update_chrome_style()
+{
+    if (m_is_updating_chrome_style)
+        return;
+    m_is_updating_chrome_style = true;
+    setStyleSheet(ChromeStyle::element_picker_style_sheet());
+    m_is_updating_chrome_style = false;
+}
+
+void ElementPickerWidget::update_icons()
+{
+    m_icon->setPixmap(create_chrome_icon(ChromeIcon::ContentBlocking, Theme::accent()).pixmap(QSize(HEADER_ICON_SIZE, HEADER_ICON_SIZE), devicePixelRatioF()));
+    m_close_button->setIcon(create_chrome_icon(ChromeIcon::Close, Theme::panel().body));
+}
+
+}
