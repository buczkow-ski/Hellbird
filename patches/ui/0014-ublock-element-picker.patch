+fn paint_element_picker_overlay<O: Observer>(
+    recorder: &mut PaintRecorder<'_, O>,
+    highlights: &[FfiElementPickerHighlight],
+) {
+    const BACKDROP_COLOR: Color = Color::from_rgba(0, 0, 0, 56);
+    const FILL_COLOR: Color = Color::from_rgba(255, 68, 68, 71);
+    const BORDER_COLOR: Color = Color::from_rgba(220, 38, 38, 230);
+    const BORDER_WIDTH: f64 = 1.5;
+
+    let viewport_rect = recorder.inputs.bitmap_rect;
+    recorder
+        .recorder
+        .fill_rect(viewport_rect, BACKDROP_COLOR, ForceDarkRole::None);
+
+    let border_width = ((BORDER_WIDTH * recorder.inputs.device_pixels_per_css_pixel).round() as i32).max(1);
+    let converter = recorder.converter;
+    for highlight in highlights {
+        with_highlight_context(recorder, highlight.paintable, |recorder, paintable| {
+            for css_rect in paintable_geometry::absolute_border_box_rects_of_fragments(recorder.source, paintable) {
+                let rect = converter.enclosing_device_rect(css_rect);
+                if rect.is_empty() {
+                    continue;
+                }
+                let mut fill =
+                    |rect: IntRect, color: Color| recorder.recorder.fill_rect(rect, color, ForceDarkRole::None);
+                // A border that would cover the whole rect is all there is to paint of it.
+                if rect.width <= 2 * border_width || rect.height <= 2 * border_width {
+                    fill(rect, BORDER_COLOR);
+                    continue;
+                }
+                let inner = IntRect::new(
+                    rect.x + border_width,
+                    rect.y + border_width,
+                    rect.width - 2 * border_width,
+                    rect.height - 2 * border_width,
+                );
+                let inner_right = inner.x + inner.width;
+                let inner_bottom = inner.y + inner.height;
+                fill(inner, FILL_COLOR);
+                fill(IntRect::new(rect.x, rect.y, rect.width, border_width), BORDER_COLOR);
+                fill(
+                    IntRect::new(rect.x, inner_bottom, rect.width, border_width),
+                    BORDER_COLOR,
+                );
+                fill(IntRect::new(rect.x, inner.y, border_width, inner.height), BORDER_COLOR);
+                fill(
+                    IntRect::new(inner_right, inner.y, border_width, inner.height),
+                    BORDER_COLOR,
+                );
+            }
+        });
+    }
+}
