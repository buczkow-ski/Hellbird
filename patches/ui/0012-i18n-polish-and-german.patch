+            if (record.type === "childList") {
+                for (const added of record.addedNodes) {
+                    if (!hasSkippedAncestor(added)) scheduleRetranslate(added);
+                }
+            } else if (record.type === "characterData" || record.type === "attributes") {
+                if (!hasSkippedAncestor(record.target)) scheduleRetranslate(record.target);
+            }
+        }
+    });
+
+    const titleObserver = new MutationObserver(() => {
+        if (!isApplying) scheduleRetranslate(null);
+    });
+
+    function start() {
+        applyLanguage(configuredPreference);
+        const titleEl = document.querySelector("title");
+        if (titleEl) {
+            titleObserver.observe(titleEl, { childList: true, characterData: true, subtree: true });
+        }
+        if (document.body) {
+            observer.observe(document.body, {
+                childList: true,
+                subtree: true,
+                characterData: true,
+                attributes: true,
+                attributeFilter: ATTRS,
+            });
+        }
+    }
+
+    if (document.readyState === "loading") {
+        document.addEventListener("DOMContentLoaded", start, { once: true });
+    } else {
+        start();
+    }
+
+    document.addEventListener("WebUILoaded", () => {
+        if (typeof ladybird !== "undefined" && typeof ladybird.sendMessage === "function") {
+            ladybird.sendMessage("loadInterfaceLanguage");
+        }
+    });
+
+    document.addEventListener("WebUIMessage", event => {
+        const detail = event.detail;
+        if (!detail) return;
+        if (detail.name === "interfaceLanguageChanged" && typeof detail.data === "string") {
+            applyLanguage(detail.data);
+        } else if (detail.name === "loadSettings" && detail.data?.appearance?.interfaceLanguage) {
+            applyLanguage(detail.data.appearance.interfaceLanguage);
+        }
+    });
+
+    window.hellbirdI18n = {
+        t: text => translateRaw(text, activeLanguage),
+        setLanguage: applyLanguage,
+        get language() {
+            return activeLanguage;
+        },
+    };
+})();
