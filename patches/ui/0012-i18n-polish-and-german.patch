+Optional<QString> translate_pattern(QString const& text, WebView::InterfaceLanguage language)
+{
+    auto const is_pl = language == WebView::InterfaceLanguage::Polish;
+
+    if (auto separator = text.indexOf(QStringLiteral("  ")); separator > 0) {
+        auto head = text.left(separator);
+        auto tail = text.mid(separator + 2);
+        auto translated_head = tr_ui(head);
+        if (translated_head != head)
+            return translated_head + QStringLiteral("  ") + tail;
+    }
+
+    static auto const& protection_active_re = *new QRegularExpression(QStringLiteral("^Protection active on (.+)$"));
+    if (auto m = protection_active_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Ochrona aktywna na %1") : QStringLiteral("Schutz aktiv auf %1")).arg(m.captured(1));
+
+    static auto const& paused_resume_re = *new QRegularExpression(QStringLiteral("^Paused on (.+) \u2014 click to resume$"));
+    if (auto m = paused_resume_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Wstrzymano na %1 \u2014 kliknij, aby wznowić") : QStringLiteral("Pausiert auf %1 \u2014 zum Fortsetzen klicken")).arg(m.captured(1));
+
+    static auto const& pause_site_re = *new QRegularExpression(QStringLiteral("^Pause protection on (.+)$"));
+    if (auto m = pause_site_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Wstrzymaj ochronę na %1") : QStringLiteral("Schutz auf %1 pausieren")).arg(m.captured(1));
+
+    static auto const& resume_site_re = *new QRegularExpression(QStringLiteral("^Resume protection on (.+)$"));
+    if (auto m = resume_site_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Wznów ochronę na %1") : QStringLiteral("Schutz auf %1 fortsetzen")).arg(m.captured(1));
+
+    static auto const& shield_blocked_site_re = *new QRegularExpression(QStringLiteral("^Hellbird Shield \u2014 (\\d+) blocked on (.+)$"));
+    if (auto m = shield_blocked_site_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Hellbird Shield \u2014 zablokowano %1 na %2") : QStringLiteral("Hellbird Shield \u2014 %1 auf %2 blockiert")).arg(m.captured(1), m.captured(2));
+
+    static auto const& shield_blocked_re = *new QRegularExpression(QStringLiteral("^Hellbird Shield \u2014 (\\d+) blocked$"));
+    if (auto m = shield_blocked_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Hellbird Shield \u2014 zablokowano %1") : QStringLiteral("Hellbird Shield \u2014 %1 blockiert")).arg(m.captured(1));
+
+    static auto const& shield_paused_re = *new QRegularExpression(QStringLiteral("^Hellbird Shield \u2014 Paused on (.+)$"));
+    if (auto m = shield_paused_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Hellbird Shield \u2014 Wstrzymano na %1") : QStringLiteral("Hellbird Shield \u2014 Pausiert auf %1")).arg(m.captured(1));
+
+    static auto const& restore_tabs_re = *new QRegularExpression(QStringLiteral("^Restore the (\\d+) tabs you had open\\?$"));
+    if (auto m = restore_tabs_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Przywrócić %1 otwartych kart?") : QStringLiteral("Die %1 geöffneten Tabs wiederherstellen?")).arg(m.captured(1));
+
+    static auto const& search_tabs_re = *new QRegularExpression(QStringLiteral("^Search (\\d+) tabs$"));
+    if (auto m = search_tabs_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Szukaj wśród %1 kart") : QStringLiteral("%1 Tabs durchsuchen")).arg(m.captured(1));
+
+    static auto const& find_of_re = *new QRegularExpression(QStringLiteral("^(\\d+) of (\\d+)$"));
+    if (auto m = find_of_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("%1 z %2") : QStringLiteral("%1 von %2")).arg(m.captured(1), m.captured(2));
+
+    static auto const& open_all_tabs_re = *new QRegularExpression(QStringLiteral("^Open All in Tabs \\((\\d+)\\)$"));
+    if (auto m = open_all_tabs_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Otwórz wszystkie w kartach (%1)") : QStringLiteral("Alle in Tabs öffnen (%1)")).arg(m.captured(1));
+
+    static auto const& update_available_re = *new QRegularExpression(QStringLiteral("^(?:Hellbird|Ladybird) (.+) is available$"));
+    if (auto m = update_available_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Dostępna jest wersja Hellbird %1") : QStringLiteral("Hellbird %1 ist verfügbar")).arg(m.captured(1));
+
+    static auto const& you_have_updater_re = *new QRegularExpression(QStringLiteral("^You have (?:Hellbird|Ladybird) (.+)\\. Update it with your system's software updater\\.$"));
+    if (auto m = you_have_updater_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Masz wersję Hellbird %1. Zaktualizuj ją za pomocą menedżera aktualizacji systemu.") : QStringLiteral("Du verwendest Hellbird %1. Aktualisiere über die Systemaktualisierung.")).arg(m.captured(1));
+
+    static auto const& you_have_re = *new QRegularExpression(QStringLiteral("^You have (?:Hellbird|Ladybird) (.+)\\.$"));
+    if (auto m = you_have_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("Masz wersję Hellbird %1.") : QStringLiteral("Du verwendest Hellbird %1.")).arg(m.captured(1));
+
+    static auto const& host_filter_tooltip_re = *new QRegularExpression(QStringLiteral("^(.+) \\((.+)\\)\\nClick to write a filter for it$"));
+    if (auto m = host_filter_tooltip_re.match(text); m.hasMatch())
+        return (is_pl ? QStringLiteral("%1 (%2)\nKliknij, aby utworzyć filtr") : QStringLiteral("%1 (%2)\nKlicken, um einen Filter zu erstellen")).arg(m.captured(1), m.captured(2));
+
+    return {};
+}
+
+}
+
+WebView::InterfaceLanguage effective_interface_language()
+{
+    auto* settings = Application::settings_if_available();
+    if (!settings)
+        return WebView::InterfaceLanguage::English;
+
+    auto preference = settings->appearance().interface_language;
+    if (preference != WebView::InterfaceLanguage::System)
+        return preference;
+
+    auto ui_languages = QLocale::system().uiLanguages();
+    if (!ui_languages.isEmpty()) {
+        auto primary = ui_languages.first().toLower();
+        if (primary.startsWith(QStringLiteral("pl")))
+            return WebView::InterfaceLanguage::Polish;
+        if (primary.startsWith(QStringLiteral("de")))
+            return WebView::InterfaceLanguage::German;
+        return WebView::InterfaceLanguage::English;
+    }
+
+    switch (QLocale::system().language()) {
+    case QLocale::Polish:
+        return WebView::InterfaceLanguage::Polish;
+    case QLocale::German:
+        return WebView::InterfaceLanguage::German;
+    default:
+        return WebView::InterfaceLanguage::English;
+    }
+}
+
+QString tr_ui(QString const& text)
+{
+    if (text.isEmpty())
+        return text;
+
+    auto language = effective_interface_language();
+    if (language == WebView::InterfaceLanguage::English)
+        return text;
+
+    auto const& table = language == WebView::InterfaceLanguage::Polish ? polish_table() : german_table();
+    if (auto it = table.constFind(text); it != table.constEnd())
+        return *it;
+
+    if (text.contains(QLatin1Char('&'))) {
+        auto clean = strip_mnemonic(text);
+        if (auto it = table.constFind(clean); it != table.constEnd())
+            return *it;
+    }
+
+    if (auto patterned = translate_pattern(text, language); patterned.has_value())
+        return *patterned;
+
+    return text;
+}
+
+QString tr_ui(char const* text)
+{
+    return tr_ui(QString::fromUtf8(text));
+}
+
+QString tr_ui(StringView text)
+{
+    return tr_ui(qstring_from_ak_string(text));
+}
+
+void bind_localized_text(QAction& action, QString const& source_text)
+{
+    bind_entry(registry().action_texts, action, source_text);
+    action.setText(tr_ui(source_text));
+}
+
+void bind_localized_tooltip(QAction& action, QString const& source_tooltip)
+{
+    bind_entry(registry().action_tooltips, action, source_tooltip);
+    action.setToolTip(tr_ui(source_tooltip));
+}
+
+void bind_localized_title(QMenu& menu, QString const& source_title)
+{
+    bind_entry(registry().menu_titles, menu, source_title);
+    menu.setTitle(tr_ui(source_title));
+}
+
+void bind_localized_text(QLabel& label, QString const& source_text)
+{
+    bind_entry(registry().label_texts, label, source_text);
+    label.setText(tr_ui(source_text));
+}
+
+void bind_localized_text(QAbstractButton& button, QString const& source_text)
+{
+    bind_entry(registry().button_texts, button, source_text);
+    button.setText(tr_ui(source_text));
+}
+
+void bind_localized_placeholder(QLineEdit& line_edit, QString const& source_placeholder)
+{
+    bind_entry(registry().placeholders, line_edit, source_placeholder);
+    line_edit.setPlaceholderText(tr_ui(source_placeholder));
+}
+
+void bind_localized_tooltip(QWidget& widget, QString const& source_tooltip)
+{
+    bind_entry(registry().widget_tooltips, widget, source_tooltip);
+    widget.setToolTip(tr_ui(source_tooltip));
+}
+
+void refresh_localized_qt_controls()
+{
+    auto& reg = registry();
+    auto language = effective_interface_language();
+    if (reg.last_refreshed_language == language)
+        return;
+    reg.last_refreshed_language = language;
+
+    for (auto it = reg.action_texts.cbegin(); it != reg.action_texts.cend(); ++it)
+        it.key()->setText(tr_ui(it.value()));
+
+    for (auto it = reg.action_tooltips.cbegin(); it != reg.action_tooltips.cend(); ++it)
+        it.key()->setToolTip(tr_ui(it.value()));
+
+    for (auto it = reg.menu_titles.cbegin(); it != reg.menu_titles.cend(); ++it)
+        it.key()->setTitle(tr_ui(it.value()));
+
+    for (auto it = reg.label_texts.cbegin(); it != reg.label_texts.cend(); ++it)
+        it.key()->setText(tr_ui(it.value()));
+
+    for (auto it = reg.button_texts.cbegin(); it != reg.button_texts.cend(); ++it)
+        it.key()->setText(tr_ui(it.value()));
+
+    for (auto it = reg.placeholders.cbegin(); it != reg.placeholders.cend(); ++it)
+        it.key()->setPlaceholderText(tr_ui(it.value()));
+
+    for (auto it = reg.widget_tooltips.cbegin(); it != reg.widget_tooltips.cend(); ++it)
+        it.key()->setToolTip(tr_ui(it.value()));
+}
+
+}
