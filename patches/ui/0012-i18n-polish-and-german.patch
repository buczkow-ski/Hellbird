+
+struct LocalizationRegistry {
+    QHash<QAction*, QString> action_texts;
+    QHash<QAction*, QString> action_tooltips;
+    QHash<QMenu*, QString> menu_titles;
+    QHash<QLabel*, QString> label_texts;
+    QHash<QAbstractButton*, QString> button_texts;
+    QHash<QLineEdit*, QString> placeholders;
+    QHash<QWidget*, QString> widget_tooltips;
+    Optional<WebView::InterfaceLanguage> last_refreshed_language;
+};
+
+LocalizationRegistry& registry()
+{
+    static auto* s_registry = new LocalizationRegistry;
+    return *s_registry;
+}
+
+template<typename Object>
+void bind_entry(QHash<Object*, QString>& map, Object& object, QString const& source)
+{
+    bool is_new = !map.contains(&object);
+    map.insert(&object, source);
+    if (is_new) {
+        QObject::connect(&object, &QObject::destroyed, [&map, ptr = &object]() {
+            map.remove(ptr);
+        });
+    }
+}
+
+QString strip_mnemonic(QString const& text)
+{
+    QString result;
+    result.reserve(text.size());
+    for (qsizetype i = 0; i < text.size(); ++i) {
+        if (text[i] == QLatin1Char('&')) {
+            if (i + 1 < text.size() && text[i + 1] == QLatin1Char('&')) {
+                result.append(QLatin1Char('&'));
+                ++i;
+            }
+            continue;
+        }
+        result.append(text[i]);
+    }
+    return result;
+}
