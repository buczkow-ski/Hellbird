--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -1816,6 +1816,14 @@ void Application::launch_spare_web_content_process()
     if (browser_options().profile_helper_process == ProcessType::WebContent)
         return;
 
+    // On memory-constrained machines (<= 8 GiB RAM), keeping an idle spare WebContent process around wastes
+    // ~30-50 MiB of committed memory for marginal tab-open latency benefit. Keep it enabled in test mode so
+    // upstream spare-process tests remain deterministic on 8 GiB CI/dev machines.
+    if (m_web_content_options.is_test_mode == IsTestMode::No) {
+        if (auto physical_memory = Core::System::physical_memory_bytes(); physical_memory > 0 && physical_memory <= 8 * GiB)
+            return;
+    }
+
     if (m_spare_web_content_process || m_has_queued_task_to_launch_spare_web_content_process)
         return;
     m_has_queued_task_to_launch_spare_web_content_process = true;
