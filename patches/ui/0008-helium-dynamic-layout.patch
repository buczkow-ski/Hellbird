+void WindowToolbar::set_dynamic_layout(bool dynamic_layout, bool centered_address_bar)
+{
+    if (m_dynamic_layout == dynamic_layout && m_centered_address_bar == centered_address_bar)
+        return;
+    m_dynamic_layout = dynamic_layout;
+    m_centered_address_bar = centered_address_bar;
+    if (m_arrangement == ToolbarArrangement::Row) {
+        delete m_toolbar->layout();
+        lay_out_as_row();
+        set_window_controls_visible(m_window_controls_visible);
+        update_field_panel();
+    }
+}
+
+void WindowToolbar::set_dynamic_new_tab_action(QAction* action)
+{
+    if (!m_dynamic_new_tab_button || !action)
+        return;
+    QObject::disconnect(m_dynamic_new_tab_button, &QToolButton::clicked, nullptr, nullptr);
+    QObject::connect(m_dynamic_new_tab_button, &QToolButton::clicked, action, &QAction::trigger);
+    m_dynamic_new_tab_button->setToolTip(qformatted("New Tab  {}", action->shortcut().toString(QKeySequence::NativeText)));
+}
+
+void WindowToolbar::set_dynamic_tabs_below(bool below)
+{
+    if (property("dynamicTabsBelow").toBool() == below)
+        return;
+    setProperty("dynamicTabsBelow", below);
+    style()->unpolish(this);
+    style()->polish(this);
+    update();
+}
