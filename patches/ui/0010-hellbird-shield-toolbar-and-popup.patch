+// A tab that hasn't loaded has no page for anything to be blocked on.
+// NB: The Hub reports how a page is blocked, some time after the settings change here. What the settings turned off or
+//     paused shows right away, and so does what they resumed. Blocking that the Hub reports as off altogether stays off
+//     until it says otherwise, as the command line can turn it off too.
+WebView::ContentBlockingSnapshot WindowToolbar::content_blocking_of_tab() const
+{
+    if (!m_tab || !m_tab->is_loaded())
+        return {};
+    auto blocking = m_tab->view().content_blocking_snapshot();
+    if (!blocking.site.has_value() || blocking.state == WebView::ContentBlockingState::Disabled)
+        return blocking;
+    auto const& settings = Application::settings();
+    if (!settings.content_blocker_enabled())
+        blocking.state = WebView::ContentBlockingState::Disabled;
+    else if (!settings.content_blocker_enabled_for_site(*blocking.site))
+        blocking.state = WebView::ContentBlockingState::SiteDisabled;
+    else if (blocking.state == WebView::ContentBlockingState::SiteDisabled)
+        blocking.state = WebView::ContentBlockingState::Enabled;
+    return blocking;
+}
+
+void WindowToolbar::update_shield_button()
+{
+    auto blocking = content_blocking_of_tab();
+    m_shield_button->set_content_blocking(blocking, Application::settings().content_blocker_enabled());
+
+    if (m_shield_popover && m_shield_popover->isVisible())
+        show_content_blocking_in_popover(blocking);
+}
+
+void WindowToolbar::show_content_blocking_in_popover(WebView::ContentBlockingSnapshot const& blocking)
+{
+    m_shield_popover_site = blocking.site;
+    m_shield_popover->set_page(blocking, Application::settings().content_blocker_enabled());
+    m_shield_popover->fit_to_contents();
+    move_popover_to_button(*m_shield_popover, *m_shield_button);
+}
+
+void WindowToolbar::show_shield_popover()
+{
+    if (!m_shield_popover) {
+        m_shield_popover = new ShieldPopover(this, Application::settings());
+        m_shield_popover->on_visibility_change = [this](bool visible) {
+            m_shield_button->setChecked(visible);
+        };
+        m_shield_popover->on_toggle_site = [this](bool enabled) {
+            toggle_protection_on_site(enabled);
+        };
+        m_shield_popover->on_open_filter_lists = [this] {
+            browser_window().new_tab_from_url(URL::Parser::basic_parse("about:settings#blocking"sv).release_value(), Web::HTML::ActivateTab::Yes, BrowserWindow::TabLocation::after_current_tab());
+        };
+    }
+
+    m_shield_popover->update_chrome_style(palette());
+    m_shield_popover->clear_filter_feedback();
+    show_content_blocking_in_popover(content_blocking_of_tab());
+    m_shield_popover->show();
+    move_popover_to_button(*m_shield_popover, *m_shield_button);
+    m_shield_popover->raise();
+}
+
+// The page is loaded again, as what was blocked on it, or let through, stays so until then.
+void WindowToolbar::toggle_protection_on_site(bool enabled)
+{
+    auto blocking = content_blocking_of_tab();
+    // NB: The tab may have moved on to another site since the popover last caught up with it.
+    if (!blocking.can_toggle() || blocking.site != m_shield_popover_site) {
+        update_shield_button();
+        return;
+    }
+    if (Application::settings().set_content_blocker_enabled_for_site(*blocking.site, enabled).is_error())
+        return;
+    m_tab->view().reload();
+}
