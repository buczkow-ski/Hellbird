+// The round button that pauses and resumes protection on the site: a power symbol on the accent while the site is
+// protected, and on a quiet surface while it is not.
+class ShieldPowerButton final : public QPushButton {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit ShieldPowerButton(QWidget* parent)
+        : QPushButton(parent)
+    {
+        setObjectName("LadybirdShieldPowerButton");
+        setFixedSize(POWER_BUTTON_SIZE, POWER_BUTTON_SIZE);
+        setAttribute(Qt::WA_LayoutUsesWidgetRect);
+        setAttribute(Qt::WA_Hover);
+        // NB: A click does not focus the button, so only the keyboard's focus is ringed.
+        setFocusPolicy(Qt::TabFocus);
+    }
+
+    virtual QSize sizeHint() const override { return { POWER_BUTTON_SIZE, POWER_BUTTON_SIZE }; }
+
+    void set_protecting(bool protecting)
+    {
+        if (m_protecting == protecting)
+            return;
+        m_protecting = protecting;
+        update();
+    }
+
+private:
+    static constexpr qreal CIRCLE_INSET = 7;
+    static constexpr qreal SYMBOL_RADIUS = 13;
+    static constexpr qreal SYMBOL_LINE_WIDTH = 3.5;
+    static constexpr int SYMBOL_GAP_DEGREES = 80;
+
+    QRectF circle_rect() const { return QRectF(rect()).adjusted(CIRCLE_INSET, CIRCLE_INSET, -CIRCLE_INSET, -CIRCLE_INSET); }
+
+    virtual bool hitButton(QPoint const& position) const override
+    {
+        auto circle = circle_rect();
+        auto offset = QPointF(position) - circle.center();
+        auto radius = circle.width() / 2;
+        return (offset.x() * offset.x()) + (offset.y() * offset.y()) <= radius * radius;
+    }
+
+    virtual void paintEvent(QPaintEvent*) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing, true);
+        auto const& panel = Theme::panel();
+        auto circle = circle_rect();
+        auto hovered = isEnabled() && underMouse();
+        auto pressed = isEnabled() && isDown();
+
+        // A button that can't be clicked fades, so it doesn't look as though it could.
+        if (!isEnabled())
+            painter.setOpacity(0.55);
+
+        QColor symbol_color;
+        if (m_protecting) {
+            auto glow = Theme::accent();
+            glow.setAlpha(pressed ? 36 : (hovered ? 84 : 56));
+            painter.setPen(Qt::NoPen);
+            painter.setBrush(glow);
+            painter.drawEllipse(QRectF(rect()).adjusted(1, 1, -1, -1));
+
+            auto fill = Theme::accent_fill();
+            if (pressed)
+                fill = fill.darker(115);
+            else if (hovered)
+                fill = ChromeStyle::mix(fill, QColor(Qt::white), 0.08);
+            painter.setBrush(fill);
+            painter.drawEllipse(circle);
+            symbol_color = Qt::white;
+        } else {
+            painter.setPen(QPen(panel.separator, 1));
+            painter.setBrush(pressed || hovered ? panel.pressed : panel.control);
+            painter.drawEllipse(circle.adjusted(0.5, 0.5, -0.5, -0.5));
+            symbol_color = hovered ? panel.text : panel.muted;
+        }
+
+        // The power symbol is a circle that is open at the top, with a bar through the opening. Qt measures an arc in
+        // sixteenths of a degree, counterclockwise from three o'clock.
+        painter.setBrush(Qt::NoBrush);
+        painter.setPen(QPen(symbol_color, SYMBOL_LINE_WIDTH, Qt::SolidLine, Qt::RoundCap));
+        auto center = circle.center();
+        QRectF symbol(center.x() - SYMBOL_RADIUS, center.y() - SYMBOL_RADIUS, 2 * SYMBOL_RADIUS, 2 * SYMBOL_RADIUS);
+        painter.drawArc(symbol, (90 + (SYMBOL_GAP_DEGREES / 2)) * 16, (360 - SYMBOL_GAP_DEGREES) * 16);
+        painter.drawLine(QPointF(center.x(), center.y() - SYMBOL_RADIUS - 2), QPointF(center.x(), center.y() - 1));
+
+        if (hasFocus()) {
+            painter.setOpacity(1);
+            ChromeStyle::paint_focus_ring(painter, circle, circle.width() / 2);
+        }
+    }
+
+    bool m_protecting { false };
+};
