+static QLabel* create_label(QWidget& parent, char const* object_name, QString const& text = {})
+{
+    auto* label = new QLabel(&parent);
+    label->setObjectName(QString::fromLatin1(object_name));
+    label->setTextFormat(Qt::PlainText);
+    label->setText(text);
+    return label;
+}
+
+static void add_separator(QWidget& parent, QVBoxLayout& layout, int margin)
+{
+    layout.addSpacing(margin);
+    auto* separator = new QFrame(&parent);
+    separator->setObjectName("LadybirdPopoverSeparator");
+    separator->setFixedHeight(1);
+    layout.addWidget(separator);
+    layout.addSpacing(margin);
+}
+
+// A tile with a number, and what it counts below it.
+static QLabel* add_stat_tile(QWidget& parent, QHBoxLayout& layout, QString const& caption)
+{
+    auto* tile = new QFrame(&parent);
+    tile->setObjectName("LadybirdShieldStat");
+    tile->setFixedHeight(58);
+    auto* tile_layout = new QVBoxLayout(tile);
+    tile_layout->setContentsMargins(12, 7, 12, 7);
+    tile_layout->setSpacing(0);
+    auto* value = create_label(*tile, "LadybirdShieldStatValue", "0");
+    tile_layout->addWidget(value);
+    tile_layout->addWidget(create_label(*tile, "LadybirdShieldDetail", caption));
+    layout.addWidget(tile, 1);
+    return value;
+}
+
+// A style sheet's rules for a property apply once the widget that has it is polished again.
+static void set_style_property(QWidget& widget, char const* name, QString const& value)
+{
+    if (widget.property(name).toString() == value)
+        return;
+    widget.setProperty(name, value);
+    widget.style()->unpolish(&widget);
+    widget.style()->polish(&widget);
+}
