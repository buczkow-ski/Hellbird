+    header_text->setSpacing(1);
+    header_text->addWidget(create_label(card(), "LadybirdShieldTitle", "Hellbird Shield"));
+    m_site_label = new ElidedLabel({}, Qt::ElideMiddle, &card());
+    m_site_label->setObjectName("LadybirdShieldDetail");
+    header_text->addWidget(m_site_label);
+    header->addLayout(header_text, 1);
+    m_status_badge = create_label(card(), "LadybirdShieldStatus");
+    m_status_badge->setAlignment(Qt::AlignCenter);
+    header->addWidget(m_status_badge, 0, Qt::AlignVCenter);
+    layout->addLayout(header);
+
+    add_separator(card(), *layout, 10);
+
+    // Whether the site is protected.
+    m_power_button = new ShieldPowerButton(&card());
+    QObject::connect(m_power_button, &QPushButton::clicked, this, [this] {
+        if (on_toggle_site)
