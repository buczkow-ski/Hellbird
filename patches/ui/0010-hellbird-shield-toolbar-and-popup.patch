+void ShieldPopover::set_page(WebView::ContentBlockingSnapshot const& blocking, bool protection_enabled)
+{
+    auto host = blocking.site.has_value() ? qstring_from_ak_string(*blocking.site) : QString {};
+    m_is_protecting = blocking.enabled();
+
+    QString status;
+    QString status_style;
+    QString caption;
+    switch (blocking.state) {
+    case WebView::ContentBlockingState::Enabled:
+        status = QStringLiteral("Active");
+        status_style = QStringLiteral("active");
+        caption = QStringLiteral("Protection active on %1").arg(host);
+        break;
+    case WebView::ContentBlockingState::NoRules:
+        status = QStringLiteral("Active");
+        status_style = QStringLiteral("active");
+        caption = QStringLiteral("No filter lists are loaded yet");
+        break;
+    case WebView::ContentBlockingState::SiteDisabled:
+        status = QStringLiteral("Paused");
+        status_style = QStringLiteral("paused");
+        caption = QStringLiteral("Paused on %1 \u2014 click to resume").arg(host);
+        break;
+    case WebView::ContentBlockingState::Disabled:
+    case WebView::ContentBlockingState::Unavailable:
+        status_style = QStringLiteral("off");
+        if (blocking.state == WebView::ContentBlockingState::Unavailable && protection_enabled) {
+            status = QStringLiteral("Standby");
+            caption = QStringLiteral("Standby on internal page");
+        } else {
+            status = QStringLiteral("Off");
+            caption = QStringLiteral("Protection disabled globally");
+        }
+        break;
+    }
+
+    m_site_label->setText(host.isEmpty() ? QStringLiteral("Not a website") : host);
+    m_site_label->setToolTip(host);
+    m_status_badge->setText(status);
+    set_style_property(*m_status_badge, "shieldState", status_style);
+    m_caption->setText(caption);
+    m_caption->setToolTip(caption);
+
+    auto can_toggle = blocking.can_toggle();
+    m_power_button->set_protecting(m_is_protecting);
+    m_power_button->setEnabled(can_toggle);
+    m_power_button->setCursor(can_toggle ? Qt::PointingHandCursor : Qt::ArrowCursor);
+    auto action = caption;
+    if (can_toggle)
+        action = (m_is_protecting ? QStringLiteral("Pause protection on %1") : QStringLiteral("Resume protection on %1")).arg(host);
+    m_power_button->setToolTip(action);
+    m_power_button->setAccessibleName(action);
+
+    {
+        QSignalBlocker blocker(m_global_switch);
+        m_global_switch->setChecked(m_settings.content_blocker_enabled());
+    }
+
+    // What was blocked is only listed while content blocking is on.
+    Vector<BlockedHost> blocked_hosts;
+    size_t blocked_count = 0;
+    if (m_is_protecting) {
+        blocked_hosts = group_by_host(blocking.blocked_resources);
+        blocked_count = blocking.blocked_resources.size();
+    }
+    m_blocked_count->setText(QString::number(blocked_count));
+    m_domain_count->setText(QString::number(blocked_hosts.size()));
+    m_empty_label->setText(m_is_protecting
+            ? QStringLiteral("No trackers or ads blocked on this page yet.")
+            : QStringLiteral("Nothing is being blocked on this page."));
+    set_blocked_hosts(AK::move(blocked_hosts));
+    update_icons();
+}
+
+// The hosts with the most blocked on the page come first.
+Vector<ShieldPopover::BlockedHost> ShieldPopover::group_by_host(Vector<WebView::BlockedResource> const& resources)
+{
+    Vector<BlockedHost> hosts;
+    HashMap<String, size_t> index_by_host;
+    for (auto const& resource : resources) {
+        auto index = index_by_host.get(resource.host).value_or(hosts.size());
+        if (index == hosts.size()) {
+            index_by_host.set(resource.host, index);
+            hosts.append({ .host = qstring_from_ak_string(resource.host), .kinds = {}, .count = 0 });
+        }
+        auto& host = hosts[index];
+        ++host.count;
+        auto kind = qstring_from_ak_string(resource.kind).toLower();
+        if (!host.kinds.contains(kind))
+            host.kinds.append(kind);
+    }
+    quick_sort(hosts, [](BlockedHost const& a, BlockedHost const& b) {
+        if (a.count != b.count)
+            return a.count > b.count;
+        return a.host < b.host;
+    });
+    return hosts;
+}
+
+void ShieldPopover::set_blocked_hosts(Vector<BlockedHost> blocked_hosts)
+{
+    // NB: What is shown is hidden first, so that the popover never has to fit both.
+    (blocked_hosts.is_empty() ? static_cast<QWidget*>(m_blocked_scroll) : m_empty_label)->hide();
+    (blocked_hosts.is_empty() ? static_cast<QWidget*>(m_empty_label) : m_blocked_scroll)->show();
+
+    // NB: The rows are left alone while what they show is the same, so that they keep their hover and scroll position.
+    if (m_blocked_hosts == blocked_hosts)
+        return;
+    m_blocked_hosts = AK::move(blocked_hosts);
+
+    // The rows go once the event loop is back, as one of them may be handling a press.
+    while (auto* item = m_blocked_rows->takeAt(0)) {
+        if (auto* widget = item->widget()) {
+            widget->hide();
+            widget->deleteLater();
+        }
+        delete item;
+    }
+
+    auto& rows = *m_blocked_scroll->widget();
+    for (auto const& blocked : m_blocked_hosts) {
+        auto kinds = blocked.kinds.join(QStringLiteral(", "));
+
+        auto* row = new QPushButton(&rows);
+        row->setObjectName("LadybirdPopoverRow");
+        row->setFixedHeight(BLOCKED_HOST_ROW_HEIGHT);
+        row->setAttribute(Qt::WA_LayoutUsesWidgetRect);
+        row->setFocusPolicy(Qt::TabFocus);
+        row->setToolTip(QStringLiteral("%1 (%2)\nClick to write a filter for it").arg(blocked.host, kinds));
+        row->setAccessibleName(QStringLiteral("%1, %2 blocked: %3").arg(blocked.host, QString::number(blocked.count), kinds));
+        auto* row_layout = new QHBoxLayout(row);
+        row_layout->setContentsMargins(8, 0, 8, 0);
+        row_layout->setSpacing(8);
+
+        auto* host_label = new ElidedLabel(blocked.host, Qt::ElideMiddle, row);
+        host_label->setObjectName("LadybirdShieldHost");
+        host_label->setAttribute(Qt::WA_TransparentForMouseEvents);
+        row_layout->addWidget(host_label, 3);
+        auto* kinds_label = new ElidedLabel(kinds, Qt::ElideRight, row);
+        kinds_label->setObjectName("LadybirdShieldDetail");
+        kinds_label->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+        kinds_label->setAttribute(Qt::WA_TransparentForMouseEvents);
+        row_layout->addWidget(kinds_label, 2);
+        auto* count_label = create_label(*row, "LadybirdShieldHostCount", QString::number(blocked.count));
+        count_label->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+        count_label->setMinimumWidth(14);
+        count_label->setAttribute(Qt::WA_TransparentForMouseEvents);
+        row_layout->addWidget(count_label);
+
+        QObject::connect(row, &QPushButton::clicked, this, [this, host = blocked.host] {
+            clear_filter_feedback();
+            m_filter_field->setText(QStringLiteral("||%1^").arg(host));
+            m_filter_field->setFocus(Qt::OtherFocusReason);
+        });
+        m_blocked_rows->addWidget(row);
+    }
+    fit_blocked_list();
+}
+
+// The list grows with what it lists, up to a limit that leaves room for the rest of the popover on a low screen.
+void ShieldPopover::fit_blocked_list()
+{
+    auto max_height = BLOCKED_LIST_MAX_HEIGHT;
+    if (auto const* popover_screen = screen())
+        max_height = clamp(popover_screen->availableGeometry().height() - HEIGHT_BESIDES_BLOCKED_LIST, BLOCKED_LIST_MIN_HEIGHT, BLOCKED_LIST_MAX_HEIGHT);
+    auto list_height = static_cast<int>(m_blocked_hosts.size()) * BLOCKED_HOST_ROW_HEIGHT;
+    m_blocked_scroll->setFixedHeight(min(list_height, max_height));
+}
+
+void ShieldPopover::fit_to_contents()
+{
+    fit_blocked_list();
+    card().layout()->activate();
+    layout()->activate();
+    adjustSize();
+}
+
+void ShieldPopover::add_custom_filter()
+{
+    auto filter = ak_string_from_qstring(m_filter_field->text().trimmed());
+    if (filter.is_empty())
+        return;
+
+    auto const& filters = m_settings.custom_content_blocker_filters();
+    for (auto line : filters.bytes_as_string_view().split_view('\n')) {
+        if (line.trim_whitespace() == filter.bytes_as_string_view()) {
+            show_filter_feedback(QStringLiteral("Rule already exists"), FeedbackTone::Failure);
+            return;
+        }
+    }
+
+    StringBuilder builder;
+    builder.append(filters);
+    if (!filters.is_empty() && !filters.bytes_as_string_view().ends_with('\n'))
+        builder.append('\n');
+    builder.append(filter);
+    if (builder.length() > MAX_CUSTOM_FILTERS_SIZE) {
+        show_filter_feedback(QStringLiteral("Custom filters are full"), FeedbackTone::Failure);
+        return;
+    }
+
+    m_settings.set_custom_content_blocker_filters(MUST(builder.to_string()));
+    m_filter_field->clear();
+    show_filter_feedback(QStringLiteral("Rule added"), FeedbackTone::Success);
+}
+
+void ShieldPopover::show_filter_feedback(QString const& text, FeedbackTone tone)
+{
+    m_filter_feedback->setText(text);
+    set_style_property(*m_filter_feedback, "failed", tone == FeedbackTone::Failure ? QStringLiteral("true") : QStringLiteral("false"));
+    m_filter_feedback_timer->start();
+}
+
+void ShieldPopover::clear_filter_feedback()
+{
+    m_filter_feedback_timer->stop();
+    m_filter_feedback->clear();
+}
+
+void ShieldPopover::update_chrome_style(QPalette const& palette)
+{
+    setPalette(palette);
+    setStyleSheet(ChromeStyle::shield_popover_style_sheet(palette));
+    // NB: The popover is kept for its window, so its icons are drawn again in the colors of the current theme.
+    update_icons();
+    m_power_button->update();
+}
+
+void ShieldPopover::update_icons()
+{
+    auto color = m_is_protecting ? Theme::accent() : Theme::panel().muted;
+    m_icon->setPixmap(create_chrome_icon(ChromeIcon::ContentBlocking, color).pixmap(QSize(HEADER_ICON_SIZE, HEADER_ICON_SIZE), devicePixelRatioF()));
+}
+
+}
