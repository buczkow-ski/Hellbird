+// The shield button tells how much the content blocker kept the page from loading, and opens the shield's popover. While
+// protection is paused on the site or off, the shield is dimmed and struck through.
+class ShieldButton final : public ToolbarButton {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit ShieldButton(QWidget* parent)
+        : ToolbarButton(parent)
+    {
+        setObjectName("LadybirdShieldButton");
+        setToolTip("Hellbird Shield");
+        setAccessibleName("Hellbird Shield");
+        // NB: The button stays checked while the popover is open.
+        setCheckable(true);
+        setAutoRaise(true);
+        setFocusPolicy(Qt::NoFocus);
+        setIconSize({ TOOLBAR_ICON_SIZE, TOOLBAR_ICON_SIZE });
+        setFixedSize(TOOLBAR_BUTTON_SIZE);
+        setAttribute(Qt::WA_LayoutUsesWidgetRect);
+    }
+
+    // Whether protection is enabled at all is told apart from the state, which a page that is not from a website leaves
+    // unavailable either way.
+    void set_content_blocking(WebView::ContentBlockingSnapshot const& blocking, bool protection_enabled)
+    {
+        auto host = blocking.site.has_value() ? qstring_from_ak_string(*blocking.site) : QString {};
+        auto blocked_count = blocking.enabled() ? blocking.blocked_resources.size() : 0;
+        auto is_dimmed = false;
+        auto description = QStringLiteral("Hellbird Shield");
+        switch (blocking.state) {
+        case WebView::ContentBlockingState::Enabled:
+        case WebView::ContentBlockingState::NoRules:
+            if (blocked_count > 0) {
+                description = host.isEmpty()
+                    ? QStringLiteral("Hellbird Shield \u2014 %1 blocked").arg(QString::number(blocked_count))
+                    : QStringLiteral("Hellbird Shield \u2014 %1 blocked on %2").arg(QString::number(blocked_count), host);
+            }
+            break;
+        case WebView::ContentBlockingState::SiteDisabled:
+            is_dimmed = true;
+            description = QStringLiteral("Hellbird Shield \u2014 Paused on %1").arg(host);
+            break;
+        case WebView::ContentBlockingState::Disabled:
+        case WebView::ContentBlockingState::Unavailable:
+            if (blocking.state == WebView::ContentBlockingState::Disabled || !protection_enabled) {
+                is_dimmed = true;
+                description = QStringLiteral("Hellbird Shield \u2014 Disabled");
+            }
+            break;
+        }
+
+        if (toolTip() != description) {
+            setToolTip(description);
+            setAccessibleName(description);
+        }
+        if (m_blocked_count == blocked_count && m_is_dimmed == is_dimmed)
+            return;
+        m_blocked_count = blocked_count;
+        m_is_dimmed = is_dimmed;
+        update();
+    }
+
+private:
+    virtual void paintEvent(QPaintEvent*) override
+    {
+        QPainter painter(this);
+        ChromeStyle::paint_control_frame(painter, *this);
+
+        auto palette = Theme::chrome_palette(*this);
+        auto const& chrome = Theme::chrome(palette);
+
+        // NB: The shield's icon is as quiet at rest as the icons inside the address field. A shield that is up is drawn
+        //     like the toolbar's other icons instead.
+        auto mode = icon_mode();
+        if (mode == QIcon::Normal && !m_is_dimmed && ChromeStyle::window_activity(*this) == ChromeStyle::WindowActivity::Active)
+            mode = QIcon::Active;
+        painter.setOpacity(m_is_dimmed ? DIMMED_OPACITY : 1.0);
+        icon().paint(&painter, icon_rect(), Qt::AlignCenter, mode);
+        painter.setRenderHint(QPainter::Antialiasing, true);
+        if (m_is_dimmed) {
+            auto strike = QRectF(icon_rect()).adjusted(2.5, 2.5, -3.5, -3.5);
+            painter.setPen(QPen(chrome.icon, 1.5, Qt::SolidLine, Qt::RoundCap));
+            painter.drawLine(strike.topLeft(), strike.bottomRight());
+            return;
+        }
+        if (m_blocked_count == 0)
+            return;
+
+        auto text = m_blocked_count > MAX_SHOWN_COUNT ? QStringLiteral("99+") : QString::number(m_blocked_count);
+        auto badge_font = font();
+        badge_font.setPixelSize(BADGE_FONT_SIZE);
+        badge_font.setWeight(QFont::Bold);
+        auto badge_width = max(BADGE_HEIGHT, QFontMetrics(badge_font).horizontalAdvance(text) + (2 * BADGE_HORIZONTAL_PADDING));
+        QRectF badge(width() - badge_width - BADGE_MARGIN, height() - BADGE_HEIGHT - BADGE_MARGIN, badge_width, BADGE_HEIGHT);
+
+        // NB: An outline in the color of what is below sets the badge apart from the shield, which it overlaps.
+        auto is_in_sidebar = parentWidget() && parentWidget()->objectName() == QLatin1StringView("LadybirdSidebarFooter");
+        auto outline = badge.adjusted(-BADGE_OUTLINE, -BADGE_OUTLINE, BADGE_OUTLINE, BADGE_OUTLINE);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(is_in_sidebar ? chrome.sidebar : chrome.toolbar);
+        painter.drawRoundedRect(outline, outline.height() / 2, outline.height() / 2);
+        painter.setBrush(Theme::accent_fill());
+        painter.drawRoundedRect(badge, badge.height() / 2, badge.height() / 2);
+
+        painter.setFont(badge_font);
+        painter.setPen(Qt::white);
+        painter.drawText(badge, Qt::AlignCenter, text);
+    }
+
+    static constexpr qreal DIMMED_OPACITY = 0.42;
+    static constexpr size_t MAX_SHOWN_COUNT = 99;
+    static constexpr int BADGE_FONT_SIZE = 9;
+    static constexpr int BADGE_HEIGHT = 12;
+    static constexpr int BADGE_HORIZONTAL_PADDING = 3;
+    static constexpr int BADGE_MARGIN = 1;
+    static constexpr qreal BADGE_OUTLINE = 1;
+
+    size_t m_blocked_count { 0 };
+    bool m_is_dimmed { false };
+};
