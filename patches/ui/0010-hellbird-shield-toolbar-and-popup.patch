+
+// What the content blocker did on the page, and the controls for pausing it on the site, turning it off everywhere, and
+// adding a filter.
+class ShieldPopover final : public Popover {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    ShieldPopover(QWidget* parent, WebView::Settings&);
+
+    // Whether protection is enabled at all is told apart from the snapshot's state, which a page that is not from a
+    // website leaves unavailable either way.
+    void set_page(WebView::ContentBlockingSnapshot const&, bool protection_enabled);
+    void clear_filter_feedback();
+    void fit_to_contents();
+    void update_chrome_style(QPalette const&);
+
+    Function<void(bool)> on_toggle_site;
+    Function<void()> on_open_filter_lists;
+
+private:
+    struct BlockedHost {
+        QString host;
+        QStringList kinds;
+        size_t count { 0 };
+
+        bool operator==(BlockedHost const&) const = default;
+    };
+    static Vector<BlockedHost> group_by_host(Vector<WebView::BlockedResource> const&);
+
+    enum class FeedbackTone : u8 {
+        Success,
+        Failure,
+    };
+
+    void set_blocked_hosts(Vector<BlockedHost>);
+    void fit_blocked_list();
+    void add_custom_filter();
+    void show_filter_feedback(QString const&, FeedbackTone);
+    void update_icons();
+
+    WebView::Settings& m_settings;
+    Vector<BlockedHost> m_blocked_hosts;
+    bool m_is_protecting { false };
+
+    QLabel* m_icon { nullptr };
+    ElidedLabel* m_site_label { nullptr };
+    QLabel* m_status_badge { nullptr };
+    ShieldPowerButton* m_power_button { nullptr };
+    ElidedLabel* m_caption { nullptr };
+    QLabel* m_blocked_count { nullptr };
+    QLabel* m_domain_count { nullptr };
+    QLabel* m_empty_label { nullptr };
+    QScrollArea* m_blocked_scroll { nullptr };
+    QVBoxLayout* m_blocked_rows { nullptr };
+    QLineEdit* m_filter_field { nullptr };
+    QLabel* m_filter_feedback { nullptr };
+    QTimer* m_filter_feedback_timer { nullptr };
+    PopoverSwitch* m_global_switch { nullptr };
+};
+
+}
