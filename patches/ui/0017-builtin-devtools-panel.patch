+void DevToolsPanel::build_console_tab()
+{
+    auto* page = new QWidget(m_stack);
+    auto* layout = new QVBoxLayout(page);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(0);
+
+    auto* toolbar = new QWidget(page);
+    toolbar->setObjectName(QStringLiteral("HellbirdDevToolsSubBar"));
+    auto* tb = new QHBoxLayout(toolbar);
+    tb->setContentsMargins(6, 4, 6, 4);
+    tb->setSpacing(6);
+
+    auto* clear_btn = new QPushButton(toolbar);
+    bind_localized_text(*clear_btn, QStringLiteral("Clear"));
+    connect(clear_btn, &QPushButton::clicked, this, &DevToolsPanel::clear_console);
+    tb->addWidget(clear_btn);
+
+    m_console_filter_edit = new QLineEdit(toolbar);
+    m_console_filter_edit->setClearButtonEnabled(true);
+    bind_localized_placeholder(*m_console_filter_edit, QStringLiteral("Filter console output"));
+    connect(m_console_filter_edit, &QLineEdit::textChanged, this, &DevToolsPanel::apply_console_filter);
+    tb->addWidget(m_console_filter_edit, 1);
+
+    m_console_level_combo = new QComboBox(toolbar);
+    m_console_level_combo->addItem(tr_ui("All"), static_cast<int>(ConsoleFilter::All));
+    m_console_level_combo->addItem(tr_ui("Errors"), static_cast<int>(ConsoleFilter::Errors));
+    m_console_level_combo->addItem(tr_ui("Warnings"), static_cast<int>(ConsoleFilter::Warnings));
+    m_console_level_combo->addItem(tr_ui("Info"), static_cast<int>(ConsoleFilter::Info));
+    m_console_level_combo->addItem(tr_ui("Log"), static_cast<int>(ConsoleFilter::Log));
+    connect(m_console_level_combo, &QComboBox::currentIndexChanged, this, [this](int) {
+        apply_console_filter();
+    });
+    tb->addWidget(m_console_level_combo);
+    layout->addWidget(toolbar);
+
+    m_console_tree = new QTreeWidget(page);
+    m_console_tree->setHeaderHidden(true);
+    m_console_tree->setColumnCount(2);
+    m_console_tree->header()->setStretchLastSection(false);
+    m_console_tree->header()->setSectionResizeMode(0, QHeaderView::Stretch);
+    m_console_tree->header()->setSectionResizeMode(1, QHeaderView::ResizeToContents);
+    m_console_tree->setWordWrap(true);
+    m_console_tree->setIndentation(14);
+    m_console_tree->setFont(devtools_mono_font(12));
+    m_console_tree->setContextMenuPolicy(Qt::CustomContextMenu);
+    connect(m_console_tree, &QTreeWidget::itemExpanded, this, &DevToolsPanel::expand_console_object);
+    connect(m_console_tree, &QTreeWidget::customContextMenuRequested, this, [this](QPoint const& pos) {
+        auto* item = m_console_tree->itemAt(pos);
+        if (!item)
+            return;
+        auto copy_text = item->data(0, ConsoleCopyTextRole).toString();
+        if (copy_text.isEmpty())
+            copy_text = item->text(0);
+        QMenu menu(this);
+        auto* copy_action = menu.addAction(tr_ui("Copy message"));
+        connect(copy_action, &QAction::triggered, this, [copy_text] {
+            if (auto* clipboard = QApplication::clipboard())
+                clipboard->setText(copy_text);
+        });
+        menu.exec(m_console_tree->viewport()->mapToGlobal(pos));
+    });
+    layout->addWidget(m_console_tree, 1);
+
+    auto* prompt_bar = new QWidget(page);
+    prompt_bar->setObjectName(QStringLiteral("HellbirdDevToolsPromptBar"));
+    auto* prompt_layout = new QHBoxLayout(prompt_bar);
+    prompt_layout->setContentsMargins(8, 4, 8, 4);
+    prompt_layout->setSpacing(6);
+
+    auto* chevron = new QLabel(QStringLiteral("\u276f"), prompt_bar);
+    chevron->setFont(devtools_mono_font(12));
+    prompt_layout->addWidget(chevron);
+
+    m_console_input = new ConsolePromptEdit(prompt_bar);
+    m_console_input->setObjectName(QStringLiteral("HellbirdDevToolsConsoleInput"));
+    m_console_input->setFont(devtools_mono_font(12));
+    bind_localized_placeholder(*m_console_input, QStringLiteral("Evaluate JavaScript…"));
+    connect(m_console_input, &QLineEdit::returnPressed, this, &DevToolsPanel::submit_console_expression);
+    connect(m_console_input, &ConsolePromptEdit::complete_requested, this, &DevToolsPanel::request_console_completion);
+    connect(m_console_input, &ConsolePromptEdit::history_previous, this, [this] {
+        if (m_console_history.isEmpty())
+            return;
+        if (m_console_history_index < 0) {
+            m_console_draft = m_console_input->text();
+            m_console_history_index = static_cast<int>(m_console_history.size()) - 1;
+        } else if (m_console_history_index > 0) {
+            --m_console_history_index;
+        }
+        m_console_input->setText(m_console_history[m_console_history_index]);
+    });
+    connect(m_console_input, &ConsolePromptEdit::history_next, this, [this] {
+        if (m_console_history_index < 0)
+            return;
+        if (m_console_history_index + 1 < m_console_history.size()) {
+            ++m_console_history_index;
+            m_console_input->setText(m_console_history[m_console_history_index]);
+        } else {
+            m_console_history_index = -1;
+            m_console_input->setText(m_console_draft);
+        }
+    });
+    prompt_layout->addWidget(m_console_input, 1);
+    layout->addWidget(prompt_bar);
+
+    m_stack->addWidget(page);
+}
