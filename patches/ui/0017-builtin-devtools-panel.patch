+    m_breadcrumb_layout->addStretch(1);
+    dom_layout->addWidget(m_breadcrumb_bar);
+
+    // Right: Inspector sidebar (Styles, Computed, Layout)
+    m_inspector_tabs = new QTabWidget(m_elements_splitter);
+    m_inspector_tabs->setDocumentMode(true);
+
+    // Styles sub-tab
+    auto* styles_page = new QWidget(m_inspector_tabs);
+    auto* styles_layout = new QVBoxLayout(styles_page);
+    styles_layout->setContentsMargins(0, 0, 0, 0);
+    styles_layout->setSpacing(0);
+    auto* styles_bar = new QWidget(styles_page);
+    styles_bar->setObjectName(QStringLiteral("HellbirdDevToolsSubBar"));
+    auto* styles_bar_layout = new QHBoxLayout(styles_bar);
+    styles_bar_layout->setContentsMargins(6, 4, 6, 4);
+    m_styles_filter_edit = new QLineEdit(styles_bar);
+    m_styles_filter_edit->setClearButtonEnabled(true);
+    bind_localized_placeholder(*m_styles_filter_edit, QStringLiteral("Filter styles"));
+    connect(m_styles_filter_edit, &QLineEdit::textChanged, this, &DevToolsPanel::filter_styles_tree);
+    styles_bar_layout->addWidget(m_styles_filter_edit);
+    styles_layout->addWidget(styles_bar);
+
+    m_styles_tree = new QTreeWidget(styles_page);
+    m_styles_tree->setHeaderHidden(true);
+    m_styles_tree->setColumnCount(2);
+    m_styles_tree->header()->setStretchLastSection(true);
+    m_styles_tree->header()->setSectionResizeMode(0, QHeaderView::ResizeToContents);
+    m_styles_tree->setIndentation(12);
+    m_styles_tree->setFont(devtools_mono_font(12));
+    styles_layout->addWidget(m_styles_tree, 1);
+    m_inspector_tabs->addTab(styles_page, tr_ui("Styles"));
+
+    // Computed sub-tab
+    auto* computed_page = new QWidget(m_inspector_tabs);
+    auto* computed_layout = new QVBoxLayout(computed_page);
+    computed_layout->setContentsMargins(0, 0, 0, 0);
+    computed_layout->setSpacing(0);
+    auto* computed_bar = new QWidget(computed_page);
+    computed_bar->setObjectName(QStringLiteral("HellbirdDevToolsSubBar"));
+    auto* computed_bar_layout = new QHBoxLayout(computed_bar);
+    computed_bar_layout->setContentsMargins(6, 4, 6, 4);
+    m_computed_filter_edit = new QLineEdit(computed_bar);
+    m_computed_filter_edit->setClearButtonEnabled(true);
+    bind_localized_placeholder(*m_computed_filter_edit, QStringLiteral("Filter computed styles"));
+    connect(m_computed_filter_edit, &QLineEdit::textChanged, this, &DevToolsPanel::filter_computed_tree);
+    computed_bar_layout->addWidget(m_computed_filter_edit);
+    computed_layout->addWidget(computed_bar);
+
+    m_computed_tree = new QTreeWidget(computed_page);
+    m_computed_tree->setColumnCount(2);
+    m_computed_tree->setHeaderLabels({ tr_ui("Property"), tr_ui("Value") });
+    m_computed_tree->setRootIsDecorated(false);
+    m_computed_tree->header()->setStretchLastSection(true);
+    m_computed_tree->header()->setSectionResizeMode(0, QHeaderView::Interactive);
+    m_computed_tree->setColumnWidth(0, 150);
+    m_computed_tree->setFont(devtools_mono_font(12));
+    computed_layout->addWidget(m_computed_tree, 1);
+    m_inspector_tabs->addTab(computed_page, tr_ui("Computed"));
+
+    // Layout (Box Model) sub-tab
+    auto* layout_page = new QWidget(m_inspector_tabs);
+    auto* layout_vbox = new QVBoxLayout(layout_page);
+    layout_vbox->setContentsMargins(0, 0, 0, 0);
+    layout_vbox->setSpacing(0);
