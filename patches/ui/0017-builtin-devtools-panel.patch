+class BoxModelWidget final : public QWidget {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit BoxModelWidget(QWidget* parent = nullptr)
+        : QWidget(parent)
+    {
+        setMinimumHeight(188);
+        setMaximumHeight(210);
+    }
+
+    void set_layout_metrics(Optional<JsonObject> const& layout)
+    {
+        m_has_metrics = layout.has_value() && !layout->is_empty();
+        if (!m_has_metrics) {
+            update();
+            return;
+        }
+        auto num_str = [&](StringView key) -> QString {
+            auto val = layout->get_double_with_precision_loss(key);
+            if (!val.has_value())
+                return QStringLiteral("-");
+            auto rounded = qRound(*val * 10.0) / 10.0;
+            if (qAbs(rounded) < 0.05)
+                return QStringLiteral("-");
+            if (qAbs(rounded - qRound(rounded)) < 0.05)
+                return QString::number(qRound(rounded));
+            return QString::number(rounded, 'f', 1);
+        };
+        auto dim_str = [&](StringView key) -> QString {
+            if (auto s = layout->get_string(key); s.has_value())
+                return qstring_from_ak_string(*s);
+            if (auto d = layout->get_double_with_precision_loss(key); d.has_value())
+                return QString::number(qRound(*d));
+            return QStringLiteral("0");
+        };
+
+        m_margin = { num_str("margin-top"sv), num_str("margin-right"sv), num_str("margin-bottom"sv), num_str("margin-left"sv) };
+        m_border = { num_str("border-top-width"sv), num_str("border-right-width"sv), num_str("border-bottom-width"sv), num_str("border-left-width"sv) };
+        m_padding = { num_str("padding-top"sv), num_str("padding-right"sv), num_str("padding-bottom"sv), num_str("padding-left"sv) };
+        m_content_size = QStringLiteral("%1 \u00d7 %2").arg(dim_str("width"sv), dim_str("height"sv));
+        update();
+    }
+
+protected:
+    virtual void paintEvent(QPaintEvent*) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+
+        auto const& panel = Theme::panel();
+        auto dark = Theme::is_dark();
+
+        if (!m_has_metrics) {
+            p.setPen(panel.muted);
+            p.drawText(rect(), Qt::AlignCenter, tr_ui("No box model metrics for this node"));
+            return;
+        }
+
+        auto outer = rect().adjusted(10, 8, -10, -8);
+        if (outer.width() < 160 || outer.height() < 120)
+            return;
+
+        QColor margin_bg = dark ? QColor(0x52, 0x3b, 0x22) : QColor(0xf9, 0xcc, 0x9d);
+        QColor border_bg = dark ? QColor(0x57, 0x4d, 0x24) : QColor(0xfd, 0xdd, 0x9b);
+        QColor padding_bg = dark ? QColor(0x28, 0x4b, 0x32) : QColor(0xc3, 0xd0, 0x8b);
+        QColor content_bg = dark ? QColor(0x24, 0x46, 0x62) : QColor(0x8c, 0xb6, 0xc0);
+        QColor ink = dark ? QColor(0xf2, 0xf2, 0xf2) : QColor(0x1f, 0x1f, 0x1f);
+        QColor edge = dark ? QColor(255, 255, 255, 60) : QColor(0, 0, 0, 70);
+
+        auto label_font = devtools_mono_font(10);
+        auto value_font = devtools_mono_font(11);
+
+        auto draw_layer = [&](QRect const& r, QColor const& fill, QString const& label, Array<QString, 4> const& sides, Qt::PenStyle border_style) {
+            p.setBrush(fill);
+            p.setPen(QPen(edge, 1.0, border_style));
+            p.drawRect(r);
+
+            p.setPen(ink);
+            p.setFont(label_font);
+            p.drawText(r.left() + 4, r.top() + 12, label);
+
+            p.setFont(value_font);
+            p.drawText(QRect(r.left(), r.top(), r.width(), 20), Qt::AlignCenter, sides[0]);
+            p.drawText(QRect(r.right() - 28, r.top(), 28, r.height()), Qt::AlignCenter, sides[1]);
+            p.drawText(QRect(r.left(), r.bottom() - 20, r.width(), 20), Qt::AlignCenter, sides[2]);
+            p.drawText(QRect(r.left(), r.top(), 28, r.height()), Qt::AlignCenter, sides[3]);
+        };
+
+        auto border_rect = outer.adjusted(28, 22, -28, -22);
+        auto padding_rect = border_rect.adjusted(28, 22, -28, -22);
+        auto content_rect = padding_rect.adjusted(28, 22, -28, -22);
+
+        draw_layer(outer, margin_bg, QStringLiteral("margin"), m_margin, Qt::DashLine);
+        draw_layer(border_rect, border_bg, QStringLiteral("border"), m_border, Qt::SolidLine);
+        draw_layer(padding_rect, padding_bg, QStringLiteral("padding"), m_padding, Qt::DashLine);
+
+        p.setBrush(content_bg);
+        p.setPen(QPen(edge, 1.0, Qt::SolidLine));
+        p.drawRect(content_rect);
+        p.setPen(ink);
+        p.setFont(value_font);
+        p.drawText(content_rect, Qt::AlignCenter, m_content_size);
+    }
+
+private:
+    bool m_has_metrics { false };
+    Array<QString, 4> m_margin {};
+    Array<QString, 4> m_border {};
+    Array<QString, 4> m_padding {};
+    QString m_content_size;
+};
