+    bind_localized_placeholder(*m_dom_filter_edit, QStringLiteral("Filter DOM (tag, #id, .class, text)"));
+    connect(m_dom_filter_edit, &QLineEdit::textChanged, this, &DevToolsPanel::filter_dom_tree);
+    dom_tb_layout->addWidget(m_dom_filter_edit, 1);
+
+    auto* refresh_dom_btn = new QToolButton(dom_toolbar);
