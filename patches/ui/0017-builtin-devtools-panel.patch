+class DomTreeDelegate final : public QStyledItemDelegate {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    using QStyledItemDelegate::QStyledItemDelegate;
+
+    virtual void paint(QPainter* painter, QStyleOptionViewItem const& option, QModelIndex const& index) const override
+    {
+        QStyleOptionViewItem opt = option;
+        initStyleOption(&opt, index);
+
+        painter->save();
+        bool selected = (opt.state & QStyle::State_Selected) != 0;
+        bool hovered = (opt.state & QStyle::State_MouseOver) != 0;
+        auto const& panel = Theme::panel();
+        if (selected)
+            painter->fillRect(opt.rect, Theme::selected_row());
+        else if (hovered)
+            painter->fillRect(opt.rect, panel.control);
+
+        auto font = devtools_mono_font(12);
+        painter->setFont(font);
+        QFontMetrics fm(font);
+
+        auto dark = Theme::is_dark();
+        QColor bracket_color = selected ? QColor(255, 255, 255, 190) : panel.muted;
+        QColor tag_color = selected ? Qt::white : (dark ? QColor(0x7d, 0xd3, 0xfc) : QColor(0x88, 0x12, 0x80));
+        QColor attr_name_color = selected ? QColor(255, 240, 200) : (dark ? QColor(0xfd, 0xba, 0x74) : QColor(0x99, 0x45, 0x00));
+        QColor attr_val_color = selected ? QColor(220, 245, 255) : (dark ? QColor(0xfc, 0xa5, 0xa5) : QColor(0x1a, 0x1a, 0xa6));
+        QColor text_color = selected ? Qt::white : panel.text;
+        QColor comment_color = selected ? QColor(220, 255, 220) : (dark ? QColor(0x86, 0xef, 0xac) : QColor(0x23, 0x6e, 0x25));
+        QColor pseudo_color = selected ? Qt::white : (dark ? QColor(0xc4, 0xb5, 0xfd) : QColor(0x6d, 0x28, 0xd9));
+
+        int x = opt.rect.left() + 4;
+        int max_x = opt.rect.right() - 4;
+        int y = opt.rect.top() + (opt.rect.height() + fm.ascent() - fm.descent()) / 2;
+
+        auto draw_chunk = [&](QString const& text, QColor const& color) {
+            if (text.isEmpty() || x >= max_x)
+                return;
+            auto elided = fm.elidedText(text, Qt::ElideRight, max_x - x);
+            painter->setPen(color);
+            painter->drawText(x, y, elided);
+            x += fm.horizontalAdvance(elided);
+        };
+
+        auto node_type = index.data(NodeTypeRole).toString();
+        auto tag_name = index.data(NodeTagRole).toString();
+        auto inline_text = index.data(NodeInlineTextRole).toString();
+
+        if (node_type == QLatin1StringView("element")) {
+            draw_chunk(QStringLiteral("<"), bracket_color);
+            draw_chunk(tag_name, tag_color);
+
+            auto attrs = index.data(NodeAttrsListRole).toStringList();
+            for (qsizetype i = 0; i + 1 < attrs.size(); i += 2) {
+                draw_chunk(QStringLiteral(" "), bracket_color);
+                draw_chunk(attrs[i], attr_name_color);
+                if (!attrs[i + 1].isEmpty()) {
+                    draw_chunk(QStringLiteral("=\""), bracket_color);
+                    draw_chunk(truncate_display(attrs[i + 1], 64), attr_val_color);
+                    draw_chunk(QStringLiteral("\""), bracket_color);
+                }
+            }
+            draw_chunk(QStringLiteral(">"), bracket_color);
+            if (!inline_text.isEmpty()) {
+                draw_chunk(truncate_display(inline_text, 80), text_color);
+                draw_chunk(QStringLiteral("</"), bracket_color);
+                draw_chunk(tag_name, tag_color);
+                draw_chunk(QStringLiteral(">"), bracket_color);
+            } else if (index.data(NodeIsLeafRole).toBool()) {
+                draw_chunk(QStringLiteral("</"), bracket_color);
+                draw_chunk(tag_name, tag_color);
+                draw_chunk(QStringLiteral(">"), bracket_color);
+            }
+        } else if (node_type == QLatin1StringView("text")) {
+            draw_chunk(QStringLiteral("\""), bracket_color);
+            draw_chunk(truncate_display(inline_text, 120), text_color);
+            draw_chunk(QStringLiteral("\""), bracket_color);
+        } else if (node_type == QLatin1StringView("comment")) {
+            draw_chunk(QStringLiteral("<!-- ") + truncate_display(inline_text, 100) + QStringLiteral(" -->"), comment_color);
+        } else if (node_type == QLatin1StringView("pseudo-element") || node_type == QLatin1StringView("shadow-root")) {
+            draw_chunk(tag_name, pseudo_color);
+        } else {
+            draw_chunk(index.data(Qt::DisplayRole).toString(), bracket_color);
+        }
+
+        painter->restore();
+    }
+
+    virtual QSize sizeHint(QStyleOptionViewItem const& option, QModelIndex const& index) const override
+    {
+        auto sz = QStyledItemDelegate::sizeHint(option, index);
+        sz.setHeight(max(sz.height(), 20));
+        return sz;
+    }
+};
