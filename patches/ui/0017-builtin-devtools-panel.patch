+
+void DevToolsPanel::refresh_sources()
+{
+    if (!m_view.devtools_is_attached())
+        return;
+
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_list_sources([weak_this](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || res.is_error() || !res.value().is_array())
+            return;
+        weak_this->m_sources_tree->clear();
+        weak_this->m_source_items_by_key.clear();
+        weak_this->m_scripts_group_item = nullptr;
+        weak_this->m_stylesheets_group_item = nullptr;
+        res.value().as_array().for_each([&](JsonValue const& item) {
+            if (item.is_object())
+                weak_this->add_source_entry(item.as_object());
+        });
+        if (!weak_this->m_sources_filter_edit->text().isEmpty())
+            weak_this->filter_sources_tree(weak_this->m_sources_filter_edit->text());
+    });
+}
+
+void DevToolsPanel::add_source_entry(JsonObject const& entry)
+{
+    auto key = entry.get_string("key"sv);
+    if (!key.has_value() || m_source_items_by_key.contains(*key))
+        return;
+
+    auto kind = entry.get_string("kind"sv).value_or("script"_string);
+    auto display_name = qstring_from_ak_string(entry.get_string("displayName"sv).value_or(*key));
+    auto url = qstring_from_ak_string(entry.get_string("url"sv).value_or(String {}));
+    auto content_type = qstring_from_ak_string(entry.get_string("contentType"sv).value_or(String {}));
+
+    QTreeWidgetItem* group = nullptr;
+    if (kind == "stylesheet"sv) {
+        if (!m_stylesheets_group_item) {
+            m_stylesheets_group_item = new QTreeWidgetItem(m_sources_tree);
+            m_stylesheets_group_item->setText(0, tr_ui("Stylesheets"));
+            m_stylesheets_group_item->setExpanded(true);
+        }
+        group = m_stylesheets_group_item;
+    } else {
+        if (!m_scripts_group_item) {
+            m_scripts_group_item = new QTreeWidgetItem(m_sources_tree);
+            m_scripts_group_item->setText(0, tr_ui("Scripts"));
+            m_scripts_group_item->setExpanded(true);
+        }
+        group = m_scripts_group_item;
+    }
+
+    auto* item = new QTreeWidgetItem(group);
+    item->setText(0, display_name);
+    if (!url.isEmpty())
+        item->setToolTip(0, url);
+    item->setData(0, SourceKeyRole, qstring_from_ak_string(*key));
+    item->setData(0, SourceUrlRole, url);
+    item->setData(0, SourceContentTypeRole, content_type);
+    m_source_items_by_key.set(*key, item);
+}
+
+void DevToolsPanel::on_source_selected()
+{
+    auto items = m_sources_tree->selectedItems();
+    if (items.isEmpty())
+        return;
+    auto* item = items.first();
+    auto key = item->data(0, SourceKeyRole).toString();
+    if (key.isEmpty() || !m_view.devtools_is_attached())
+        return;
+
+    auto url = item->data(0, SourceUrlRole).toString();
+    m_source_header_label->setText(url.isEmpty() ? item->text(0) : url);
+    m_source_editor->setPlainText(tr_ui("Loading source\u2026"));
+
+    auto gen = ++m_source_request_generation;
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_get_source(ak_string_from_qstring(key), [weak_this, gen](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || weak_this->m_source_request_generation != gen)
+            return;
+        if (res.is_error() || !res.value().is_object()) {
+            weak_this->m_source_editor->setPlainText(tr_ui("Unable to load source."));
+            return;
+        }
+        auto text = res.value().as_object().get_string("text"sv).value_or(String {});
+        weak_this->m_source_editor->setPlainText(qstring_from_ak_string(text));
+    });
+}
+
+void DevToolsPanel::filter_sources_tree(QString const& query)
+{
+    auto needle = query.trimmed().toLower();
+    for (int i = 0; i < m_sources_tree->topLevelItemCount(); ++i) {
+        auto* group = m_sources_tree->topLevelItem(i);
+        bool any = false;
+        for (int j = 0; j < group->childCount(); ++j) {
+            auto* child = group->child(j);
+            bool match = needle.isEmpty()
+                || child->text(0).toLower().contains(needle)
+                || child->data(0, SourceUrlRole).toString().toLower().contains(needle);
+            child->setHidden(!match);
+            if (match)
+                any = true;
+        }
+        group->setHidden(!any && !needle.isEmpty());
+    }
+}
