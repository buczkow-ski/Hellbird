+void DevToolsPanel::refresh_storage()
+{
+    if (!m_view.devtools_is_attached())
+        return;
+
+    auto kind = static_cast<StorageKind>(m_storage_kind_combo->currentData().toInt());
+    bool is_kv = kind != StorageKind::Cookies;
+    m_storage_add_button->setVisible(is_kv);
+    m_storage_clear_button->setVisible(is_kv);
+
+    m_storage_tree->clear();
+    m_loaded_cookies.clear();
+
+    QPointer<DevToolsPanel> weak_this { this };
+    if (kind == StorageKind::Cookies) {
+        m_storage_tree->setColumnCount(6);
+        m_storage_tree->setHeaderLabels({
+            tr_ui("Name"),
+            tr_ui("Value"),
+            tr_ui("Domain"),
+            tr_ui("Path"),
+            tr_ui("Expires"),
+            tr_ui("Flags"),
+        });
+        m_view.devtools_get_cookies([weak_this](ErrorOr<JsonValue, String> res) {
+            if (!weak_this || res.is_error() || !res.value().is_array())
+                return;
+            if (static_cast<StorageKind>(weak_this->m_storage_kind_combo->currentData().toInt()) != StorageKind::Cookies)
+                return;
+            weak_this->m_storage_tree->clear();
+            weak_this->m_loaded_cookies.clear();
+            res.value().as_array().for_each([&](JsonValue const& cval) {
+                if (!cval.is_object())
+                    return;
+                auto const& c = cval.as_object();
+                auto idx = weak_this->m_loaded_cookies.size();
+                weak_this->m_loaded_cookies.append(c);
+
+                auto* row = new QTreeWidgetItem(weak_this->m_storage_tree);
+                row->setData(0, StorageCookieIndexRole, static_cast<qint64>(idx));
+                row->setText(0, qstring_from_ak_string(c.get_string("name"sv).value_or(String {})));
+                row->setText(1, qstring_from_ak_string(c.get_string("value"sv).value_or(String {})));
+                row->setText(2, qstring_from_ak_string(c.get_string("domain"sv).value_or(String {})));
+                row->setText(3, qstring_from_ak_string(c.get_string("path"sv).value_or("/"_string)));
+                if (auto exp = c.get_i64("expires"sv); exp.has_value())
+                    row->setText(4, QDateTime::fromMSecsSinceEpoch(*exp).toString(Qt::ISODate));
+                else
+                    row->setText(4, tr_ui("Session"));
+                QStringList flags;
+                if (c.get_bool("secure"sv).value_or(false))
+                    flags.append(QStringLiteral("Secure"));
+                if (c.get_bool("httpOnly"sv).value_or(false))
+                    flags.append(QStringLiteral("HttpOnly"));
+                if (auto ss = c.get_string("sameSite"sv); ss.has_value() && !ss->is_empty())
+                    flags.append(QStringLiteral("SameSite=") + qstring_from_ak_string(*ss));
+                row->setText(5, flags.join(QStringLiteral(", ")));
+            });
+        });
+        return;
+    }
+
+    m_storage_tree->setColumnCount(2);
+    m_storage_tree->setHeaderLabels({ tr_ui("Key"), tr_ui("Value") });
+    m_storage_tree->setColumnWidth(0, 180);
+    auto store = kind == StorageKind::LocalStorage ? RemoteView::DevToolsStorage::Local : RemoteView::DevToolsStorage::Session;
+    m_view.devtools_get_storage(store, [weak_this, kind](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || res.is_error() || !res.value().is_array())
+            return;
+        if (static_cast<StorageKind>(weak_this->m_storage_kind_combo->currentData().toInt()) != kind)
+            return;
+        weak_this->m_storage_tree->clear();
+        res.value().as_array().for_each([&](JsonValue const& item_val) {
+            if (!item_val.is_object())
+                return;
+            auto const& item = item_val.as_object();
+            auto k = qstring_from_ak_string(item.get_string("name"sv).value_or(String {}));
+            auto v = qstring_from_ak_string(item.get_string("value"sv).value_or(String {}));
+            auto* row = new QTreeWidgetItem(weak_this->m_storage_tree);
+            row->setData(0, StorageKeyNameRole, k);
+            row->setText(0, k);
+            row->setText(1, v);
+        });
+    });
+}
+
+void DevToolsPanel::add_storage_item_dialog()
+{
+    auto kind = static_cast<StorageKind>(m_storage_kind_combo->currentData().toInt());
+    if (kind == StorageKind::Cookies || !m_view.devtools_is_attached())
+        return;
+
+    QDialog dialog(this);
+    dialog.setWindowTitle(tr_ui("Add storage item"));
+    auto* form = new QFormLayout(&dialog);
+    auto* key_edit = new QLineEdit(&dialog);
+    auto* value_edit = new QLineEdit(&dialog);
+    form->addRow(tr_ui("Key"), key_edit);
+    form->addRow(tr_ui("Value"), value_edit);
+    auto* buttons = new QDialogButtonBox(QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog);
+    connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+    form->addRow(buttons);
+
+    if (dialog.exec() != QDialog::Accepted)
+        return;
+    auto key = key_edit->text();
+    if (key.isEmpty())
+        return;
+
+    auto store = kind == StorageKind::LocalStorage ? RemoteView::DevToolsStorage::Local : RemoteView::DevToolsStorage::Session;
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_set_storage_item(store, ak_string_from_qstring(key), ak_string_from_qstring(value_edit->text()),
+        [weak_this](ErrorOr<JsonValue, String>) {
+            if (weak_this)
+                weak_this->refresh_storage();
+        });
+}
+
+void DevToolsPanel::delete_selected_storage_item()
+{
+    auto items = m_storage_tree->selectedItems();
+    if (items.isEmpty() || !m_view.devtools_is_attached())
+        return;
+
+    auto kind = static_cast<StorageKind>(m_storage_kind_combo->currentData().toInt());
+    QPointer<DevToolsPanel> weak_this { this };
+    if (kind == StorageKind::Cookies) {
+        auto idx = static_cast<size_t>(items.first()->data(0, StorageCookieIndexRole).toLongLong());
+        if (idx >= m_loaded_cookies.size())
+            return;
+        m_view.devtools_delete_cookie(m_loaded_cookies[idx], [weak_this](ErrorOr<JsonValue, String>) {
+            if (weak_this)
+                weak_this->refresh_storage();
+        });
+        return;
+    }
+
+    auto key = items.first()->data(0, StorageKeyNameRole).toString();
+    auto store = kind == StorageKind::LocalStorage ? RemoteView::DevToolsStorage::Local : RemoteView::DevToolsStorage::Session;
+    m_view.devtools_remove_storage_item(store, ak_string_from_qstring(key), [weak_this](ErrorOr<JsonValue, String>) {
+        if (weak_this)
+            weak_this->refresh_storage();
+    });
+}
+
+void DevToolsPanel::clear_current_storage()
+{
+    auto kind = static_cast<StorageKind>(m_storage_kind_combo->currentData().toInt());
+    if (kind == StorageKind::Cookies || !m_view.devtools_is_attached())
+        return;
+
+    auto store = kind == StorageKind::LocalStorage ? RemoteView::DevToolsStorage::Local : RemoteView::DevToolsStorage::Session;
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_clear_storage(store, [weak_this](ErrorOr<JsonValue, String>) {
+        if (weak_this)
+            weak_this->refresh_storage();
+    });
+}
+
+}
