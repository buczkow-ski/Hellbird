+void DevToolsPanel::set_active_tab(PanelTab tab)
+{
+    m_active_tab = tab;
+    m_stack->setCurrentIndex(static_cast<int>(tab));
+    update_tab_buttons_style();
+    sync_dom_mutation_subscription();
+
+    if (!m_view.devtools_is_attached())
+        return;
+
+    if (tab == PanelTab::Elements && m_dom_tree->topLevelItemCount() == 0)
+        refresh_dom_tree();
+    else if (tab == PanelTab::Sources && m_source_items_by_key.is_empty())
+        refresh_sources();
+    else if (tab == PanelTab::Storage)
+        refresh_storage();
+}
+
+void DevToolsPanel::sync_dom_mutation_subscription()
+{
+    if (!m_view.devtools_is_attached())
+        return;
+    bool want_mutations = m_is_open && m_active_tab == PanelTab::Elements;
+    m_view.devtools_set_dom_mutations_enabled(want_mutations);
+}
