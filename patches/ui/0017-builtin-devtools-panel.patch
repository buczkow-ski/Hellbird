+void DevToolsPanel::set_temporarily_hidden_for_fullscreen(bool hidden)
+{
+    if (m_hidden_for_fullscreen == hidden)
+        return;
+    m_hidden_for_fullscreen = hidden;
+    if (hidden)
+        stop_picker_if_active();
+    update_effective_visibility();
