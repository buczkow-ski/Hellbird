+
+    m_dom_tree = new QTreeWidget(dom_container);
+    m_dom_tree->setHeaderHidden(true);
+    m_dom_tree->setIndentation(14);
+    m_dom_tree->setUniformRowHeights(true);
+    m_dom_tree->setMouseTracking(true);
+    m_dom_tree->setContextMenuPolicy(Qt::CustomContextMenu);
+    m_dom_tree->setSelectionMode(QAbstractItemView::SingleSelection);
+    m_dom_delegate = new DomTreeDelegate(m_dom_tree);
+    m_dom_tree->setItemDelegate(m_dom_delegate);
+    m_dom_tree->viewport()->installEventFilter(this);
+    m_dom_tree->installEventFilter(this);
+
+    connect(m_dom_tree, &QTreeWidget::itemSelectionChanged, this, &DevToolsPanel::on_dom_selection_changed);
+    connect(m_dom_tree, &QTreeWidget::customContextMenuRequested, this, &DevToolsPanel::show_dom_context_menu);
+    connect(m_dom_tree, &QTreeWidget::entered, this, [this](QModelIndex const& index) {
+        if (!index.isValid())
+            return;
+        bool ok = false;
+        auto node_id = index.data(NodeIdRole).toLongLong(&ok);
+        if (!ok || node_id <= 0)
+            return;
+        Optional<u32> pseudo;
+        auto pseudo_val = index.data(NodePseudoRole);
+        if (pseudo_val.isValid() && !pseudo_val.isNull())
+            pseudo = static_cast<u32>(pseudo_val.toUInt());
+        if (m_hovered_node_id != node_id) {
+            m_hovered_node_id = node_id;
+            m_view.devtools_highlight_node(node_id, pseudo);
+        }
+    });
+    dom_layout->addWidget(m_dom_tree, 1);
