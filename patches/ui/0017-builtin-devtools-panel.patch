+
+QString DevToolsPanel::format_grip(JsonValue const& value, int depth)
+{
+    if (value.is_null())
+        return QStringLiteral("null");
+    if (value.is_bool())
+        return value.as_bool() ? QStringLiteral("true") : QStringLiteral("false");
+    if (value.is_number())
+        return qstring_from_ak_string(value.serialized());
+    if (value.is_string()) {
+        auto s = qstring_from_ak_string(value.as_string());
+        return depth > 0 ? QStringLiteral("\"%1\"").arg(truncate_display(s, 120)) : s;
+    }
+    if (value.is_object()) {
+        auto const& obj = value.as_object();
+        auto type = obj.get_string("type"sv).value_or(String {});
+        if (type == "undefined"sv || type == "null"sv || type == "NaN"sv || type == "Infinity"sv || type == "-Infinity"sv || type == "-0"sv)
+            return qstring_from_ak_string(type);
+        if (type == "BigInt"sv)
+            return qstring_from_ak_string(obj.get_string("text"sv).value_or("0n"_string));
+        if (type == "object"sv) {
+            if (auto ds = obj.get_string("displayString"sv); ds.has_value() && !ds->is_empty())
+                return qstring_from_ak_string(*ds);
+            if (auto preview = obj.get_string("preview"sv); preview.has_value() && !preview->is_empty())
+                return qstring_from_ak_string(*preview);
+            auto cls = obj.get_string("class"sv).value_or("Object"_string);
+            if (auto name = obj.get_string("name"sv); name.has_value() && !name->is_empty())
+                return QStringLiteral("%1 (%2)").arg(qstring_from_ak_string(cls), qstring_from_ak_string(*name));
+            return qstring_from_ak_string(cls);
+        }
+    }
+    return qstring_from_ak_string(value.serialized());
+}
+
+void DevToolsPanel::handle_console_event(JsonObject const& payload)
+{
+    auto kind = payload.get_string("kind"sv).value_or(String {});
+    if (kind == "groupEnd"sv)
+        return;
+
+    auto format_location = [](Optional<JsonObject const&> loc) -> QString {
+        if (!loc.has_value())
+            return {};
+        auto file = loc->get_string("file"sv).value_or(String {});
+        auto line = loc->get_u64("line"sv);
+        if (file.is_empty())
+            return {};
+        QUrl qurl(qstring_from_ak_string(file));
+        auto base = qurl.fileName().isEmpty() ? qstring_from_ak_string(file) : qurl.fileName();
+        if (line.has_value())
+            return QStringLiteral("%1:%2").arg(base).arg(*line);
+        return base;
+    };
+
+    auto extract_stack = [&](Optional<JsonArray const&> stack) -> Vector<QString> {
+        Vector<QString> lines;
+        if (!stack.has_value())
+            return lines;
+        stack->for_each([&](JsonValue const& fval) {
+            if (!fval.is_object())
+                return;
+            auto const& f = fval.as_object();
+            auto fn = qstring_from_ak_string(f.get_string("function"sv).value_or("(anonymous)"_string));
+            auto loc = format_location(f);
+            lines.append(loc.isEmpty() ? QStringLiteral("  at %1").arg(fn) : QStringLiteral("  at %1 (%2)").arg(fn, loc));
+        });
+        return lines;
+    };
+
+    if (kind == "error"sv) {
+        auto name = qstring_from_ak_string(payload.get_string("name"sv).value_or("Error"_string));
+        auto msg = qstring_from_ak_string(payload.get_string("message"sv).value_or(String {}));
+        bool in_promise = payload.get_bool("inPromise"sv).value_or(false);
+        auto full = in_promise
+            ? QStringLiteral("Uncaught (in promise) %1: %2").arg(name, msg)
+            : QStringLiteral("Uncaught %1: %2").arg(name, msg);
+        auto stack = extract_stack(payload.get_array("stack"sv));
+        QString loc;
+        if (auto stack_arr = payload.get_array("stack"sv); stack_arr.has_value() && !stack_arr->is_empty() && stack_arr->at(0).is_object())
+            loc = format_location(stack_arr->at(0).as_object());
+        ++m_console_error_count;
+        update_console_badges();
+        append_console_item(QStringLiteral("\u00d7 "), full, loc, ConsoleFilter::Errors, {}, stack);
+        return;
+    }
+
+    if (kind == "trace"sv) {
+        auto label = qstring_from_ak_string(payload.get_string("label"sv).value_or("console.trace"_string));
+        auto stack = extract_stack(payload.get_array("stack"sv));
+        append_console_item(QStringLiteral("\u2139 "), label, {}, ConsoleFilter::Info, {}, stack);
+        return;
+    }
+
+    if (kind == "log"sv) {
+        auto level = payload.get_string("level"sv).value_or("log"_string);
+        ConsoleFilter cat = ConsoleFilter::Log;
+        QString prefix;
+        if (level == "error"sv || level == "assert"sv) {
+            cat = ConsoleFilter::Errors;
+            prefix = QStringLiteral("\u00d7 ");
+            ++m_console_error_count;
+            update_console_badges();
+        } else if (level == "warn"sv) {
+            cat = ConsoleFilter::Warnings;
+            prefix = QStringLiteral("\u26a0 ");
+            ++m_console_warning_count;
+            update_console_badges();
+        } else if (level == "info"sv || level == "debug"sv) {
+            cat = ConsoleFilter::Info;
+            prefix = QStringLiteral("\u2139 ");
+        }
+
+        QStringList parts;
+        Optional<u64> first_object_id;
+        if (auto args = payload.get_array("args"sv); args.has_value()) {
+            args->for_each([&](JsonValue const& arg) {
+                parts.append(format_grip(arg, 0));
+                if (!first_object_id.has_value() && arg.is_object()) {
+                    if (auto oid = arg.as_object().get_u64("objectId"sv); oid.has_value())
+                        first_object_id = *oid;
+                }
+            });
+        }
+        auto loc = format_location(payload.get_object("location"sv));
+        append_console_item(prefix, parts.join(QLatin1Char(' ')), loc, cat, first_object_id);
+    }
+}
+
+void DevToolsPanel::handle_eval_result_event(JsonObject const& payload)
+{
+    auto val = payload.get("value"sv);
+    if (!val.has_value())
+        return;
+
+    Optional<u64> object_id;
+    if (val->is_object()) {
+        if (auto oid = val->as_object().get_u64("objectId"sv); oid.has_value())
+            object_id = *oid;
+    }
+
+    append_console_item(QStringLiteral("\u2190 "), format_grip(*val, 1), {}, ConsoleFilter::Log, object_id);
+}
+
+void DevToolsPanel::append_console_item(QString const& prefix, QString const& text, QString const& location, ConsoleFilter category, Optional<u64> object_id, Vector<QString> const& stack_lines)
+{
+    auto* item = new QTreeWidgetItem(m_console_tree);
+    auto display_line = prefix + text;
+    item->setText(0, display_line);
+    item->setText(1, location);
+    item->setData(0, ConsoleCopyTextRole, text);
+
+    auto const& panel = Theme::panel();
+    auto dark = Theme::is_dark();
+    if (category == ConsoleFilter::Errors) {
+        item->setForeground(0, dark ? QColor(0xfc, 0xa5, 0xa5) : QColor(0xb9, 0x1c, 0x1c));
+        auto err_bg = dark ? QColor(0x45, 0x1a, 0x1a) : QColor(0xfe, 0xf2, 0xf2);
+        item->setBackground(0, err_bg);
+        item->setBackground(1, err_bg);
+    } else if (category == ConsoleFilter::Warnings) {
+        item->setForeground(0, dark ? QColor(0xfd, 0xe6, 0x8a) : QColor(0x92, 0x40, 0x0e));
+        auto warn_bg = dark ? QColor(0x42, 0x33, 0x14) : QColor(0xff, 0xfb, 0xeb);
+        item->setBackground(0, warn_bg);
+        item->setBackground(1, warn_bg);
+    } else {
+        item->setForeground(0, panel.text);
+    }
+    item->setForeground(1, panel.muted);
+
+    for (auto const& frame : stack_lines) {
+        auto* frame_item = new QTreeWidgetItem(item);
+        frame_item->setText(0, frame);
+        frame_item->setForeground(0, panel.muted);
+    }
+
+    if (object_id.has_value()) {
+        item->setData(0, ConsoleObjectIdRole, static_cast<qulonglong>(*object_id));
+        item->setData(0, ConsoleObjectLoadedRole, false);
+        auto* placeholder = new QTreeWidgetItem(item);
+        placeholder->setText(0, tr_ui("Loading\u2026"));
+        placeholder->setForeground(0, panel.muted);
+    }
+
+    ConsoleEntry entry {
+        .category = category,
+        .search_text = (display_line + QLatin1Char(' ') + location).toLower(),
+        .item = item,
+    };
+    m_console_entries.append(AK::move(entry));
+    apply_console_filter();
+    m_console_tree->scrollToBottom();
+}
+
+void DevToolsPanel::expand_console_object(QTreeWidgetItem* item)
+{
+    if (!item || item->data(0, ConsoleObjectLoadedRole).toBool())
+        return;
+    bool ok = false;
+    auto object_id = item->data(0, ConsoleObjectIdRole).toULongLong(&ok);
+    if (!ok || object_id == 0)
+        return;
+
+    item->setData(0, ConsoleObjectLoadedRole, true);
+    auto gen = m_console_generation;
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_get_object_properties(static_cast<u64>(object_id), [weak_this, gen, item](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || weak_this->m_console_generation != gen)
+            return;
+        // Verify item is still alive in the tree.
+        if (weak_this->m_console_tree->indexFromItem(item).isValid() == false)
+            return;
+        while (item->childCount() > 0)
+            delete item->takeChild(0);
+
+        if (res.is_error() || !res.value().is_object()) {
+            auto* err_item = new QTreeWidgetItem(item);
+            err_item->setText(0, tr_ui("(unavailable)"));
+            err_item->setForeground(0, Theme::panel().muted);
+            return;
+        }
+
+        auto const& obj = res.value().as_object();
+        if (auto props = obj.get_array("properties"sv); props.has_value()) {
+            props->for_each([&](JsonValue const& pval) {
+                if (!pval.is_object())
+                    return;
+                auto const& prop = pval.as_object();
+                auto name = qstring_from_ak_string(prop.get_string("name"sv).value_or(String {}));
+                auto val_opt = prop.get("value"sv);
+                auto val_str = val_opt.has_value() ? format_grip(*val_opt, 1) : QStringLiteral("[Accessor]");
+                auto* child = new QTreeWidgetItem(item);
+                child->setText(0, QStringLiteral("%1: %2").arg(name, val_str));
+                child->setData(0, ConsoleCopyTextRole, val_str);
+                if (val_opt.has_value() && val_opt->is_object()) {
+                    if (auto nested_id = val_opt->as_object().get_u64("objectId"sv); nested_id.has_value()) {
+                        child->setData(0, ConsoleObjectIdRole, static_cast<qulonglong>(*nested_id));
+                        child->setData(0, ConsoleObjectLoadedRole, false);
+                        auto* ph = new QTreeWidgetItem(child);
+                        ph->setText(0, tr_ui("Loading\u2026"));
+                        ph->setForeground(0, Theme::panel().muted);
+                    }
+                }
+            });
+        }
+    });
+}
+
+void DevToolsPanel::apply_console_filter()
+{
+    auto filter_level = static_cast<ConsoleFilter>(m_console_level_combo->currentData().toInt());
+    auto needle = m_console_filter_edit->text().trimmed().toLower();
+    for (auto const& entry : m_console_entries) {
+        if (!entry.item)
+            continue;
+        bool level_ok = filter_level == ConsoleFilter::All || entry.category == filter_level;
+        bool text_ok = needle.isEmpty() || entry.search_text.contains(needle);
+        entry.item->setHidden(!(level_ok && text_ok));
+    }
+}
+
+void DevToolsPanel::submit_console_expression()
+{
+    auto expr = m_console_input->text().trimmed();
+    if (expr.isEmpty())
+        return;
+
+    m_console_input->clear();
+    m_console_history_index = -1;
+    m_console_draft.clear();
+    if (m_console_history.isEmpty() || m_console_history.last() != expr) {
+        m_console_history.append(expr);
+        if (m_console_history.size() > 100)
+            m_console_history.removeFirst();
+    }
+
+    append_console_item(QStringLiteral("\u276f "), expr, {}, ConsoleFilter::Log);
+    if (m_view.devtools_is_attached())
+        m_view.devtools_evaluate(ak_string_from_qstring(expr));
+}
+
+void DevToolsPanel::request_console_completion()
+{
+    if (!m_view.devtools_is_attached())
+        return;
+    auto current = m_console_input->text();
+    if (current.isEmpty())
+        return;
+
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_complete(ak_string_from_qstring(current), [weak_this, current](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || res.is_error() || !res.value().is_object())
+            return;
+        if (weak_this->m_console_input->text() != current)
+            return;
+        auto const& obj = res.value().as_object();
+        auto matches = obj.get_array("matches"sv);
+        auto match_prop = qstring_from_ak_string(obj.get_string("matchProp"sv).value_or(String {}));
+        if (!matches.has_value() || matches->is_empty())
+            return;
+        if (!matches->at(0).is_string())
+            return;
+        auto first = qstring_from_ak_string(matches->at(0).as_string());
+        if (first.startsWith(match_prop) && current.endsWith(match_prop)) {
+            auto completed = current.left(current.size() - match_prop.size()) + first;
+            weak_this->m_console_input->setText(completed);
+        }
+    });
+}
