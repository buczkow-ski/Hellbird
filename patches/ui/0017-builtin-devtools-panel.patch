+static Optional<QColor> parse_css_color_swatch(QString const& value)
+{
+    auto trimmed = value.trimmed();
+    if (trimmed.startsWith(QLatin1Char('#'))) {
+        QColor color(trimmed);
+        if (color.isValid())
+            return color;
+    }
+    if (trimmed.startsWith(QLatin1StringView("rgb("), Qt::CaseInsensitive)
+        || trimmed.startsWith(QLatin1StringView("rgba("), Qt::CaseInsensitive)) {
+        auto open = trimmed.indexOf(QLatin1Char('('));
+        auto close = trimmed.indexOf(QLatin1Char(')'), open + 1);
+        if (open > 0 && close > open) {
+            auto inner = trimmed.mid(open + 1, close - open - 1);
+            inner.replace(QLatin1Char('/'), QLatin1Char(','));
+            auto parts = inner.split(QRegularExpression(QStringLiteral("[,\\s]+")), Qt::SkipEmptyParts);
+            if (parts.size() >= 3) {
+                bool ok0 = false;
+                bool ok1 = false;
+                bool ok2 = false;
+                auto r = parts[0].toInt(&ok0);
+                auto g = parts[1].toInt(&ok1);
+                auto b = parts[2].toInt(&ok2);
+                int a = 255;
+                if (parts.size() >= 4) {
+                    bool ok3 = false;
+                    auto af = parts[3].toDouble(&ok3);
+                    if (ok3)
+                        a = af <= 1.0 ? qBound(0, qRound(af * 255.0), 255) : qBound(0, qRound(af), 255);
+                }
+                if (ok0 && ok1 && ok2)
+                    return QColor(qBound(0, r, 255), qBound(0, g, 255), qBound(0, b, 255), a);
+            }
+        }
+    }
+    return {};
+}
+
+static QString truncate_display(QString const& text, qsizetype max_len)
+{
+    if (text.size() <= max_len)
+        return text;
+    return text.left(max_len - 1) + QChar(0x2026);
+}
