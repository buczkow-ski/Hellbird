+void DevToolsPanel::clear_network()
+{
+    m_network_tree->clear();
+    m_network_entries.clear();
+    m_network_order.clear();
+    m_selected_network_id.clear();
+    m_network_detail_container->hide();
+    m_network_empty_label->show();
+    update_network_summary();
+}
+
+void DevToolsPanel::clear_network_before_latest_navigation()
+{
+    // A navigation's own NetworkStarted can arrive before Navigated commits. Keep entries from the
+    // latest navigation request onward so the main document row is not wiped on commit.
+    Optional<size_t> keep_from_index;
+    for (size_t i = m_network_order.size(); i > 0; --i) {
+        auto id = m_network_order[i - 1];
+        if (auto it = m_network_entries.find(id); it != m_network_entries.end() && it->value->is_navigation) {
+            keep_from_index = i - 1;
+            break;
+        }
+    }
+
+    if (!keep_from_index.has_value()) {
+        clear_network();
+        return;
+    }
+
+    if (*keep_from_index == 0)
+        return;
+
+    for (size_t i = 0; i < *keep_from_index; ++i) {
+        auto id = m_network_order[i];
+        if (m_selected_network_id == id) {
+            m_selected_network_id.clear();
+            m_network_detail_container->hide();
+        }
+        if (auto entry = m_network_entries.take(id); entry.has_value() && (*entry)->item) {
+            auto idx = m_network_tree->indexOfTopLevelItem((*entry)->item);
+            if (idx >= 0)
+                delete m_network_tree->takeTopLevelItem(idx);
+        }
+    }
+
+    Vector<u64> remaining;
+    remaining.ensure_capacity(m_network_order.size() - *keep_from_index);
+    for (size_t i = *keep_from_index; i < m_network_order.size(); ++i)
+        remaining.unchecked_append(m_network_order[i]);
+    m_network_order = AK::move(remaining);
+
+    m_network_empty_label->setVisible(m_network_order.is_empty());
+    update_network_summary();
+}
+
+QString DevToolsPanel::classify_network_type(QString const& mime_type, QString const& initiator, bool is_navigation, QString const& url)
+{
+    if (is_navigation || mime_type.contains(QLatin1StringView("html"), Qt::CaseInsensitive))
+        return QStringLiteral("doc");
+    if (mime_type.contains(QLatin1StringView("javascript"), Qt::CaseInsensitive) || mime_type.contains(QLatin1StringView("ecmascript"), Qt::CaseInsensitive) || initiator == QLatin1StringView("script"))
+        return QStringLiteral("js");
+    if (mime_type.contains(QLatin1StringView("css"), Qt::CaseInsensitive) || initiator == QLatin1StringView("css"))
+        return QStringLiteral("css");
+    if (mime_type.startsWith(QLatin1StringView("image/"), Qt::CaseInsensitive) || initiator == QLatin1StringView("img"))
+        return QStringLiteral("img");
+    if (initiator == QLatin1StringView("fetch") || initiator == QLatin1StringView("xmlhttprequest") || mime_type.contains(QLatin1StringView("json"), Qt::CaseInsensitive))
+        return QStringLiteral("xhr");
+    auto lower_url = url.toLower();
+    if (lower_url.endsWith(QLatin1StringView(".js")) || lower_url.endsWith(QLatin1StringView(".mjs")))
+        return QStringLiteral("js");
+    if (lower_url.endsWith(QLatin1StringView(".css")))
+        return QStringLiteral("css");
+    return QStringLiteral("other");
+}
+
+void DevToolsPanel::handle_network_started(JsonObject const& payload)
+{
+    auto id = payload.get_u64("id"sv);
+    if (!id.has_value())
+        return;
+
+    m_network_empty_label->hide();
+
+    auto entry = make<NetworkEntry>();
+    entry->id = *id;
+    entry->url = qstring_from_ak_string(payload.get_string("url"sv).value_or(String {}));
+    QUrl qurl(entry->url);
+    entry->name = qurl.fileName().isEmpty() ? (qurl.path().isEmpty() || qurl.path() == QLatin1StringView("/") ? qurl.host() : qurl.path()) : qurl.fileName();
+    if (entry->name.isEmpty())
+        entry->name = entry->url;
+    entry->method = qstring_from_ak_string(payload.get_string("method"sv).value_or("GET"_string));
+    entry->start_time_ms = payload.get_i64("startTime"sv).value_or(0);
+    entry->initiator = qstring_from_ak_string(payload.get_string("initiator"sv).value_or(String {}));
+    entry->referrer_policy = qstring_from_ak_string(payload.get_string("referrerPolicy"sv).value_or(String {}));
+    entry->priority = qstring_from_ak_string(payload.get_string("priority"sv).value_or("auto"_string));
+    entry->is_navigation = payload.get_bool("isNavigation"sv).value_or(false);
+    entry->type = classify_network_type({}, entry->initiator, entry->is_navigation, entry->url);
+
+    if (auto headers = payload.get_array("headers"sv); headers.has_value()) {
+        headers->for_each([&](JsonValue const& h) {
+            if (!h.is_object())
+                return;
+            auto n = qstring_from_ak_string(h.as_object().get_string("name"sv).value_or(String {}));
+            auto v = qstring_from_ak_string(h.as_object().get_string("value"sv).value_or(String {}));
+            entry->request_headers.append({ AK::move(n), AK::move(v) });
+        });
+    }
+
+    auto* item = new QTreeWidgetItem(m_network_tree);
+    item->setData(0, NetworkRequestIdRole, static_cast<qulonglong>(*id));
+    item->setToolTip(0, entry->url);
+    entry->item = item;
+    update_network_row(*entry);
+
+    if (!m_network_entries.contains(*id))
+        m_network_order.append(*id);
+    m_network_entries.set(*id, AK::move(entry));
+
+    apply_network_filter();
+    update_network_summary();
+}
+
+void DevToolsPanel::handle_network_headers(JsonObject const& payload)
+{
+    auto id = payload.get_u64("id"sv);
+    if (!id.has_value())
+        return;
+    auto it = m_network_entries.find(*id);
+    if (it == m_network_entries.end())
+        return;
+
+    auto& entry = *it->value;
+    entry.status = payload.get_u32("status"sv).value_or(0);
+    entry.reason = qstring_from_ak_string(payload.get_string("reason"sv).value_or(String {}));
+    entry.cache_state = qstring_from_ak_string(payload.get_string("cache"sv).value_or("none"_string));
+    entry.mime_type = qstring_from_ak_string(payload.get_string("mimeType"sv).value_or(String {}));
+    entry.type = classify_network_type(entry.mime_type, entry.initiator, entry.is_navigation, entry.url);
+
+    entry.response_headers.clear();
+    if (auto headers = payload.get_array("headers"sv); headers.has_value()) {
+        headers->for_each([&](JsonValue const& h) {
+            if (!h.is_object())
+                return;
+            auto n = qstring_from_ak_string(h.as_object().get_string("name"sv).value_or(String {}));
+            auto v = qstring_from_ak_string(h.as_object().get_string("value"sv).value_or(String {}));
+            entry.response_headers.append({ AK::move(n), AK::move(v) });
+        });
+    }
+
+    update_network_row(entry);
+    apply_network_filter();
+    if (m_selected_network_id == *id)
+        on_network_selection_changed();
+}
+
+void DevToolsPanel::handle_network_finished(JsonObject const& payload)
+{
+    auto id = payload.get_u64("id"sv);
+    if (!id.has_value())
+        return;
+    auto it = m_network_entries.find(*id);
+    if (it == m_network_entries.end())
+        return;
+
+    auto& entry = *it->value;
+    entry.finished = true;
+    entry.size = payload.get_u64("size"sv).value_or(0);
+    entry.error = qstring_from_ak_string(payload.get_string("error"sv).value_or(String {}));
+    if (auto timing = payload.get_object("timing"sv); timing.has_value()) {
+        entry.timing = *timing;
+        auto req_start = timing->get_double_with_precision_loss("requestStart"sv).value_or(0.0);
+        auto res_end = timing->get_double_with_precision_loss("responseEnd"sv).value_or(0.0);
+        if (res_end >= req_start && res_end > 0.0)
+            entry.duration_ms = (res_end - req_start) / 1000.0;
+    }
+
+    update_network_row(entry);
+    update_network_summary();
+    if (m_selected_network_id == *id)
+        on_network_selection_changed();
+}
+
+void DevToolsPanel::update_network_row(NetworkEntry& entry)
+{
+    if (!entry.item)
+        return;
+
+    auto* item = entry.item;
+    item->setText(0, entry.name);
+    if (!entry.error.isEmpty())
+        item->setText(1, tr_ui("Failed"));
+    else if (entry.status > 0)
+        item->setText(1, QString::number(entry.status));
+    else
+        item->setText(1, tr_ui("Pending"));
+
+    item->setText(2, entry.method);
+    item->setText(3, entry.type);
+    item->setText(4, entry.finished ? format_bytes_human(entry.size) : QStringLiteral("…"));
+    item->setText(5, entry.finished ? format_duration_ms(entry.duration_ms) : QStringLiteral("…"));
+
+    auto dark = Theme::is_dark();
+    if (!entry.error.isEmpty() || entry.status >= 400)
+        item->setForeground(1, dark ? QColor(0xf8, 0x71, 0x71) : QColor(0xdc, 0x26, 0x26));
+    else if (entry.status >= 300)
+        item->setForeground(1, dark ? QColor(0xfb, 0xbf, 0x24) : QColor(0xb4, 0x53, 0x09));
+    else if (entry.status >= 200)
+        item->setForeground(1, dark ? QColor(0x4a, 0xde, 0x80) : QColor(0x15, 0x80, 0x3d));
+    else
+        item->setForeground(1, Theme::panel().muted);
+}
+
+void DevToolsPanel::apply_network_filter()
+{
+    auto needle = m_network_filter_edit->text().trimmed().toLower();
+    auto type_filter = m_network_type_combo->currentData().toString();
+
+    for (auto id : m_network_order) {
+        auto it = m_network_entries.find(id);
+        if (it == m_network_entries.end() || !it->value->item)
+            continue;
+        auto const& e = *it->value;
+        bool type_ok = type_filter == QLatin1StringView("all") || e.type == type_filter;
+        bool text_ok = needle.isEmpty() || e.url.toLower().contains(needle) || e.method.toLower().contains(needle);
+        e.item->setHidden(!(type_ok && text_ok));
+    }
+}
+
+void DevToolsPanel::update_network_summary()
+{
+    u64 total_bytes = 0;
+    for (auto id : m_network_order) {
+        if (auto it = m_network_entries.find(id); it != m_network_entries.end())
+            total_bytes += it->value->size;
+    }
+    m_network_summary_label->setText(
+        QStringLiteral("%1 %2 \u00b7 %3").arg(m_network_order.size()).arg(tr_ui("requests"), format_bytes_human(total_bytes)));
+}
+
+void DevToolsPanel::on_network_selection_changed()
+{
+    auto items = m_network_tree->selectedItems();
+    if (items.isEmpty()) {
+        m_selected_network_id.clear();
+        m_network_detail_container->hide();
+        return;
+    }
+    auto id = static_cast<u64>(items.first()->data(0, NetworkRequestIdRole).toULongLong());
+    auto it = m_network_entries.find(id);
+    if (it == m_network_entries.end())
+        return;
+
+    m_selected_network_id = id;
+    auto const& entry = *it->value;
+
+    // Headers view (strictly plain text)
+    QString headers_text;
+    headers_text += QStringLiteral("=== General ===\n");
+    headers_text += QStringLiteral("Request URL: %1\n").arg(entry.url);
+    headers_text += QStringLiteral("Request Method: %1\n").arg(entry.method);
+    if (entry.status > 0)
+        headers_text += QStringLiteral("Status Code: %1 %2\n").arg(entry.status).arg(entry.reason);
+    if (!entry.error.isEmpty())
+        headers_text += QStringLiteral("Error: %1\n").arg(entry.error);
+    if (!entry.cache_state.isEmpty())
+        headers_text += QStringLiteral("Cache: %1\n").arg(entry.cache_state);
+    if (!entry.referrer_policy.isEmpty())
+        headers_text += QStringLiteral("Referrer Policy: %1\n").arg(entry.referrer_policy);
+    if (!entry.priority.isEmpty())
+        headers_text += QStringLiteral("Priority: %1\n").arg(entry.priority);
+
+    headers_text += QStringLiteral("\n=== Response Headers (%1) ===\n").arg(entry.response_headers.size());
+    for (auto const& [k, v] : entry.response_headers)
+        headers_text += QStringLiteral("%1: %2\n").arg(k, v);
+
+    headers_text += QStringLiteral("\n=== Request Headers (%1) ===\n").arg(entry.request_headers.size());
+    for (auto const& [k, v] : entry.request_headers)
+        headers_text += QStringLiteral("%1: %2\n").arg(k, v);
+
+    m_network_headers_view->setPlainText(headers_text);
+
+    // Timing view
+    if (entry.timing.has_value()) {
+        auto const& t = *entry.timing;
+        auto us_ms = [&](StringView start_k, StringView end_k) -> QString {
+            auto s = t.get_double_with_precision_loss(start_k).value_or(0.0);
+            auto e = t.get_double_with_precision_loss(end_k).value_or(0.0);
+            if (e <= s)
+                return QStringLiteral("0 ms");
+            return format_duration_ms((e - s) / 1000.0);
+        };
+        QString timing_text;
+        timing_text += QStringLiteral("DNS Lookup:        %1\n").arg(us_ms("dnsStart"sv, "dnsEnd"sv));
+        timing_text += QStringLiteral("TCP Connect:       %1\n").arg(us_ms("connectStart"sv, "connectEnd"sv));
+        timing_text += QStringLiteral("TLS Handshake:     %1\n").arg(us_ms("tlsStart"sv, "connectEnd"sv));
+        timing_text += QStringLiteral("Waiting (TTFB):    %1\n").arg(us_ms("requestStart"sv, "responseStart"sv));
+        timing_text += QStringLiteral("Content Download:  %1\n").arg(us_ms("responseStart"sv, "responseEnd"sv));
+        timing_text += QStringLiteral("Total:             %1\n").arg(format_duration_ms(entry.duration_ms));
+        if (auto enc = t.get_u64("encodedSize"sv); enc.has_value())
+            timing_text += QStringLiteral("Encoded Size:      %1\n").arg(format_bytes_human(*enc));
+        if (auto proto = t.get_string("protocol"sv); proto.has_value() && !proto->is_empty())
+            timing_text += QStringLiteral("Protocol:          %1\n").arg(qstring_from_ak_string(*proto));
+        m_network_timing_view->setPlainText(timing_text);
+    } else {
+        m_network_timing_view->setPlainText(tr_ui("No timing information available yet."));
+    }
+
+    m_network_detail_container->show();
+    if (m_network_detail_tabs->currentIndex() == 1)
+        fetch_network_response_body(id);
+}
+
+void DevToolsPanel::fetch_network_response_body(u64 request_id)
+{
+    if (!m_view.devtools_is_attached())
+        return;
+
+    m_network_response_view->setPlainText(tr_ui("Loading response body\u2026"));
+    auto gen = ++m_network_body_generation;
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_get_response_body(request_id, [weak_this, gen](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || weak_this->m_network_body_generation != gen)
+            return;
+        if (res.is_error()) {
+            if (res.error() == "gone"sv)
+                weak_this->m_network_response_view->setPlainText(tr_ui("Response body is no longer cached in memory."));
+            else
+                weak_this->m_network_response_view->setPlainText(tr_ui("No response body available."));
+            return;
+        }
+        if (!res.value().is_object())
+            return;
+        auto const& obj = res.value().as_object();
+        bool truncated = obj.get_bool("truncated"sv).value_or(false);
+        if (auto text = obj.get_string("text"sv); text.has_value()) {
+            auto qtext = qstring_from_ak_string(*text);
+            if (truncated)
+                qtext += QStringLiteral("\n\n[") + tr_ui("Truncated") + QStringLiteral("]");
+            weak_this->m_network_response_view->setPlainText(qtext);
+        } else if (auto b64 = obj.get_string("base64"sv); b64.has_value()) {
+            weak_this->m_network_response_view->setPlainText(
+                tr_ui("Binary response body (%1 bytes base64)").arg(b64->bytes().size()));
+        } else {
+            weak_this->m_network_response_view->setPlainText(tr_ui("(empty response body)"));
+        }
+    });
+}
