+static QIcon create_picker_icon(QColor const& color)
+{
+    QPixmap pixmap(32, 32);
+    pixmap.setDevicePixelRatio(2.0);
+    pixmap.fill(Qt::transparent);
+    QPainter p(&pixmap);
+    p.setRenderHint(QPainter::Antialiasing, true);
+    QPen dashed_pen(color, 1.3, Qt::DashLine);
+    p.setPen(dashed_pen);
+    p.setBrush(Qt::NoBrush);
+    p.drawRoundedRect(QRectF(2.0, 2.0, 10.5, 10.5), 1.5, 1.5);
+
+    p.setPen(QPen(color, 1.4, Qt::SolidLine, Qt::RoundCap, Qt::RoundJoin));
+    p.setBrush(color);
+    QPolygonF arrow;
+    arrow << QPointF(8.5, 8.5) << QPointF(14.5, 10.5) << QPointF(11.8, 11.8) << QPointF(10.5, 14.5);
+    p.drawPolygon(arrow);
+    return QIcon(pixmap);
+}
