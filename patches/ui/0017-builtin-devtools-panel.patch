+        m_box_model_widget->update();
+    if (m_dom_tree)
+        m_dom_tree->viewport()->update();
+
+    m_is_updating_style = false;
+}
+
+void DevToolsPanel::handle_devtools_event(RemoteView::DevToolsEvent event, JsonObject const& payload)
+{
+    switch (event) {
+    case RemoteView::DevToolsEvent::Attached:
+        m_external_detached = false;
+        m_crash_detached = false;
+        hide_status_banner();
+        // Clear console before upstream replays buffered messages to avoid duplicates.
+        clear_console();
+        sync_dom_mutation_subscription();
+        refresh_dom_tree();
+        if (m_active_tab == PanelTab::Sources)
+            refresh_sources();
+        else if (m_active_tab == PanelTab::Storage)
+            refresh_storage();
+        break;
+
+    case RemoteView::DevToolsEvent::Detached: {
+        auto reason = payload.get_string("reason"sv).value_or(String {});
+        m_picker_active = false;
+        update_picker_button_state();
+        if (reason == "external"sv) {
+            m_external_detached = true;
+            m_crash_detached = false;
+            show_status_banner(tr_ui("External Firefox DevTools connected to this tab."), false);
+        } else if (reason == "crash"sv) {
+            m_external_detached = false;
+            m_crash_detached = true;
+            show_status_banner(tr_ui("Page crashed. Reload the page to continue inspecting."), false);
+        } else {
+            m_external_detached = false;
+            m_crash_detached = false;
+        }
+        break;
+    }
+
+    case RemoteView::DevToolsEvent::Available:
+        if (m_is_open && m_crash_detached) {
+            m_crash_detached = false;
+            m_view.devtools_attach();
+        } else if (m_is_open && m_external_detached) {
+            show_status_banner(tr_ui("External DevTools disconnected. Click Reattach to resume."), true);
+        }
+        break;
+
+    case RemoteView::DevToolsEvent::InspectElement: {
+        auto node_id = payload.get_i64("nodeId"sv);
+        if (node_id.has_value())
+            open_and_inspect(*node_id);
+        break;
+    }
+
+    case RemoteView::DevToolsEvent::Navigated:
+        m_selected_node_id.clear();
+        m_selected_pseudo.clear();
+        m_hovered_node_id.clear();
+        m_dom_items_by_id.clear();
+        m_dom_tree->clear();
+        m_styles_tree->clear();
+        m_computed_tree->clear();
+        m_box_model_widget->set_layout_metrics({});
+        m_layout_props_tree->clear();
+        m_source_items_by_key.clear();
+        m_sources_tree->clear();
+        m_scripts_group_item = nullptr;
+        m_stylesheets_group_item = nullptr;
+        m_source_editor->clear();
+        if (!m_network_preserve_checkbox->isChecked())
+            clear_network_before_latest_navigation();
+        if (m_is_open && m_view.devtools_is_attached()) {
+            refresh_dom_tree();
+            if (m_active_tab == PanelTab::Sources)
+                refresh_sources();
+            else if (m_active_tab == PanelTab::Storage)
+                refresh_storage();
+        }
+        break;
+
+    case RemoteView::DevToolsEvent::Picker: {
+        auto type = payload.get_string("type"sv).value_or(String {});
+        auto node_id = payload.get_i64("nodeId"sv);
+        if (type == "hovered"sv && node_id.has_value()) {
+            if (m_is_open && m_active_tab == PanelTab::Elements)
+                select_dom_node_by_id(*node_id, true);
+        } else if (type == "picked"sv) {
+            m_picker_active = false;
+            update_picker_button_state();
+            if (node_id.has_value())
+                open_and_inspect(*node_id);
+        } else if (type == "canceled"sv || type == "stopped"sv) {
+            m_picker_active = false;
+            update_picker_button_state();
+        }
+        break;
+    }
+
+    case RemoteView::DevToolsEvent::DomMutated:
+        if (m_is_open && m_active_tab == PanelTab::Elements)
+            refresh_dom_tree();
+        break;
+
+    case RemoteView::DevToolsEvent::Console:
+        handle_console_event(payload);
+        break;
+
+    case RemoteView::DevToolsEvent::EvalResult:
+        handle_eval_result_event(payload);
+        break;
+
+    case RemoteView::DevToolsEvent::NetworkStarted:
+        handle_network_started(payload);
+        break;
+
+    case RemoteView::DevToolsEvent::NetworkHeaders:
+        handle_network_headers(payload);
+        break;
+
+    case RemoteView::DevToolsEvent::NetworkFinished:
+        handle_network_finished(payload);
+        break;
+
+    case RemoteView::DevToolsEvent::SourceAdded:
+        add_source_entry(payload);
+        break;
+
+    case RemoteView::DevToolsEvent::StorageChanged:
+        if (m_is_open && m_active_tab == PanelTab::Storage)
+            refresh_storage();
+        break;
+    }
+}
