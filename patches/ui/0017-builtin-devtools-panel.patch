+void DevToolsPanel::open(PanelTab tab)
+{
+    auto was_open = m_is_open;
+    m_is_open = true;
+    set_active_tab(tab);
+    update_effective_visibility();
+
+    if (!m_view.devtools_is_attached() && !m_external_detached)
+        m_view.devtools_attach();
+    else if (was_open && m_view.devtools_is_attached()) {
+        if (tab == PanelTab::Elements)
+            refresh_dom_tree();
+        else if (tab == PanelTab::Sources)
+            refresh_sources();
+        else if (tab == PanelTab::Storage)
+            refresh_storage();
+    }
+
+    if (tab == PanelTab::Console && m_console_input)
+        m_console_input->setFocus();
+
+    if (!was_open)
+        emit visibility_changed(true);
+}
+
+void DevToolsPanel::open_and_inspect(i64 node_id)
+{
+    m_pending_inspect_node_id = node_id;
+    open(PanelTab::Elements);
+    if (m_view.devtools_is_attached()) {
+        if (m_dom_items_by_id.contains(node_id)) {
+            select_dom_node_by_id(node_id, true);
+            m_pending_inspect_node_id.clear();
+        } else {
+            refresh_dom_tree();
+        }
+    }
+}
+
+void DevToolsPanel::close_panel()
+{
+    if (!m_is_open)
+        return;
+    stop_picker_if_active();
+    m_view.devtools_clear_highlight();
+    m_view.devtools_set_dom_mutations_enabled(false);
+    m_view.devtools_detach();
+    m_is_open = false;
+    m_external_detached = false;
+    m_crash_detached = false;
+    m_pending_inspect_node_id.clear();
+    hide_status_banner();
+    update_effective_visibility();
+    emit visibility_changed(false);
+}
+
+void DevToolsPanel::toggle(PanelTab tab)
+{
+    if (m_is_open)
+        close_panel();
+    else
+        open(tab);
+}
+
+void DevToolsPanel::set_dock_side(DockSide side)
+{
+    if (m_dock_side == side)
+        return;
+    m_dock_side = side;
+    if (m_elements_splitter)
+        m_elements_splitter->setOrientation(Qt::Horizontal);
+    if (m_dock_button)
+        m_dock_button->setIcon(create_dock_icon(m_dock_side, Theme::panel().body));
+    emit dock_side_changed(m_dock_side);
+}
