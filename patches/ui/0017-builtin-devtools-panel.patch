+DevToolsPanel& Tab::ensure_devtools_panel()
+{
+    VERIFY(is_loaded() && m_splitter);
+    if (m_devtools_panel)
+        return *m_devtools_panel;
+
+    m_devtools_panel = new DevToolsPanel(*m_view, m_splitter);
+    m_devtools_panel->set_corner_radius(m_corner_radius);
+    m_devtools_panel->hide();
+    m_splitter->addWidget(m_devtools_panel);
+    m_splitter->setStretchFactor(0, 3);
+    m_splitter->setStretchFactor(1, 2);
+
+    QObject::connect(m_devtools_panel, &DevToolsPanel::dock_side_changed, this, [this](DevToolsPanel::DockSide) {
+        update_devtools_splitter_layout();
+        update();
+    });
+    QObject::connect(m_devtools_panel, &DevToolsPanel::visibility_changed, this, [this](bool visible) {
+        if (visible)
+            update_devtools_splitter_layout();
+        update();
+    });
+    QObject::connect(m_devtools_panel, &DevToolsPanel::picker_starting, this, [this] {
+        if (m_element_picker)
+            m_element_picker->quit();
+    });
+
+    return *m_devtools_panel;
+}
+
+void Tab::update_devtools_splitter_layout()
+{
+    if (!m_splitter || !m_devtools_panel)
+        return;
+    auto orientation = m_devtools_panel->dock_side() == DevToolsPanel::DockSide::Right ? Qt::Horizontal : Qt::Vertical;
+    bool orientation_changed = m_splitter->orientation() != orientation;
+    if (orientation_changed)
+        m_splitter->setOrientation(orientation);
+
+    auto total = orientation == Qt::Horizontal ? width() : height();
+    if (total <= 0)
+        return;
+    auto sizes = m_splitter->sizes();
+    if (orientation_changed || sizes.size() < 2 || sizes[1] <= 0) {
+        int panel_size = clamp(total * 38 / 100, 240, max(240, total - 240));
+        m_splitter->setSizes({ max(200, total - panel_size), panel_size });
+    }
+}
+
+void Tab::open_devtools(DevToolsPanel::PanelTab tab)
+{
+    ensure_loaded();
+    auto& panel = ensure_devtools_panel();
+    panel.open(tab);
+    update_devtools_splitter_layout();
+    update();
+}
+
+void Tab::toggle_devtools(DevToolsPanel::PanelTab tab)
+{
+    ensure_loaded();
+    auto& panel = ensure_devtools_panel();
+    panel.toggle(tab);
+    if (panel.isVisible())
+        update_devtools_splitter_layout();
+    update();
+}
+
+void Tab::close_devtools()
+{
+    if (m_devtools_panel && m_devtools_panel->is_open()) {
+        m_devtools_panel->close_panel();
+        update();
+    }
+}
+
+bool Tab::is_devtools_open() const
+{
+    return m_devtools_panel && m_devtools_panel->is_open();
+}
+
+void Tab::set_devtools_hidden_for_fullscreen(bool hidden)
+{
+    if (!m_devtools_panel)
+        return;
+    m_devtools_panel->set_temporarily_hidden_for_fullscreen(hidden);
+    if (!hidden && m_devtools_panel->isVisible())
+        update_devtools_splitter_layout();
+    update();
+}
+
 void Tab::request_close()
 {
     m_window->cancel_window_close_preflight();
