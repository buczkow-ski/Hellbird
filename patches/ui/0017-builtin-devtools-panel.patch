+
+void DevToolsPanel::refresh_dom_tree()
+{
+    if (!m_view.devtools_is_attached())
+        return;
+
+    auto gen = ++m_dom_request_generation;
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_get_dom_tree([weak_this, gen](ErrorOr<JsonValue, String> result) {
+        if (!weak_this || weak_this->m_dom_request_generation != gen)
+            return;
+        if (result.is_error()) {
+            auto err = result.error();
+            if (err == "too-deep"sv)
+                weak_this->m_dom_status_label->setText(tr_ui("DOM tree is too deeply nested to inspect (>255 levels)."));
+            else
+                weak_this->m_dom_status_label->setText(tr_ui("Unable to load DOM tree."));
+            weak_this->m_dom_status_label->show();
+            return;
+        }
+        weak_this->m_dom_status_label->hide();
+        if (result.value().is_object())
+            weak_this->populate_dom_tree(result.value().as_object());
+    });
+}
+
+void DevToolsPanel::populate_dom_tree(JsonObject const& root)
+{
+    QHash<qint64, bool> previously_expanded;
+    for (auto const& entry : m_dom_items_by_id) {
+        if (entry.value)
+            previously_expanded.insert(entry.key, entry.value->isExpanded());
+    }
+
+    auto target_select_id = m_pending_inspect_node_id.has_value() ? m_pending_inspect_node_id : m_selected_node_id;
+
+    m_dom_tree->blockSignals(true);
+    m_dom_tree->clear();
+    m_dom_items_by_id.clear();
+
+    populate_dom_node(nullptr, root, previously_expanded);
+    m_dom_tree->blockSignals(false);
+
+    if (!m_dom_filter_edit->text().isEmpty())
+        filter_dom_tree(m_dom_filter_edit->text());
+
+    if (target_select_id.has_value() && m_dom_items_by_id.contains(*target_select_id)) {
+        m_pending_inspect_node_id.clear();
+        select_dom_node_by_id(*target_select_id, true);
+    } else if (m_dom_tree->topLevelItemCount() > 0 && !m_selected_node_id.has_value()) {
+        // Auto-expand root document and <html> so the page structure is immediately visible.
+        auto* doc_item = m_dom_tree->topLevelItem(0);
+        doc_item->setExpanded(true);
+        for (int i = 0; i < doc_item->childCount(); ++i)
+            doc_item->child(i)->setExpanded(true);
+    }
+}
+
+void DevToolsPanel::populate_dom_node(QTreeWidgetItem* parent, JsonObject const& node, QHash<qint64, bool> const& previously_expanded)
+{
+    auto type_str = node.get_string("type"sv);
+    auto name_str = node.get_string("name"sv).value_or(String {});
+    auto node_id = node.get_i64("id"sv);
+    auto parent_id = node.get_i64("parent-id"sv);
+    auto pseudo_element = node.get_u32("pseudo-element"sv);
+
+    auto q_type = type_str.has_value() ? qstring_from_ak_string(*type_str) : QStringLiteral("doctype");
+    auto q_name = qstring_from_ak_string(name_str);
+
+    // Check if this element has a single short text child to inline it cleanly (<p>Hello</p>).
+    auto children_array = node.get_array("children"sv);
+    QString inline_text;
+    bool inline_single_text_child = false;
+    if (q_type == QLatin1StringView("element") && children_array.has_value() && children_array->size() == 1) {
+        auto const& only_child = children_array->at(0);
+        if (only_child.is_object()) {
+            auto child_type = only_child.as_object().get_string("type"sv);
+            if (child_type.has_value() && *child_type == "text"sv) {
+                auto text_val = only_child.as_object().get_string("text"sv);
+                if (text_val.has_value()) {
+                    auto q_txt = qstring_from_ak_string(*text_val).simplified();
+                    if (q_txt.size() <= 80) {
+                        inline_text = q_txt;
+                        inline_single_text_child = true;
+                    }
+                }
+            }
+        }
+    }
+
+    auto* item = parent ? new QTreeWidgetItem(parent) : new QTreeWidgetItem(m_dom_tree);
+    auto effective_id = node_id.has_value() ? *node_id : parent_id.value_or(0);
+    item->setData(0, NodeIdRole, static_cast<qint64>(effective_id));
+    if (pseudo_element.has_value())
+        item->setData(0, NodePseudoRole, static_cast<quint32>(*pseudo_element));
+    item->setData(0, NodeTypeRole, q_type);
+
+    QString search_blob;
+    if (q_type == QLatin1StringView("element")) {
+        auto lower_tag = q_name.toLower();
+        item->setData(0, NodeTagRole, lower_tag);
+        search_blob = lower_tag;
+
+        QStringList attrs_flat;
+        if (auto attrs_obj = node.get_object("attributes"sv); attrs_obj.has_value()) {
+            attrs_obj->for_each_member([&](String const& key, JsonValue const& val) {
+                auto k = qstring_from_ak_string(key);
+                auto v = val.is_string() ? qstring_from_ak_string(val.as_string()) : QString {};
+                attrs_flat.append(k);
+                attrs_flat.append(v);
+                if (k == QLatin1StringView("id")) {
+                    item->setData(0, NodeIdAttrRole, v);
+                    search_blob += QStringLiteral(" #") + v;
+                } else if (k == QLatin1StringView("class")) {
+                    item->setData(0, NodeClassAttrRole, v);
+                    search_blob += QStringLiteral(" .") + v;
+                }
+                search_blob += QStringLiteral(" ") + k + QStringLiteral("=") + v;
+            });
+        }
+        item->setData(0, NodeAttrsListRole, attrs_flat);
+        if (!inline_text.isEmpty()) {
+            item->setData(0, NodeInlineTextRole, inline_text);
+            search_blob += QStringLiteral(" ") + inline_text;
+        }
+        bool is_leaf = inline_single_text_child || !children_array.has_value() || children_array->is_empty();
+        item->setData(0, NodeIsLeafRole, is_leaf);
+        item->setText(0, QStringLiteral("<%1>").arg(lower_tag));
+    } else if (q_type == QLatin1StringView("text")) {
+        auto txt = qstring_from_ak_string(node.get_string("text"sv).value_or(String {})).simplified();
+        item->setData(0, NodeInlineTextRole, txt);
+        item->setText(0, txt);
+        search_blob = txt;
+    } else if (q_type == QLatin1StringView("comment")) {
+        auto txt = qstring_from_ak_string(node.get_string("data"sv).value_or(String {})).simplified();
+        item->setData(0, NodeInlineTextRole, txt);
+        item->setText(0, txt);
+        search_blob = txt;
+    } else if (q_type == QLatin1StringView("pseudo-element")) {
+        item->setData(0, NodeTagRole, q_name);
+        item->setText(0, q_name);
+        search_blob = q_name;
+    } else if (q_type == QLatin1StringView("shadow-root")) {
+        auto mode = node.get_string("mode"sv).value_or("open"_string);
+        auto label = QStringLiteral("#shadow-root (%1)").arg(qstring_from_ak_string(mode));
+        item->setData(0, NodeTagRole, label);
+        item->setText(0, label);
+        search_blob = label;
+    } else if (q_type == QLatin1StringView("document")) {
+        item->setText(0, QStringLiteral("#document"));
+        search_blob = QStringLiteral("#document");
+    } else {
+        auto label = QStringLiteral("<!DOCTYPE %1>").arg(q_name.isEmpty() ? QStringLiteral("html") : q_name);
+        item->setText(0, label);
+        search_blob = label;
+    }
+
+    item->setData(0, NodeFullSearchTextRole, search_blob.toLower());
+
+    if (node_id.has_value() && !pseudo_element.has_value())
+        m_dom_items_by_id.set(*node_id, item);
+
+    if (children_array.has_value() && !inline_single_text_child) {
+        children_array->for_each([&](JsonValue const& child) {
+            if (child.is_object())
+                populate_dom_node(item, child.as_object(), previously_expanded);
+        });
+    }
+
+    if (node_id.has_value() && previously_expanded.contains(*node_id))
+        item->setExpanded(previously_expanded.value(*node_id));
+    else if (q_type == QLatin1StringView("document") || (q_type == QLatin1StringView("element") && q_name.compare(QLatin1StringView("html"), Qt::CaseInsensitive) == 0))
+        item->setExpanded(true);
+}
+
+void DevToolsPanel::select_dom_node_by_id(i64 node_id, bool scroll_to)
+{
+    auto it = m_dom_items_by_id.find(node_id);
+    if (it == m_dom_items_by_id.end() || !it->value)
+        return;
+
+    auto* item = it->value;
+    for (auto* p = item->parent(); p; p = p->parent())
+        p->setExpanded(true);
+
+    m_dom_tree->setCurrentItem(item);
+    if (scroll_to)
+        m_dom_tree->scrollToItem(item, QAbstractItemView::PositionAtCenter);
+}
+
+void DevToolsPanel::on_dom_selection_changed()
+{
+    auto items = m_dom_tree->selectedItems();
+    if (items.isEmpty()) {
+        m_selected_node_id.clear();
+        m_selected_pseudo.clear();
+        update_dom_breadcrumbs(nullptr);
+        return;
+    }
+
+    auto* item = items.first();
+    bool ok = false;
+    auto node_id = item->data(0, NodeIdRole).toLongLong(&ok);
+    if (!ok || node_id <= 0)
+        return;
+
+    Optional<u32> pseudo;
+    auto pseudo_val = item->data(0, NodePseudoRole);
+    if (pseudo_val.isValid() && !pseudo_val.isNull())
+        pseudo = static_cast<u32>(pseudo_val.toUInt());
+
+    m_selected_node_id = node_id;
+    m_selected_pseudo = pseudo;
+    update_dom_breadcrumbs(item);
+    fetch_selected_node_properties();
+}
+
+void DevToolsPanel::update_dom_breadcrumbs(QTreeWidgetItem* item)
+{
+    while (m_breadcrumb_layout->count() > 0) {
+        auto* child = m_breadcrumb_layout->takeAt(0);
+        if (child->widget())
+            child->widget()->deleteLater();
+        delete child;
+    }
+
+    Vector<QTreeWidgetItem*> chain;
+    for (auto* cur = item; cur; cur = cur->parent()) {
+        auto type = cur->data(0, NodeTypeRole).toString();
+        if (type == QLatin1StringView("element") || type == QLatin1StringView("pseudo-element") || type == QLatin1StringView("shadow-root"))
+            chain.append(cur);
+    }
+
+    for (size_t i = chain.size(); i > 0; --i) {
+        auto* node_item = chain[i - 1];
+        if (i < chain.size()) {
+            auto* sep = new QLabel(QStringLiteral("\u203a"), m_breadcrumb_bar);
+            sep->setTextFormat(Qt::PlainText);
+            m_breadcrumb_layout->addWidget(sep);
+        }
+
+        auto label = node_item->data(0, NodeTagRole).toString();
+        auto id_attr = node_item->data(0, NodeIdAttrRole).toString();
+        auto class_attr = node_item->data(0, NodeClassAttrRole).toString();
+        if (!id_attr.isEmpty())
+            label += QStringLiteral("#") + id_attr;
+        else if (!class_attr.isEmpty()) {
+            auto first_cls = class_attr.simplified().section(QLatin1Char(' '), 0, 0);
+            if (!first_cls.isEmpty())
+                label += QStringLiteral(".") + first_cls;
+        }
+
+        auto* crumb = new QToolButton(m_breadcrumb_bar);
+        crumb->setObjectName(QStringLiteral("HellbirdDevToolsIconButton"));
+        crumb->setText(label);
+        crumb->setCursor(Qt::PointingHandCursor);
+        auto target_id = node_item->data(0, NodeIdRole).toLongLong();
+        connect(crumb, &QToolButton::clicked, this, [this, target_id] {
+            select_dom_node_by_id(target_id, true);
+        });
+        m_breadcrumb_layout->addWidget(crumb);
+    }
+
+    m_breadcrumb_layout->addStretch(1);
+}
+
+void DevToolsPanel::filter_dom_tree(QString const& query)
+{
+    auto needle = query.trimmed().toLower();
+    for (int i = 0; i < m_dom_tree->topLevelItemCount(); ++i)
+        filter_dom_item_recursive(m_dom_tree->topLevelItem(i), needle);
+}
+
+bool DevToolsPanel::filter_dom_item_recursive(QTreeWidgetItem* item, QString const& needle)
+{
+    if (!item)
+        return false;
+    bool child_matched = false;
+    for (int i = 0; i < item->childCount(); ++i) {
+        if (filter_dom_item_recursive(item->child(i), needle))
+            child_matched = true;
+    }
+    bool self_matched = needle.isEmpty() || item->data(0, NodeFullSearchTextRole).toString().contains(needle);
+    bool visible = self_matched || child_matched;
+    item->setHidden(!visible);
+    if (!needle.isEmpty() && child_matched)
+        item->setExpanded(true);
+    return visible;
+}
+
+QString DevToolsPanel::build_css_selector(QTreeWidgetItem* item) const
+{
+    QStringList parts;
+    for (auto* cur = item; cur; cur = cur->parent()) {
+        if (cur->data(0, NodeTypeRole).toString() != QLatin1StringView("element"))
+            continue;
+        auto tag = cur->data(0, NodeTagRole).toString();
+        auto id_attr = cur->data(0, NodeIdAttrRole).toString();
+        if (!id_attr.isEmpty()) {
+            parts.prepend(QStringLiteral("#%1").arg(id_attr));
+            break;
+        }
+        auto cls = cur->data(0, NodeClassAttrRole).toString().simplified();
+        QString segment = tag;
+        if (!cls.isEmpty()) {
+            auto classes = cls.split(QLatin1Char(' '), Qt::SkipEmptyParts);
+            for (qsizetype i = 0; i < min(classes.size(), static_cast<qsizetype>(2)); ++i)
+                segment += QStringLiteral(".") + classes[i];
+        }
+        parts.prepend(segment);
+    }
+    return parts.join(QStringLiteral(" > "));
+}
+
+void DevToolsPanel::show_dom_context_menu(QPoint const& pos)
+{
+    auto* item = m_dom_tree->itemAt(pos);
+    if (!item)
+        return;
+    bool ok = false;
+    auto node_id = item->data(0, NodeIdRole).toLongLong(&ok);
+    if (!ok || node_id <= 0)
+        return;
+    auto node_type = item->data(0, NodeTypeRole).toString();
+
+    QMenu menu(this);
+    if (node_type == QLatin1StringView("element")) {
+        auto* edit_html = menu.addAction(tr_ui("Edit as HTML\u2026"));
+        connect(edit_html, &QAction::triggered, this, [this, node_id] {
+            open_edit_html_dialog(node_id);
+        });
+        menu.addSeparator();
+
+        auto* copy_outer = menu.addAction(tr_ui("Copy outerHTML"));
+        connect(copy_outer, &QAction::triggered, this, [this, node_id] {
+            m_view.devtools_get_html(node_id, true, [](ErrorOr<JsonValue, String> res) {
+                if (!res.is_error() && res.value().is_string()) {
+                    if (auto* cb = QApplication::clipboard())
+                        cb->setText(qstring_from_ak_string(res.value().as_string()));
+                }
+            });
+        });
+
+        auto* copy_inner = menu.addAction(tr_ui("Copy innerHTML"));
+        connect(copy_inner, &QAction::triggered, this, [this, node_id] {
+            m_view.devtools_get_html(node_id, false, [](ErrorOr<JsonValue, String> res) {
+                if (!res.is_error() && res.value().is_string()) {
+                    if (auto* cb = QApplication::clipboard())
+                        cb->setText(qstring_from_ak_string(res.value().as_string()));
+                }
+            });
+        });
+
+        auto selector = build_css_selector(item);
+        auto* copy_sel = menu.addAction(tr_ui("Copy CSS selector"));
+        connect(copy_sel, &QAction::triggered, this, [selector] {
+            if (auto* cb = QApplication::clipboard())
+                cb->setText(selector);
+        });
+
+        menu.addSeparator();
+        auto* dup_action = menu.addAction(tr_ui("Duplicate element"));
+        connect(dup_action, &QAction::triggered, this, [this, node_id] {
+            QPointer<DevToolsPanel> weak_this { this };
+            m_view.devtools_clone_node(node_id, [weak_this](ErrorOr<JsonValue, String> res) {
+                if (!weak_this || res.is_error())
+                    return;
+                if (res.value().is_object()) {
+                    if (auto new_id = res.value().as_object().get_i64("nodeId"sv); new_id.has_value())
+                        weak_this->m_pending_inspect_node_id = *new_id;
+                }
+                weak_this->refresh_dom_tree();
+            });
+        });
+
+        auto* del_action = menu.addAction(tr_ui("Delete element"));
+        connect(del_action, &QAction::triggered, this, [this, node_id] {
+            QPointer<DevToolsPanel> weak_this { this };
+            m_view.devtools_remove_node(node_id, [weak_this](ErrorOr<JsonValue, String> res) {
+                if (!weak_this || res.is_error())
+                    return;
+                if (res.value().is_object()) {
+                    if (auto next_id = res.value().as_object().get_i64("nodeId"sv); next_id.has_value())
+                        weak_this->m_pending_inspect_node_id = *next_id;
+                }
+                weak_this->refresh_dom_tree();
+            });
+        });
+    }
+
+    if (!menu.isEmpty())
+        menu.exec(m_dom_tree->viewport()->mapToGlobal(pos));
+}
+
+void DevToolsPanel::open_edit_html_dialog(i64 node_id)
+{
+    QPointer<DevToolsPanel> weak_this { this };
+    m_view.devtools_get_html(node_id, true, [weak_this, node_id](ErrorOr<JsonValue, String> res) {
+        if (!weak_this || res.is_error() || !res.value().is_string())
+            return;
+
+        auto initial_html = qstring_from_ak_string(res.value().as_string());
+        // Defer modal dialog execution out of the IPC reply dispatch stack.
+        QTimer::singleShot(0, weak_this, [weak_this, node_id, initial_html = AK::move(initial_html)]() {
+            if (!weak_this || !weak_this->m_is_open)
+                return;
+
+            QDialog dialog(weak_this);
+            dialog.setWindowTitle(tr_ui("Edit as HTML"));
+            dialog.resize(520, 320);
+            auto* vbox = new QVBoxLayout(&dialog);
+            auto* editor = new QPlainTextEdit(&dialog);
+            editor->setFont(devtools_mono_font(12));
+            editor->setPlainText(initial_html);
+            vbox->addWidget(editor, 1);
+
+            auto* buttons = new QDialogButtonBox(QDialogButtonBox::Save | QDialogButtonBox::Cancel, &dialog);
+            QObject::connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+            QObject::connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+            vbox->addWidget(buttons);
+
+            if (dialog.exec() == QDialog::Accepted && weak_this) {
+                auto updated_html = ak_string_from_qstring(editor->toPlainText());
+                weak_this->m_view.devtools_set_outer_html(node_id, AK::move(updated_html), [weak_this](ErrorOr<JsonValue, String> edit_res) {
+                    if (!weak_this || edit_res.is_error())
+                        return;
+                    if (edit_res.value().is_object()) {
+                        if (auto new_id = edit_res.value().as_object().get_i64("nodeId"sv); new_id.has_value())
+                            weak_this->m_pending_inspect_node_id = *new_id;
+                    }
+                    weak_this->refresh_dom_tree();
+                });
+            }
+        });
+    });
+}
+
+void DevToolsPanel::fetch_selected_node_properties()
+{
+    if (!m_selected_node_id.has_value() || !m_view.devtools_is_attached())
+        return;
+
+    auto node_id = *m_selected_node_id;
+    auto pseudo = m_selected_pseudo;
+    auto gen = ++m_props_request_generation;
+    QPointer<DevToolsPanel> weak_this { this };
+
+    m_view.devtools_get_node_properties(node_id, pseudo, RemoteView::DevToolsNodeProperties::AppliedRules,
+        [weak_this, gen](ErrorOr<JsonValue, String> res) {
+            if (!weak_this || weak_this->m_props_request_generation != gen)
+                return;
+            if (!res.is_error() && res.value().is_array())
+                weak_this->populate_applied_rules(res.value().as_array());
+            else
+                weak_this->m_styles_tree->clear();
+        });
+
+    m_view.devtools_get_node_properties(node_id, pseudo, RemoteView::DevToolsNodeProperties::Computed,
+        [weak_this, gen](ErrorOr<JsonValue, String> res) {
+            if (!weak_this || weak_this->m_props_request_generation != gen)
+                return;
+            if (!res.is_error() && res.value().is_object())
+                weak_this->populate_computed_styles(res.value().as_object());
+            else
+                weak_this->m_computed_tree->clear();
+        });
+
+    m_view.devtools_get_node_properties(node_id, pseudo, RemoteView::DevToolsNodeProperties::Layout,
+        [weak_this, gen](ErrorOr<JsonValue, String> res) {
+            if (!weak_this || weak_this->m_props_request_generation != gen)
+                return;
+            weak_this->m_layout_props_tree->clear();
+            if (!res.is_error() && res.value().is_object()) {
+                auto const& obj = res.value().as_object();
+                weak_this->m_box_model_widget->set_layout_metrics(obj);
+                static constexpr Array layout_keys {
+                    "display"sv,
+                    "position"sv,
+                    "box-sizing"sv,
+                    "float"sv,
+                    "line-height"sv,
+                    "z-index"sv,
+                };
+                for (auto key : layout_keys) {
+                    if (auto val = obj.get_string(key); val.has_value() && !val->is_empty()) {
+                        auto* row = new QTreeWidgetItem(weak_this->m_layout_props_tree);
+                        row->setText(0, qstring_from_ak_string(key));
+                        row->setText(1, qstring_from_ak_string(*val));
+                        row->setForeground(0, Theme::panel().muted);
+                    }
+                }
+            } else {
+                weak_this->m_box_model_widget->set_layout_metrics({});
+            }
+        });
+}
+
+void DevToolsPanel::populate_applied_rules(JsonArray const& rules)
+{
+    m_styles_tree->clear();
+
+    auto const& panel = Theme::panel();
+    auto dark = Theme::is_dark();
+    QColor selector_color = dark ? QColor(0x93, 0xc5, 0xfd) : QColor(0x1d, 0x4e, 0xd8);
+    QColor prop_color = dark ? QColor(0xfd, 0xba, 0x74) : QColor(0x99, 0x45, 0x00);
+    QColor val_color = panel.text;
+
+    HashTable<String> seen_important;
+    HashTable<String> seen_normal;
+    Optional<i64> last_inherited_node_id;
+
+    rules.for_each([&](JsonValue const& entry_val) {
+        if (!entry_val.is_object())
+            return;
+        auto const& entry = entry_val.as_object();
+        auto rule_opt = entry.get_object("rule"sv);
+        if (!rule_opt.has_value())
+            return;
+        auto const& rule = *rule_opt;
+
+        Optional<i64> inherited_from = entry.get_i64("inheritedNodeId"sv);
+        if (!inherited_from.has_value()) {
+            if (auto inh = entry.get("inherited"sv); inh.has_value() && !inh->is_null())
+                inherited_from = inh->get_integer<i64>();
+        }
+
+        bool is_inline = rule.get_integer<i64>("type"sv).value_or(0) == 100
+            || rule.get_integer<i64>("className"sv).value_or(0) == 100;
+
+        auto decls_opt = rule.get_array("declarations"sv);
+        if (!decls_opt.has_value() || decls_opt->is_empty())
+            return;
+
+        // If inherited, skip rules that have no inheritable declarations.
+        if (inherited_from.has_value()) {
+            bool any_inheritable = false;
+            decls_opt->for_each([&](JsonValue const& d) {
+                if (d.is_object() && d.as_object().get_bool("inherits"sv).value_or(false))
+                    any_inheritable = true;
+            });
+            if (!any_inheritable)
+                return;
+        }
+
+        if (inherited_from.has_value() && inherited_from != last_inherited_node_id) {
+            last_inherited_node_id = inherited_from;
+            auto* divider = new QTreeWidgetItem(m_styles_tree);
+            QString ancestor_label = QStringLiteral("#%1").arg(*inherited_from);
+            if (auto it = m_dom_items_by_id.find(*inherited_from); it != m_dom_items_by_id.end() && it->value)
+                ancestor_label = it->value->data(0, NodeTagRole).toString();
+            divider->setText(0, tr_ui("Inherited from") + QStringLiteral(" ") + ancestor_label);
+            divider->setForeground(0, panel.muted);
+            divider->setFirstColumnSpanned(true);
+            divider->setFlags(Qt::ItemIsEnabled);
+        }
+
+        QString header_text;
+        if (is_inline) {
+            header_text = QStringLiteral("element.style");
+        } else if (auto selectors = rule.get_array("selectors"sv); selectors.has_value() && !selectors->is_empty()) {
+            QStringList sel_list;
+            selectors->for_each([&](JsonValue const& s) {
+                if (s.is_string())
+                    sel_list.append(qstring_from_ak_string(s.as_string()));
+            });
+            header_text = sel_list.join(QStringLiteral(", "));
+        } else {
+            header_text = QStringLiteral("rule");
+        }
+
+        QString source_label;
+        if (auto rule_id = rule.get_object("ruleId"sv); rule_id.has_value()) {
+            if (auto url_s = rule_id->get_string("url"sv); url_s.has_value() && !url_s->is_empty()) {
+                QUrl qurl(qstring_from_ak_string(*url_s));
+                source_label = qurl.fileName().isEmpty() ? qurl.host() : qurl.fileName();
+            } else if (auto st = rule_id->get_string("type"sv); st.has_value()) {
+                source_label = qstring_from_ak_string(*st);
+            }
+        }
+
+        auto* rule_item = new QTreeWidgetItem(m_styles_tree);
+        rule_item->setText(0, header_text + QStringLiteral(" {"));
+        rule_item->setText(1, source_label);
+        rule_item->setForeground(0, selector_color);
+        rule_item->setForeground(1, panel.muted);
+
+        decls_opt->for_each([&](JsonValue const& decl_val) {
+            if (!decl_val.is_object())
+                return;
+            auto const& decl = decl_val.as_object();
+            if (inherited_from.has_value() && !decl.get_bool("inherits"sv).value_or(false))
+                return;
+
+            auto prop_name = decl.get_string("name"sv).value_or(String {});
+            auto prop_value = decl.get_string("value"sv).value_or(String {});
+            auto priority = decl.get_string("priority"sv).value_or(String {});
+            bool is_important = priority == "important"sv;
+            bool is_valid = decl.get_bool("isValid"sv).value_or(true) && decl.get_bool("isNameValid"sv).value_or(true);
+
+            bool overridden = !is_valid || seen_important.contains(prop_name) || (!is_important && seen_normal.contains(prop_name));
+            if (is_valid) {
+                if (is_important)
+                    seen_important.set(prop_name);
+                else
+                    seen_normal.set(prop_name);
+            }
+
+            auto q_prop = qstring_from_ak_string(prop_name);
+            auto q_val = qstring_from_ak_string(prop_value);
+            if (is_important)
+                q_val += QStringLiteral(" !important");
+
+            auto* decl_item = new QTreeWidgetItem(rule_item);
+            decl_item->setText(0, q_prop + QStringLiteral(":"));
+            decl_item->setText(1, q_val + QStringLiteral(";"));
+            decl_item->setForeground(0, overridden ? panel.muted : prop_color);
+            decl_item->setForeground(1, overridden ? panel.muted : val_color);
+
+            if (overridden) {
+                auto f = devtools_mono_font(12);
+                f.setStrikeOut(true);
+                decl_item->setFont(0, f);
+                decl_item->setFont(1, f);
+            }
+
+            if (auto swatch = parse_css_color_swatch(qstring_from_ak_string(prop_value)); swatch.has_value())
+                decl_item->setIcon(1, create_color_swatch_icon(*swatch));
+        });
+
+        rule_item->setExpanded(true);
+    });
+
+    if (!m_styles_filter_edit->text().isEmpty())
+        filter_styles_tree(m_styles_filter_edit->text());
+}
+
+void DevToolsPanel::populate_computed_styles(JsonObject const& computed)
+{
+    m_computed_tree->clear();
+
+    struct ComputedStyleRow {
+        String name;
+        String value;
+    };
+    Vector<ComputedStyleRow> rows;
+    rows.ensure_capacity(computed.size());
+    computed.for_each_member([&](String const& name, JsonValue const& val) {
+        if (val.is_string())
+            rows.unchecked_append({ name, val.as_string() });
+    });
+    quick_sort(rows, [](auto const& a, auto const& b) {
+        return a.name < b.name;
+    });
+
+    auto const& panel = Theme::panel();
+    auto dark = Theme::is_dark();
+    QColor prop_color = dark ? QColor(0xfd, 0xba, 0x74) : QColor(0x99, 0x45, 0x00);
+
+    for (auto const& row : rows) {
+        auto q_name = qstring_from_ak_string(row.name);
+        auto q_val = qstring_from_ak_string(row.value);
+        auto* item = new QTreeWidgetItem(m_computed_tree);
+        item->setText(0, q_name);
+        item->setText(1, q_val);
+        item->setForeground(0, prop_color);
+        item->setForeground(1, panel.text);
+        if (auto swatch = parse_css_color_swatch(q_val); swatch.has_value())
+            item->setIcon(1, create_color_swatch_icon(*swatch));
+    }
+
+    if (!m_computed_filter_edit->text().isEmpty())
+        filter_computed_tree(m_computed_filter_edit->text());
+}
+
+void DevToolsPanel::filter_styles_tree(QString const& query)
+{
+    auto needle = query.trimmed().toLower();
+    for (int i = 0; i < m_styles_tree->topLevelItemCount(); ++i) {
+        auto* rule_item = m_styles_tree->topLevelItem(i);
+        if (rule_item->childCount() == 0) {
+            rule_item->setHidden(!needle.isEmpty());
+            continue;
+        }
+        bool header_match = needle.isEmpty() || rule_item->text(0).toLower().contains(needle);
+        bool any_child = false;
+        for (int j = 0; j < rule_item->childCount(); ++j) {
+            auto* decl = rule_item->child(j);
+            bool match = header_match || decl->text(0).toLower().contains(needle) || decl->text(1).toLower().contains(needle);
+            decl->setHidden(!match);
+            if (match)
+                any_child = true;
+        }
+        rule_item->setHidden(!any_child);
+    }
+}
+
+void DevToolsPanel::filter_computed_tree(QString const& query)
+{
+    auto needle = query.trimmed().toLower();
+    for (int i = 0; i < m_computed_tree->topLevelItemCount(); ++i) {
+        auto* item = m_computed_tree->topLevelItem(i);
+        bool match = needle.isEmpty() || item->text(0).toLower().contains(needle) || item->text(1).toLower().contains(needle);
+        item->setHidden(!match);
+    }
+}
