+DevToolsPanel::DevToolsPanel(WebContentView& view, QWidget* parent)
+    : QWidget(parent)
+    , m_view(view)
+{
+    setObjectName(QStringLiteral("HellbirdDevToolsPanel"));
+    setAttribute(Qt::WA_StyledBackground, true);
+    setMinimumSize(260, 180);
+
+    auto* root_layout = new QVBoxLayout(this);
+    root_layout->setContentsMargins(0, 0, 0, 0);
+    root_layout->setSpacing(0);
+
+    build_header();
+    root_layout->addWidget(m_header);
+
+    m_banner = new QWidget(this);
+    m_banner->setObjectName(QStringLiteral("HellbirdDevToolsBanner"));
+    auto* banner_layout = new QHBoxLayout(m_banner);
+    banner_layout->setContentsMargins(10, 5, 10, 5);
+    banner_layout->setSpacing(8);
+    m_banner_label = new QLabel(m_banner);
+    m_banner_label->setTextFormat(Qt::PlainText);
+    m_banner_label->setWordWrap(true);
+    banner_layout->addWidget(m_banner_label, 1);
+    m_banner_reattach_button = new QPushButton(m_banner);
+    bind_localized_text(*m_banner_reattach_button, QStringLiteral("Reattach"));
+    connect(m_banner_reattach_button, &QPushButton::clicked, this, [this] {
+        m_external_detached = false;
+        hide_status_banner();
+        m_view.devtools_attach();
+    });
+    banner_layout->addWidget(m_banner_reattach_button);
+    m_banner->hide();
+    root_layout->addWidget(m_banner);
+
+    m_stack = new QStackedWidget(this);
+    root_layout->addWidget(m_stack, 1);
+
+    build_elements_tab();
+    build_console_tab();
+    build_network_tab();
+    build_sources_tab();
+    build_storage_tab();
+
+    set_active_tab(PanelTab::Elements);
+    update_chrome_style();
+    hide();
+}
