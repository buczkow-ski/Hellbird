+
+void DevToolsPanel::update_effective_visibility()
+{
+    auto should_show = m_is_open && !m_hidden_for_fullscreen;
+    setVisible(should_show);
+    if (should_show)
+        update_corner_mask();
+}
+
+void DevToolsPanel::update_corner_mask()
+{
+    if (m_corner_radius > 0 && !rect().isEmpty() && !QGuiApplication::platformName().startsWith(QLatin1StringView("wayland")))
+        setMask(ChromeStyle::rounded_rect_region(rect(), m_corner_radius));
+    else
+        clearMask();
+}
+
+void DevToolsPanel::paintEvent(QPaintEvent* event)
+{
+    QWidget::paintEvent(event);
+    if (m_corner_radius > 0 && !rect().isEmpty()) {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing, true);
+        painter.setBrush(Qt::NoBrush);
+        painter.setPen(QPen(ChromeStyle::chrome_border(Theme::chrome_palette(*this)), 1));
+        auto r = static_cast<qreal>(m_corner_radius) - 0.5;
+        painter.drawRoundedRect(QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5), r, r);
+    }
+}
+
+void DevToolsPanel::resizeEvent(QResizeEvent* event)
+{
+    QWidget::resizeEvent(event);
+    update_corner_mask();
+}
+
+bool DevToolsPanel::eventFilter(QObject* watched, QEvent* event)
+{
+    if (watched == m_dom_tree->viewport() && event->type() == QEvent::Leave) {
+        if (m_hovered_node_id.has_value()) {
+            m_hovered_node_id.clear();
+            m_view.devtools_clear_highlight();
+        }
+    } else if (watched == m_dom_tree && event->type() == QEvent::KeyPress) {
+        auto* key_event = static_cast<QKeyEvent*>(event);
+        if ((key_event->key() == Qt::Key_Delete || key_event->key() == Qt::Key_Backspace) && m_selected_node_id.has_value()) {
+            auto node_id = *m_selected_node_id;
+            QPointer<DevToolsPanel> weak_this { this };
+            m_view.devtools_remove_node(node_id, [weak_this](ErrorOr<JsonValue, String> result) {
+                if (!weak_this || result.is_error())
+                    return;
+                if (result.value().is_object()) {
+                    if (auto next_id = result.value().as_object().get_i64("nodeId"sv); next_id.has_value())
+                        weak_this->m_pending_inspect_node_id = *next_id;
+                }
+                weak_this->refresh_dom_tree();
+            });
+            return true;
+        }
+    }
+    return QWidget::eventFilter(watched, event);
+}
