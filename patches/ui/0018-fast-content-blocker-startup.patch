+void ContentBlocker::set_rules_from_buffer_async(Core::AnonymousBuffer rules_buffer, Function<void(bool has_cosmetic_rules_change)> on_complete)
+{
+    if (!rules_buffer.is_valid() || rules_buffer.size() == 0) {
+        bool had_cosmetic_rules = false;
+        {
+            MutexLocker locker(m_mutex);
+            ++m_build_generation;
+            had_cosmetic_rules = m_has_cosmetic_rules.load(AK::MemoryOrder::memory_order_relaxed);
+            m_build_in_progress.store(false, AK::MemoryOrder::memory_order_release);
+            ContentBlocking::FFI::rust_content_blocker_free(m_engine.exchange(nullptr));
+            m_has_cosmetic_rules.store(false, AK::MemoryOrder::memory_order_release);
+            m_build_condition.broadcast();
+        }
+        if (on_complete)
+            on_complete(had_cosmetic_rules);
+        return;
+    }
+
+    u64 generation = 0;
+    {
+        MutexLocker locker(m_mutex);
+        generation = ++m_build_generation;
+        m_build_in_progress.store(true, AK::MemoryOrder::memory_order_release);
+    }
+
+    RefPtr<Core::WeakEventLoopReference> event_loop;
+    if (Core::EventLoop::is_running())
+        event_loop = Core::EventLoop::current_weak();
+
+    Threading::ThreadPool::the().submit([this, rules_buffer = move(rules_buffer), generation, event_loop = move(event_loop), on_complete = move(on_complete)]() mutable {
+        GC::forbid_heap_access_on_this_thread();
+
+        auto rules_bytes = rules_buffer.bytes();
+        auto* engine = ContentBlocking::FFI::rust_content_blocker_create(rules_bytes);
+        auto has_cosmetic_rules = engine ? rules_contain_cosmetic_rules(rules_bytes) : false;
+
+        bool cosmetic_rules_changed = false;
+        {
+            MutexLocker locker(m_mutex);
+            if (m_build_generation != generation) {
+                ContentBlocking::FFI::rust_content_blocker_free(engine);
+                return;
+            }
+
+            auto had_cosmetic_rules = m_has_cosmetic_rules.load(AK::MemoryOrder::memory_order_relaxed);
+            if (engine) {
+                ContentBlocking::FFI::rust_content_blocker_free(m_engine.exchange(engine));
+                m_has_cosmetic_rules.store(has_cosmetic_rules, AK::MemoryOrder::memory_order_release);
+                cosmetic_rules_changed = had_cosmetic_rules || has_cosmetic_rules;
+            } else {
+                dbgln("Failed to create content blocker");
+            }
+            m_build_in_progress.store(false, AK::MemoryOrder::memory_order_release);
+            m_build_condition.broadcast();
+        }
+
+        if (!on_complete || !event_loop)
+            return;
+
+        auto origin_event_loop = event_loop->take();
+        if (!origin_event_loop.is_alive())
+            return;
+
+        origin_event_loop->deferred_invoke([on_complete = move(on_complete), cosmetic_rules_changed]() mutable {
+            on_complete(cosmetic_rules_changed);
+        });
+    });
+}
