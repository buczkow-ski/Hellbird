+            const query = document.querySelector("#query");
+            const bangHint = document.querySelector("#bang-hint");
+
+            let isConnected = false;
+            let pendingInput = null;
+
+            // Where the text goes is decided by the browser, exactly as for the address field.
+            function openInput(input) {
+                if (!isConnected) {
+                    pendingInput = input;
+                    return;
+                }
+                ladybird.sendMessage("openInput", input);
+            }
+
+            form.addEventListener("submit", event => {
+                event.preventDefault();
+                const input = query.value.trim();
+                if (input) openInput(input);
+            });
+
+            document.addEventListener("keydown", event => {
+                if (event.key === "/" && document.activeElement !== query) {
+                    if (event.ctrlKey || event.altKey || event.metaKey) return;
+                    event.preventDefault();
+                    query.focus();
+                } else if (event.key === "Escape" && document.activeElement === query) {
