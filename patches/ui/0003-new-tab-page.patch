+/*
+ * Copyright (c) 2026, the Hellbird contributors.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWebView/WebUI.h>
+
+namespace WebView {
+
+// about:newtab, whose search field goes where the same text in the address field would. The page learns nothing but
+// the search engine's name and whether bangs are on.
+class NewTabUI final : public WebUI {
+    WEB_UI(NewTabUI);
+
+private:
+    virtual void register_interfaces() override;
+
+    void load_search_settings();
+    void open_input(JsonValue const&);
+};
+
+}
