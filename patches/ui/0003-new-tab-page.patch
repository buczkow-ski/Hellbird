diff --git a/Libraries/LibWebView/WebUI/NewTabUI.cpp b/Libraries/LibWebView/WebUI/NewTabUI.cpp
new file mode 100644
index 0000000000..e473af3988
--- /dev/null
+++ b/Libraries/LibWebView/WebUI/NewTabUI.cpp
@@ -0,0 +1,69 @@
+/*
+ * Copyright (c) 2026, the Hellbird contributors.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/JsonObject.h>
+#include <LibURL/URL.h>
+#include <LibWebView/Application.h>
+#include <LibWebView/Omnibox.h>
+#include <LibWebView/Settings.h>
+#include <LibWebView/URL.h>
+#include <LibWebView/WebUI/NewTabUI.h>
+
+namespace WebView {
+
+void NewTabUI::register_interfaces()
+{
+    register_interface("loadSearchSettings"sv, [this](auto const&) {
+        load_search_settings();
+    });
+    register_interface("openInput"sv, [this](auto const& data) {
+        open_input(data);
+    });
+}
+
+void NewTabUI::load_search_settings()
+{
+    auto const& search_engine_settings = Application::settings().search_engine_settings();
+
+    JsonObject search_settings;
+    search_settings.set("engine"sv, search_engine_settings.engine.has_value() ? JsonValue(search_engine_settings.engine->name) : JsonValue {});
+    search_settings.set("bangs"sv, search_engine_settings.bangs);
+
+    async_send_message("loadSearchSettings"_string, move(search_settings));
+}
+
+void NewTabUI::open_input(JsonValue const& data)
+{
+    if (!data.is_string())
+        return;
+
+    auto const& input = data.as_string();
+    if (input.bytes_as_string_view().trim_whitespace().is_empty())
+        return;
+
+    auto const& search_engine_settings = Application::settings().search_engine_settings();
+    auto classified_input = classify_user_input(input);
+
+    Optional<URL::URL> url;
+    if (classified_input.classification == UserInputClassification::ExternalURL) {
+        url = move(classified_input.url);
+    } else {
+        auto destination_kind = classified_input.classification == UserInputClassification::Search
+            ? OmniboxDestinationKind::Search
+            : OmniboxDestinationKind::URL;
+        url = url_for_omnibox_destination(input, destination_kind, search_engine_settings.engine, AppendTLD::No,
+            search_engine_settings.bangs ? EnableBangs::Yes : EnableBangs::No);
+    }
+
+    // NB: Without a search engine, there is nowhere to send a search to until the user chooses one.
+    if (!url.has_value()) {
+        async_send_message("navigate"_string, "about:settings#search"_string);
+        return;
+    }
+    async_send_message("navigate"_string, url->serialize());
+}
+
+}
