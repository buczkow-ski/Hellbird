+
+AK::Duration Tab::idle_duration() const
+{
+    if (!m_last_active_time.has_value())
+        return AK::Duration::zero();
+    return MonotonicTime::now_coarse() - *m_last_active_time;
+}
+
+WebView::SessionHistorySnapshot const* Tab::deferred_history() const
+{
+    if (!m_deferred_tab.has_value() || !m_deferred_tab->history.has_value())
+        return nullptr;
+    return &*m_deferred_tab->history;
+}
+
+bool Tab::can_be_discarded_locally() const
+{
+    if (!is_loaded() || !m_window || m_window->current_tab() == this)
+        return false;
+    if (m_is_pinned || m_is_loading || m_opened_by_script || is_devtools_open())
+        return false;
+    if (m_already_requested_close || m_window_is_closing)
+        return false;
+    if (m_screen_display_sleep_inhibitor.has_value() || m_report_review_navigation_listener.has_value())
+        return false;
+    if (m_view->tab_indicator_visible(WebView::TabIndicator::PlayingAudio)
+        || m_view->tab_indicator_visible(WebView::TabIndicator::UsingMicrophone)
+        || m_view->tab_indicator_visible(WebView::TabIndicator::UsingLocation))
+        return false;
+    if (m_view->element_picker_session().has_value() || m_view->crash_overlay_active())
+        return false;
+    if ((m_javascript_dialog && m_javascript_dialog->is_open())
+        || m_color_picker_dialog || m_date_picker_dialog || m_file_picker_dialog || m_external_url_confirmation_dialog)
+        return false;
+
+    auto current_url = m_view->url();
+    if (!current_url.scheme().is_one_of("http"sv, "https"sv))
+        return false;
+
+    return true;
+}
+
+bool Tab::can_be_discarded() const
+{
+    if (!can_be_discarded_locally())
+        return false;
+    return !m_view->needs_beforeunload_check();
+}
+
+bool Tab::discard()
+{
+    if (!can_be_discarded())
+        return false;
+
+    auto current_url = m_view->url();
+    DeferredTab deferred {
+        .session_tab_id = m_session_tab_id.value_or(0),
+        .url = current_url,
+        .title = m_title.isEmpty() ? qstring_from_ak_string(current_url.serialize()) : m_title,
+        .favicon = m_favicon,
+        .history = m_view->session_history_snapshot(),
+    };
+
+    close_popovers();
+    m_site_settings_popover_origin.clear();
+    hide_hover_label();
+    m_permission_prompts.ignore_all();
+    m_screen_display_sleep_inhibitor.clear();
+
+    m_window->toolbar().release_location_edit(*this);
+
+    m_view->removeEventFilter(this);
+    m_view->removeEventFilter(&m_window->tab_widget());
+    QObject::disconnect(m_view, nullptr, this, nullptr);
+    QObject::disconnect(m_view, nullptr, m_window, nullptr);
+    m_view->on_close = nullptr;
+    m_view->on_web_content_crashed = nullptr;
+    m_view->on_loading_state_change = nullptr;
+    m_view->on_content_blocking_change = nullptr;
+    m_view->on_performance_stats = nullptr;
+    m_view->on_activate_tab = nullptr;
+    m_view->on_title_change = nullptr;
+    m_view->on_favicon_change = nullptr;
+    m_view->on_url_change = nullptr;
+
+    if (m_location_edit) {
+        m_location_edit->removeEventFilter(this);
+        QObject::disconnect(m_location_edit, nullptr, this, nullptr);
+        m_location_edit->setParent(nullptr);
+        delete m_location_edit;
+        m_location_edit = nullptr;
+    }
+
+    delete m_zoom_popover;
+    m_zoom_popover = nullptr;
+    delete m_site_settings_popover;
+    m_site_settings_popover = nullptr;
+    delete m_bookmark_popover;
+    m_bookmark_popover = nullptr;
+    delete m_private_session_popover;
+    m_private_session_popover = nullptr;
+    delete m_translation_menu;
+    m_translation_menu = nullptr;
+    delete m_select_dropdown;
+    m_select_dropdown = nullptr;
+    m_translate_action = nullptr;
+    delete m_content_blocking_update_timer;
+    m_content_blocking_update_timer = nullptr;
+    delete m_find_in_page;
+    m_find_in_page = nullptr;
+    delete m_element_picker;
+    m_element_picker = nullptr;
+    delete m_hover_label;
+    m_hover_label = nullptr;
+
+    // Destroy DevToolsPanel before m_splitter destroys m_view, since ~DevToolsPanel accesses m_view.
+    delete m_devtools_panel;
+    m_devtools_panel = nullptr;
+
+    m_view->prepare_for_immediate_close();
+    auto* splitter_to_delete = m_splitter;
+    if (splitter_to_delete && layout())
+        layout()->removeWidget(splitter_to_delete);
+    m_javascript_dialog = nullptr;
+    m_view = nullptr;
+    m_splitter = nullptr;
+    delete splitter_to_delete;
+
+    m_is_loading = false;
+    m_is_waiting_for_response = false;
+    m_needs_attention = false;
+    m_has_had_real_size = false;
+    m_performance_stats = {};
+    m_before_unload_completion = nullptr;
+    m_last_active_time.clear();
+    m_deferred_tab = AK::move(deferred);
+    m_was_discarded = true;
+
+    m_window->update_tab_audio_button(*this);
+    m_window->tab_widget().tab_bar()->update_microphone_indicators();
+    m_window->tab_widget().tab_bar()->update_loading_ring_animation();
+    m_window->tab_widget().tab_bar()->update();
+    return true;
+}
