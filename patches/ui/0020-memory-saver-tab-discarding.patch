+void BrowserWindow::discard_idle_tabs()
+{
+    if (m_is_popup_window == IsPopupWindow::Yes)
+        return;
+
+    auto const& tab_settings = Application::settings().tab_settings();
+    if (!tab_settings.memory_saver_enabled)
+        return;
+
+    int loaded_count = 0;
+    for (int i = 0; i < m_tabs_container->count(); ++i) {
+        if (auto* tab = m_tabs_container->tab(i); tab && tab->is_loaded())
+            ++loaded_count;
+    }
+    if (loaded_count <= 1)
+        return;
+
+    auto idle_minutes = clamp<u32>(tab_settings.memory_saver_idle_minutes, 1, 1440);
+    auto physical_memory = Core::System::physical_memory_bytes();
+    if (physical_memory > 0 && physical_memory <= 8 * GiB && loaded_count >= 6)
+        idle_minutes = max<u32>(5, idle_minutes / 2);
+
+    auto threshold = AK::Duration::from_seconds(static_cast<i64>(idle_minutes) * 60);
+    struct DiscardCandidate {
+        Tab* tab { nullptr };
+        AK::Duration idle;
+    };
+    Vector<DiscardCandidate> candidates;
+    for (int i = 0; i < m_tabs_container->count(); ++i) {
+        auto* tab = m_tabs_container->tab(i);
+        if (!tab)
+            continue;
+        auto idle = tab->idle_duration();
+        if (idle < threshold || !tab->can_be_discarded_locally())
+            continue;
+        candidates.append({ tab, idle });
+    }
+    // Discard the least-recently-used tabs first, and check sync beforeunload IPC only for idle candidates.
+    quick_sort(candidates, [](auto const& a, auto const& b) { return a.idle > b.idle; });
+
+    constexpr int max_discards_per_tick = 3;
+    int discarded = 0;
+    for (auto const& candidate : candidates) {
+        if (discarded >= max_discards_per_tick)
+            break;
+        if (candidate.tab->discard())
+            ++discarded;
+    }
+}
