diff --git a/UI/Qt/WebContentViewWindows.cpp b/UI/Qt/WebContentViewWindows.cpp
index 619c7b9a1d..0c014ff4d1 100644
--- a/UI/Qt/WebContentViewWindows.cpp
+++ b/UI/Qt/WebContentViewWindows.cpp
@@ -97,8 +97,20 @@ bool WebContentView::has_visible_child_over_page() const
 
 void WebContentView::update_whether_view_hosts_remote_layer()
 {
-    auto should_host = internalWinId() != 0 && !is_page_covered_by_overlay() && !has_visible_child_over_page() && !has_floating_surface_over_page()
-        && !m_vertical_tabs_overlay_page && !m_bookmarks_bar_overlays_page;
+    // Native child windows (FieldPanel, PageCard, FindInPageWidget, etc.) stack above this view's native HWND and its
+    // child DirectComposition HWND in Win32 z-order without tearing down the remote layer. Tearing down the remote
+    // layer on every autocomplete open/close causes a visible full-page flash on Windows, so only yield the remote
+    // layer for non-native (alien) floating surfaces.
+    bool has_non_native_floating_surface = false;
+    for (auto const& floating : m_floating_surfaces) {
+        if (floating.surface && floating.surface->isVisible() && !floating.surface->testAttribute(Qt::WA_NativeWindow)) {
+            has_non_native_floating_surface = true;
+            break;
+        }
+    }
+
+    auto should_host = internalWinId() != 0 && !is_page_covered_by_overlay() && !has_visible_child_over_page()
+        && !has_non_native_floating_surface && !m_vertical_tabs_overlay_page && !m_bookmarks_bar_overlays_page;
     if (m_hosts_remote_layer == should_host)
         return;
     m_hosts_remote_layer = should_host;
