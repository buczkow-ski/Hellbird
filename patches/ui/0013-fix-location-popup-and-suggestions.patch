+#if defined(LADYBIRD_QT_USE_RHI_WIDGET)
+static QRegion rounded_rect_region(QRect const& rect, int radius)
+{
+    if (rect.isEmpty())
+        return {};
+    auto r = min(radius, min(rect.width(), rect.height()) / 2);
+    if (r <= 0)
+        return QRegion(rect);
+    QRegion region(rect.adjusted(0, r, 0, -r));
+    for (int y = 0; y < r; ++y) {
+        auto dy = r - (y + 0.5);
+        auto inset = qFloor(r - qSqrt((r * r) - (dy * dy)));
+        auto w = rect.width() - (2 * inset);
+        region += QRect(rect.left() + inset, rect.top() + y, w, 1);
+        region += QRect(rect.left() + inset, rect.bottom() - y, w, 1);
+    }
+    return region;
+}
+#endif
